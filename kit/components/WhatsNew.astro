---
/* WHAT'S NEW, the body of the page (kit component since 11 November 2026; first built in the Defranceschi archive, laid out as Record Atlas lays out its own):
   a tally with small badges, one summary card, then a timeline with a rule down the left, the date on it (day large, month in the accent,
   year beneath) and a card per change. The day's searches fold into ONE «Research» card that opens onto groups by provider, each with its rows (the source's name linked to its record, the place,
   a ✅/❌ pill, the pages; see WhatsNewDay.astro); each correction is a card of its own.
   Nothing is written by hand: every line is a row of the archive's search log or corrections list, computed by kit/lib/pulse.js.
   The newest 25 days are open; the rest sit under «Earlier». The badges and the word box filter in the browser.
   The archive's page wraps this in its own layout (title, eyebrow, dek, noautolink) and passes `pulse`; see kit/docs/whats-new.md.
   RECEIPTS (12 November 2026; kit/docs/whats-new-receipts.md): with `atlasId` (the archive's id in the Atlas's research-receipts) each search row gets a
   second line, the Atlas state and the pages the finding went into, the day tallies say «N of M in the Atlas», and a small script asks the Atlas's deployed
   receipts again when the page is opened (it upgrades a row to "In the Atlas"; it never reaches github.com). Without it the page is drawn exactly as before.
   props: pulse (buildPulse), logHref ("/searched/"), correctionsHref ("/corrections/"), askHref (a page for "know something we do not?", or none),
          tries (the example words of the filter box), atlasId (REQUIRED to wire it, one of blazevic booyzen darcy defranceschi falco lerena luwinski mazza; none = not wired, drawn as before), liveUrl (the deployed receipts' address; only a demo overrides it. There is no second address: the page carries no github.com address, 23 November 2026) */
import { u } from "../lib/url.js";
import { CARD, KIND, fmtDay, nf, tiles } from "../lib/pulse.js";
import { ARCHIVE_IDS, LIVE_URL } from "../lib/receipts.js";
import receiptsClient from "../lib/receipts.client.js?raw";
import WhatsNewDay from "./WhatsNewDay.astro";
const { pulse, logHref = "/searched/", correctionsHref = "/corrections/", askHref = "", tries = "", atlasId = "", liveUrl = "" } = Astro.props;
const wired = !!atlasId || !!pulse.atlas;
/* atlasId is REQUIRED once the page is wired (receipts in the pulse, or any atlasId) and must be one of the Atlas's ids: a typo here would silently read no receipts */
if (wired && !ARCHIVE_IDS.includes(atlasId)) throw new Error(`WhatsNew: atlasId must be one of ${ARCHIVE_IDS.join(", ")} (got "${atlasId}"). Defranceski is "defranceschi".`);
const asOf = pulse.atlas && pulse.atlas.asOf ? fmtDay(pulse.atlas.asOf) : "";
const SHOWN = 25;
const days = pulse.days;
const recent = days.slice(0, SHOWN), earlier = days.slice(SHOWN);
const c = pulse.counts;
const nRes = days.reduce((n, d) => n + d.research.length, 0);
const nCor = days.reduce((n, d) => n + d.corrections.length, 0);
/* OUTCOME CHIPS (15 November 2026). The five outcomes were computed, counted and shown on every row from the start, but could not be
   filtered on: the chips filtered the day CARD by its type (a search card or a correction card), while an outcome belongs to a ROW
   inside a card. These chips therefore filter rows, exactly as the word box already does, and then hide any group, card or day left
   empty. "Partly" and "Blocked" appear only where an archive has any, so a log without them keeps three chips, not five. */
const OUTCOME_CHIPS = [
  ["found", KIND.found.glyph, "found something", KIND.found.note],
  ["nil", KIND.nil.glyph, "found nothing", KIND.nil.note],
  ["partial", KIND.partial.glyph, "partly read", KIND.partial.note],
  ["blocked", KIND.blocked.glyph, "blocked", KIND.blocked.note],
];
const oldest = pulse.entries[pulse.entries.length - 1] || { iso: pulse.latest || new Date().toISOString().slice(0, 10), exact: false };
const part = (iso, o) => new Date(iso + "T00:00:00Z").toLocaleDateString("en-GB", { ...o, timeZone: "UTC" });
const week = pulse.week;
---
  <p class="wn-tally" aria-label="Summary">
    <span><b>{nf(pulse.entries.length)}</b> entries since {part(oldest.iso, { day: "numeric", month: "long" })}</span>
    <button type="button" class="wn-chip on" data-k="all">All</button>
    <button type="button" class="wn-chip research" data-k="research" title={CARD.research.note}><i aria-hidden="true">{CARD.research.glyph}</i> {nf(nRes)} searches</button>
    {OUTCOME_CHIPS.filter(([k]) => (pulse.total[k] || 0) > 0).map(([k, glyph, label, note]) => (
      <button type="button" class={`wn-chip o-${k}`} data-k={`o:${k}`} title={note}><i aria-hidden="true">{glyph}</i> {nf(pulse.total[k])} {label}</button>
    ))}
{nCor > 0 && <button type="button" class="wn-chip corrected" data-k="corrected" title={CARD.corrected.note}><i aria-hidden="true">{CARD.corrected.glyph}</i> {nf(nCor)} corrected</button>}
    <label class="wn-find"><span class="wn-sr">Filter the list by a word</span><input type="search" id="wn-q" placeholder={tries ? "Filter: " + tries : "Filter by a word"} autocomplete="off" /></label>
  </p>

  <section class="wn-sum" id="numbers" aria-label="The archive in numbers">
    <h2>The archive in numbers</h2>
    <p class="wn-figs">
      {tiles(pulse).map(([n, l]) => <span><b>{n}</b> {l}</span>)}
    </p>
    <p class="wn-week">In the seven days to {fmtDay(pulse.latest)}: <b>{week.found}</b> {week.found === 1 ? "search" : "searches"} found something, <b>{week.nil}</b> found nothing, <b>{week.corrected}</b> {week.corrected === 1 ? "claim" : "claims"} corrected.</p>
  </section>
  {wired && (
    <p class="wn-asof" id="wn-asof" hidden={!pulse.atlas} data-archive={atlasId || undefined} data-live={atlasId ? liveUrl || LIVE_URL(atlasId) : undefined} data-asof={pulse.atlas ? asOf : undefined}>
      <span class="wn-asof-t">{pulse.atlas ? `Record Atlas status as of ${asOf}, when this page was built.` : ""}</span>
    </p>
  )}
  <p class="wn-count" id="wn-count" aria-live="polite"></p>

  <ol class="wn-line" id="wn-list">
    {recent.map((d) => <WhatsNewDay d={d} logHref={logHref} wired={wired} />)}
  </ol>

  {earlier.length > 0 && (
    <details class="wn-older" id="wn-older2">
      <summary>Earlier: {earlier.length} more days, back to {fmtDay(oldest.iso, oldest.exact)}</summary>
      <ol class="wn-line" id="wn-list2">
        {earlier.map((d) => <WhatsNewDay d={d} logHref={logHref} wired={wired} />)}
      </ol>
    </details>
  )}

  <aside class="wn-foot">
    {askHref && <p class="wn-warm">Know something this archive does not? A record, a photograph, a spelling, a correction. <a href={u(askHref)}>The open questions</a> are where to start.</p>}
    <p class="wn-cap">{nf(pulse.entries.length)} of {nf(c.logged + c.corrections)} log rows carry a date this page can read; the rest are in <a href={u(logHref)}>the search log</a> and <a href={u(correctionsHref)}>the corrections</a>.</p>
  </aside>


<style is:global>
  .wn-tally{display:flex;flex-wrap:wrap;align-items:center;gap:8px 10px;margin:0 0 20px;font-family:var(--sans);font-size:14px;color:var(--ink-2)}
  .wn-tally b{color:var(--ink)}
  .wn-chip,.wn-chip2{display:inline-flex;align-items:center;gap:5px;font-family:var(--mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;line-height:1;
    padding:5px 9px 5px 8px;border-radius:999px;border:1px solid var(--rule-strong);color:var(--ink-2);background:var(--panel,transparent);white-space:nowrap}
  .wn-chip{cursor:pointer}
  .wn-chip i,.wn-chip2 i{font-style:normal;font-size:12px}
  .wn-chip:hover{border-color:var(--accent);color:var(--accent)}
  .wn-chip.on{background:var(--accent-wash);border-color:var(--accent);color:var(--accent)}
  .wn-chip.research,.wn-chip2.research{color:#2f7a52;border-color:#2f7a52}
  .wn-chip.research.on{background:rgba(47,122,82,.12)}
  .wn-chip.corrected,.wn-chip2.corrected{color:#8a5a12;border-color:#b98a3e}
  .wn-chip.corrected.on{background:rgba(185,138,62,.14)}
  .wn-find{margin-left:auto}
  .wn-find input{font-family:var(--sans);font-size:13px;padding:7px 12px;width:min(260px,100%);border:1px solid var(--rule);border-radius:999px;background:var(--panel);color:var(--ink)}
  .wn-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

  .wn-sum{margin:0 0 26px;padding:16px 20px;border:1px solid var(--rule);border-radius:12px;background:var(--panel,transparent)}
  .wn-sum h2{margin:0 0 6px;font-family:var(--serif);font-size:20px;line-height:1.2;color:var(--ink);font-weight:700;letter-spacing:0;text-transform:none}
  .wn-figs{margin:0;display:flex;flex-wrap:wrap;gap:4px 18px;font-family:var(--sans);font-size:13.5px;color:var(--ink-2)}
  .wn-figs b{font-family:var(--serif);font-size:17px;color:var(--ink);font-weight:700;margin-right:2px}
  .wn-week{margin:8px 0 0;font-family:var(--sans);font-size:13px;color:var(--ink-3)}
  .wn-week b{color:var(--ink-2)}
  .wn-count{font-family:var(--sans);font-size:12.5px;color:var(--ink-3);margin:-12px 0 12px;min-height:1.2em}

  /* the timeline: a rule down the left, the date on it, a card per change */
  .wn-line{list-style:none;margin:0;padding:0;position:relative}
  .wn-line::before{content:"";position:absolute;left:41px;top:6px;bottom:6px;width:2px;background:var(--rule)}
  .wn-day{display:grid;grid-template-columns:84px minmax(0,1fr);gap:0 18px;padding-bottom:22px}
  .wn-day[hidden],.wn-item[hidden],.wn-row[hidden]{display:none}
  .wn-when{position:relative;display:flex;flex-direction:column;align-items:center;line-height:1.05;padding-top:2px;background:var(--ground,transparent);align-self:start}
  .wn-when b{font-family:var(--serif);font-size:30px;font-weight:700;color:var(--ink)}
  .wn-when span{font-family:var(--mono);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin-top:2px}
  .wn-when em{font-style:normal;font-family:var(--mono);font-size:11px;color:var(--ink-3);margin-top:2px}
  .wn-items{list-style:none;margin:0;padding:0;display:grid;gap:10px}
  .wn-item{display:flex;align-items:flex-start;gap:12px;padding:12px 14px;background:var(--panel,transparent);border:1px solid var(--rule);border-radius:10px;transition:border-color .15s,transform .15s}
  .wn-item:hover{border-color:var(--accent);transform:translateX(2px)}
  .wn-item .wn-chip2{flex:none;margin-top:3px;min-width:92px;justify-content:center}
  .wn-head{font-family:var(--serif);font-size:17px;line-height:1.45;color:var(--ink);text-decoration:none}
  a.wn-head:hover{color:var(--accent)}
  .wn-go{color:var(--accent);white-space:nowrap}
  .wn-about{display:block;margin-top:2px;font-size:13px;color:var(--ink-2,var(--ink))}
  .wn-about a{color:var(--accent);text-decoration:none}
  .wn-about a:hover{text-decoration:underline}
  .wn-tl{font-family:var(--sans);font-size:12.5px;color:var(--ink-3);margin-left:2px}
  .wn-atl{color:var(--ink-2)}
  .wn-asof{margin:-14px 0 18px;font-family:var(--sans);font-size:12.5px;color:var(--ink-3)}
  .wn-asof[hidden]{display:none}
  /* the second line under a row: the Atlas state, then the pages the finding went into */
  .wn-rx{flex:1 1 16rem;min-width:0;display:flex;flex-wrap:wrap;align-items:center;gap:4px 14px;margin:1px 0 2px;font-size:12.5px;color:var(--ink-3)}
  .wn-rx:empty{display:none}
  .wn-ax{display:inline-flex;flex-wrap:wrap;align-items:center;gap:2px 8px}
  .wn-ax[hidden]{display:none}
  .wn-at{display:inline-flex;align-items:center;gap:4px;padding:0 8px;border-radius:999px;border:1px solid var(--rule-strong,var(--rule));font-size:11.5px;font-weight:600;line-height:1.7;color:var(--ink-2);text-decoration:none;white-space:nowrap;background:transparent}
  .wn-at i{font-style:normal;font-size:11px}
  .wn-seeit{font-size:12px;color:var(--accent);text-decoration:none;white-space:nowrap}.wn-seeit:hover{text-decoration:underline}
  .wn-at.in-atlas{background:var(--accent-wash,rgba(31,92,107,.1));border-color:var(--accent);color:var(--accent)}
  .wn-at.going-live{border-style:dashed;border-color:var(--accent);color:var(--ink-2)}
  .wn-at.not-sent{border-style:dotted;color:var(--ink-3)}
  .wn-at.nothing-to-send{border-color:transparent;padding-left:0;font-weight:400;color:var(--ink-3)}
  .wn-am{font-size:12px}.wn-am>summary{cursor:pointer;display:inline;color:var(--accent)}
  .wn-am a{margin-left:8px;color:var(--accent);text-decoration:none}.wn-am a:hover{text-decoration:underline}
  .wn-up{display:inline-flex;flex-wrap:wrap;align-items:baseline;gap:2px 6px;min-width:0;max-width:100%}
  .wn-upl{font-family:var(--mono);font-size:10px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-3)}
  .wn-pg{display:inline-block;max-width:min(36ch,100%);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;vertical-align:bottom;padding:0 7px;border-radius:4px;border:1px solid var(--rule);font-size:12px;line-height:1.6;color:var(--accent);text-decoration:none}
  .wn-for{display:inline-flex;flex-wrap:wrap;align-items:baseline;gap:2px 6px;min-width:0;max-width:100%}
  .wn-forl{font-family:var(--mono);font-size:10px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-3)}
  .wn-pg:hover{border-color:var(--accent);text-decoration:underline}
  .wn-lo{font-size:12px;font-style:italic;color:var(--ink-3)}
  .wn-rday{flex:1;min-width:0}
  .wn-rday>summary{cursor:pointer}
  /* a provider's group: a ruled header with its tally, rows in three aligned columns (as Record Atlas lays out a research day) */
  .wn-grp{margin:10px 0 0;font-family:var(--sans);border-top:1px solid var(--rule)}
  .wn-grp>summary{list-style:none;cursor:pointer;display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 14px;padding:9px 0 6px;font-size:14.5px}
  .wn-grp>summary::-webkit-details-marker{display:none}
  .wn-grp>summary::before{content:"\25B8";color:var(--ink-3);width:1em;flex:none}
  .wn-grp[open]>summary::before{content:"\25BE"}
  .wn-grp>summary b{font-weight:700;color:var(--ink)}
  .wn-gs{font-size:12.5px;color:var(--ink-3)}
  .wn-rows{padding:0 0 6px 1em}
  .wn-row{display:flex;flex-wrap:wrap;gap:4px 12px;align-items:baseline;padding:6px 0;border-top:1px solid var(--rule);font-size:14px;font-family:var(--sans)}
  .wn-rows>.wn-row:first-child{border-top:0}
  .wn-rt{flex:1 1 100%;min-width:0;overflow-wrap:anywhere}
  .wn-rc{flex:none}
  .wn-rt a.wn-ta{font-family:var(--sans);font-size:14px;font-weight:600;line-height:1.4;color:var(--accent);text-decoration:none}
  .wn-rt a.wn-ta:hover{text-decoration:underline}
  .wn-ext{font-weight:400;font-size:12px}
  .wn-rp{margin-left:8px;font-size:12.5px;font-weight:400;color:var(--ink-3)}
  .wn-told{margin-left:8px;font-size:12.5px;font-weight:400;color:var(--accent);text-decoration:none;display:inline-block;max-width:100%;vertical-align:bottom}
  .wn-told:hover{text-decoration:underline}
  .wn-rw{margin-left:8px;font-family:var(--mono);font-size:10px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-3);border:1px solid var(--rule);border-radius:3px;padding:1px 5px}
  .wn-rm{margin:3px 0 0;font-size:13px;font-weight:400;line-height:1.5;color:var(--ink-3)}
  .wn-rs{display:inline-block;padding:1px 8px;border-radius:999px;border:1px solid var(--rule);font-size:11.5px;font-weight:600;color:var(--ink);white-space:nowrap}
  .wn-rs i{font-style:normal;font-size:11px}
  .wn-rs.found{background:rgba(31,157,85,.14);border-color:rgba(31,157,85,.5)}
  .wn-rs.nil{background:var(--accent-wash,rgba(31,92,107,.1));border-color:var(--accent)}
  .wn-rs.partial{background:rgba(185,138,62,.14);border-color:rgba(185,138,62,.55)}
  .wn-rs.blocked{background:rgba(192,57,43,.12);border-color:rgba(192,57,43,.5)}
  /* the outcome chips take their colour from the row pill they filter to, so the chip and the pill read as one thing.
     Colour is never the only signal: each chip carries its glyph and its words, as the pills do. */
  .wn-chip.o-found{color:#1a7a46;border-color:rgba(31,157,85,.55)}
  .wn-chip.o-found.on{background:rgba(31,157,85,.14);border-color:rgba(31,157,85,.75);color:#146036}
  .wn-chip.o-nil{color:var(--accent);border-color:var(--accent)}
  .wn-chip.o-nil.on{background:var(--accent-wash,rgba(31,92,107,.1))}
  .wn-chip.o-partial{color:#8a5a12;border-color:rgba(185,138,62,.6)}
  .wn-chip.o-partial.on{background:rgba(185,138,62,.16)}
  .wn-chip.o-blocked{color:#a5342a;border-color:rgba(192,57,43,.55)}
  .wn-chip.o-blocked.on{background:rgba(192,57,43,.13)}
  .wn-rn{flex:none;font-size:12.5px;color:var(--ink-2);font-variant-numeric:tabular-nums;white-space:nowrap}
  .wn-rn:empty{display:none}
  .wn-more{margin:0;border-top:1px solid var(--rule)}
  .wn-more>summary{cursor:pointer;padding:7px 0;font-size:13px;color:var(--accent)}
  .wn-grp[hidden]{display:none}
  .wn-older{margin-top:6px}
  .wn-older>summary{cursor:pointer;padding:12px 0 16px;font-family:var(--sans);font-size:13.5px;color:var(--accent);font-weight:600}
  .wn-foot{margin-top:10px;padding:18px 20px;border-radius:12px;background:var(--accent-wash);border:1px solid var(--rule);max-width:64ch}
  .wn-warm{margin:0 0 6px;font-family:var(--serif);font-size:18px;line-height:1.45;color:var(--ink)}
  .wn-cap{margin:0;font-family:var(--sans);font-size:12.5px;color:var(--ink-3)}
  @media (prefers-color-scheme:dark){
    .wn-chip.research,.wn-chip2.research{color:#7fcf9f;border-color:#3f8f63}
    .wn-chip.research.on{background:rgba(127,207,159,.12)}
    .wn-chip.corrected,.wn-chip2.corrected{color:#e6bd7c;border-color:#9a7430}
    .wn-chip.o-found{color:#7fcf9f;border-color:#3f8f63}
    .wn-chip.o-found.on{background:rgba(127,207,159,.12);color:#9fdfb7}
    .wn-chip.o-partial{color:#e6bd7c;border-color:#9a7430}
    .wn-chip.o-blocked{color:#eb9a92;border-color:#8f3f3a}
    .wn-chip.o-blocked.on{background:rgba(235,154,146,.12)}
  }
  @media (prefers-reduced-motion:reduce){.wn-item{transition:none}.wn-item:hover{transform:none}}
  @media (max-width:640px){
    .wn-line::before{display:none}
    .wn-day{grid-template-columns:1fr;gap:8px}
    .wn-when{flex-direction:row;align-items:baseline;gap:6px;padding:0}
    .wn-when b{font-size:22px}
    .wn-when em{margin:0}
    .wn-item{flex-direction:column;gap:8px}
    .wn-item .wn-chip2{margin-top:0}
    .wn-find{margin-left:0;width:100%}.wn-find input{width:100%}
  }
</style>
<script is:inline>
  (function(){
    var type="all", outcome="", q=document.getElementById("wn-q"), out=document.getElementById("wn-count"), older=document.getElementById("wn-older2");
    var items=[].slice.call(document.querySelectorAll(".wn-item")), days=[].slice.call(document.querySelectorAll(".wn-day")), chips=[].slice.call(document.querySelectorAll(".wn-chip"));
    var allRows=document.querySelectorAll(".wn-row").length;
    function run(){
      var w=(q.value||"").trim().toLowerCase(), n=0, rowsOn=0;
      items.forEach(function(li){
        /* an outcome belongs to a row, so a card survives only while it still has one: a correction card has no rows and is hidden outright */
        var ok=(type==="all"||li.getAttribute("data-type")===type)&&(!w||li.getAttribute("data-q").indexOf(w)>-1);
        if(ok&&outcome&&li.getAttribute("data-type")!=="research")ok=false;
        li.hidden=!ok;
        if(ok){
          var det=li.querySelector(".wn-rday");
          if(det){
            var rows=[].slice.call(det.querySelectorAll(".wn-row"));
            rows.forEach(function(r){
              var byWord=!w||r.getAttribute("data-q").indexOf(w)>-1;
              var byOut=!outcome||r.getAttribute("data-o")===outcome;
              r.hidden=!(byWord&&byOut); if(byWord&&byOut)rowsOn++;
            });
            if(outcome&&!rows.some(function(r){return !r.hidden})){li.hidden=true; return;}
            if(w||outcome)[].slice.call(det.querySelectorAll("details")).concat([det]).forEach(function(x){x.open=true});
            [].slice.call(det.querySelectorAll(".wn-grp")).forEach(function(g){g.hidden=!g.querySelector(".wn-row:not([hidden])")});
          } else if(outcome){ li.hidden=true; return; }
          n++;
        }
      });
      days.forEach(function(d){d.hidden=!d.querySelector(".wn-item:not([hidden])")});
      var on=type!=="all"||w||outcome; if(older&&on)older.open=true;
      /* with an outcome chosen the honest figure is entries, not cards: the cards are only what holds them */
      out.textContent=on?(outcome?(rowsOn+" of "+allRows+" entries"):(n+" of "+items.length+" cards")):"";
    }
    chips.forEach(function(b){b.addEventListener("click",function(){
      var k=b.getAttribute("data-k");
      if(k.indexOf("o:")===0){outcome=k.slice(2); type="research";} else {outcome=""; type=k;}
      chips.forEach(function(x){x.classList.toggle("on",x===b)}); run();
    })});
    if(q)q.addEventListener("input",run);
    if(location.hash&&location.hash.indexOf("#d")===0){var t=document.getElementById(location.hash.slice(1)); if(t){var det=t.querySelector(".wn-rday"); if(det)det.open=true; var o=t.closest("#wn-older2"); if(o)o.open=true;}}
  })();
</script>
{atlasId && <script is:inline set:html={receiptsClient} />}
