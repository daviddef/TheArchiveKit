---
/* The ancestor chart, drawn.

   This was Defranceschi's, on one archive, while the other six had no drawing
   of their own line at all — the kit had standardised the LIST of lines and
   not the picture of one. Promoted here so they can.

   Three things tied it to one archive: the url helper, that archive's dossier
   slugs, and its name resolver. The url helper moved to the kit's own lib; the
   other two collapse into ONE prop. The archive answers «does this person have
   a page, and where», because only it knows; this file answers «how is the
   chart laid out», which is the part worth having once.

     root         the nested node: { n, d, place, conf, arch, who, f, m }
                  f and m are the father and mother, each the same shape.
                  { wall: true, kind, label, q, arch } ends a branch instead.

                  Three optional fields, all of them Booyzen's, promoted here
                  21 September 2026 because a strict ancestor chart cannot
                  draw what they carry and every archive eventually meets it:

                  sn    a shortened name for the box. "Margaretha Wilhelmina
                        Elizabeth Mary Kolbe" does not fit in 158px and a box
                        that clips a name is a box that renames a woman. The
                        full name stays as the title attribute.
                  alt   [{ n, why }] — a SECOND MARRIAGE. The chart has one
                        slot for a mother and can draw only one of them, so
                        the others are listed under it with the reason they
                        are known. Booyzen has three; two are the same man.
                  same  a note that the line FOLDS BACK on itself — the same
                        couple reached by two paths, which is a cousin
                        marriage seen from the descendant's end. Drawing it
                        would need an edge the layout has no room for, so it
                        is stated instead of drawn.
     personHref   node → a URL, or null for no link. Optional.

   Nothing else is required, so an archive with a line and no person pages
   still gets the drawing. */
import arch from "../data/archives.json";
import { md } from "../lib/md.js";
/* `lists` — the walls, the second marriages and the folds, rendered under the
   drawing. TRUE by default, because an archive that has not written them
   should still get them said. Booyzen passes false: it had written all three
   by hand, better than this file will, with its own links out to the notice
   and the searches. Spine already holds this principle at the top of its own
   file — the page is where the archive tells its story, so the prose stays
   where it is. A shared component earns its place by drawing the picture,
   not by overwriting the writing. */
const { root, personHref = () => null, lists = true } = Astro.props;
const A = Object.fromEntries(arch.archives.map(a => [a.key, a]));

/* Lay the ancestor chart out by computing every box's position first, so an
   eight-deep branch beside a two-deep one cannot tear the page open. */
const COLW = 232, GAPX = 34, ROWH = 64, BOXH = 52;
const boxes = [], links = [], walls = [];
let cursor = 0;

function place(node, gen) {
  const kids = node.wall ? [] : [node.f, node.m].filter(Boolean);
  let row;
  if (!kids.length) { row = cursor; cursor += 1; }
  else {
    const rows = kids.map(k => place(k, gen + 1));
    row = rows.reduce((a, b) => a + b, 0) / rows.length;
    for (const r of rows) links.push({ gen, from: row, to: r });
  }
  /* Whether this person has a page is the archive's business, not the
     chart's — it is the one that knows its own slugs, and a slug this file
     guessed would be a dead link. One already was. So: ask, take null for
     an answer, and draw the name plain when the answer is null. */
  const b = { ...node, gen, row };
  b.href = node.wall ? null : (personHref(b) || null);
  boxes.push(b);
  if (node.wall) walls.push(b);
  return row;
}
place(root, 0);

/* What the drawing cannot hold, gathered to be said underneath it. A chart
   that silently drops a second wife is not a simpler chart, it is a wrong
   one. */
const alts = boxes.filter(b => b.alt).flatMap(b => b.alt.map(a => ({ ...a, of: b })));
const folds = boxes.filter(b => b.same);

const maxGen = Math.max(...boxes.map(b => b.gen));
const maxRow = Math.max(...boxes.map(b => b.row));
const W = (maxGen + 1) * COLW + maxGen * GAPX;
const H = (maxRow + 1) * ROWH;
const X = g => g * (COLW + GAPX);
const Y = r => r * ROWH;

/* A wall is not one thing, and a list that says the same sentence about all of
   them is true of every wall and useful about none. Two archives worked this
   out independently — Booyzen stores a kind on each wall, Blažević wrote a
   paragraph counting them — which is the signal it belongs here.

   The vocabulary, smallest first in how much work is left to do:

     candidate      not a wall at all — the drawing was cut for room
     other-archive  the line continues, in a sibling archive
     name           the record names someone too vaguely to search for. A given
                    name and no surname, or a wife under her husband's. There
                    is nothing to look for until a marriage or a baptism
                    supplies the missing half
     unfilmed       a properly identified person whose next record exists and
                    is not reachable — not filmed, not indexed, not public
     searched       looked for, and not found. A finding, not a gap
     unworked       nobody has looked yet

   An archive that says nothing gets `unworked`, which is the honest default:
   not knowing why a line stops is itself not knowing. */
const WALL = {
  candidate:       ["More to come",        "var(--ochre)"],
  "other-archive": ["Continues elsewhere", "var(--accent)"],
  name:            ["A name problem",      "var(--terra)"],
  unfilmed:        ["Not reachable",       "var(--ochre)"],
  searched:        ["Searched, not found", "var(--ink-2)"],
  unworked:        ["Not yet worked",      "var(--ink-3)"],
  unknown:         ["Not yet worked",      "var(--terra)"],
  hard:            ["Searched, not found", "var(--ink-2)"],
  /* Two more of Booyzen's, 21 September 2026, and both were falling through
     to "Not yet worked" — which is the one thing neither of them is.
       notknown  the record was found, it has the column, and the column says
                 so. The search is over and the answer is nothing. Calling
                 that unworked invites somebody to work it again.
       disputed  two sources answer and disagree. Also not a gap in the
                 looking; a gap in the agreement. */
  notknown:        ["The record says «not known»", "var(--terra)"],
  disputed:        ["Disputed",                    "var(--ochre)"],
};
const kindOf = (w) => WALL[w && w.kind] || WALL.unworked;
const KIND = Object.fromEntries(Object.entries(WALL).map(([k, v]) => [k, v[1]]));
/* `open` is Booyzen's: a person the chart draws and the archive is still
   arguing about. Distinct from `lore`, which is a claim from the family's own
   chart, and from a wall, which is where the drawing stops. */
const CONF = { doc: "var(--accent)", lore: "var(--ochre)", living: "var(--ink-3)",
               open: "var(--ochre)" };
const GENLAB = ["Self", "Gen 1", "Gen 2", "Gen 3", "Gen 4", "Gen 5", "Gen 6", "Gen 7", "Gen 8"];
---
<div class="ac-scroll">
  <div class="ac" style={`width:${W}px;height:${H + 26}px`}>
    {Array.from({ length: maxGen + 1 }, (_, g) => (
      <div class="ac-gl" style={`left:${X(g)}px`}>{GENLAB[g]}</div>
    ))}

    {/* one dashed lane per generation, so a column can be followed down the page */}
    {Array.from({ length: maxGen }, (_, i) => (
      <div class="ac-lane" style={`left:${X(i + 1) - GAPX / 2}px`}></div>
    ))}

    {links.map(l => {
      const x0 = X(l.gen) + COLW, x1 = X(l.gen + 1);
      const y0 = Y(l.from) + BOXH / 2 + 26, y1 = Y(l.to) + BOXH / 2 + 26;
      const mid = x0 + (x1 - x0) / 2;
      return (<>
        <div class="ac-h" style={`left:${x0}px;top:${y0}px;width:${mid - x0}px`}></div>
        <div class="ac-v" style={`left:${mid}px;top:${Math.min(y0, y1)}px;height:${Math.abs(y1 - y0)}px`}></div>
        <div class="ac-h" style={`left:${mid}px;top:${y1}px;width:${x1 - mid}px`}></div>
      </>);
    })}

    {boxes.map(b => b.wall ? (
      <div class="ac-wall" style={`left:${X(b.gen)}px;top:${Y(b.row) + 26}px;--k:${KIND[b.kind] || "var(--ink-3)"}`}>
        {b.arch && A[b.arch]
          ? <a class="ac-wl ac-wlink" href={`${A[b.arch].url}search/?q=${encodeURIComponent(b.q)}`}>{b.label} →</a>
          : <span class="ac-wl">{b.label}</span>}
      </div>
    ) : (
      <div class="ac-box" style={`left:${X(b.gen)}px;top:${Y(b.row) + 26}px;--c:${CONF[b.conf] || "var(--ink-3)"}`}>
        <div class="ac-n" title={b.sn && b.sn !== b.n ? b.n : null}>
          {b.href ? <a href={b.href}>{b.sn || b.n}</a> : (b.sn || b.n)}
        </div>
        <div class="ac-m">
          {b.d && <span class="ac-d">{b.d}</span>}
          {b.place && <span class="ac-p">{b.place}</span>}
          {b.arch && A[b.arch] && <a class="ac-x" href={A[b.arch].url} title={A[b.arch].name}>{A[b.arch].name.replace("The ","").replace(" Archive","")} archive →</a>}
        </div>
      </div>
    ))}
  </div>
</div>

{lists && walls.length > 0 && (
<div class="ac-walls">
  {/* Falco has exactly one, which is how "The 1 walls" reached a published
      page. An archive with none gets no heading over nothing at all. */}
  <h2>{walls.length === 1
        ? "The one wall, and why it is a wall"
        : `The ${walls.length} walls, and why each one is a wall`}</h2>
  {walls.map(w => (
    <div class="ac-wrow" style={`--k:${kindOf(w)[1]}`}>
      <div class="ac-wk">{w.label}<span class="ac-wkind">{kindOf(w)[0]}</span></div>
      <div class="ac-wn">
        <span set:html={md(w.note)}></span>
        {w.arch && A[w.arch] && (
          <a class="ac-go" href={`${A[w.arch].url}search/?q=${encodeURIComponent(w.q)}`}>
            Search {A[w.arch].name} for {w.q} →
          </a>
        )}
      </div>
    </div>
  ))}
</div>
)}

{lists && alts.length > 0 && (
<div class="ac-walls">
  <h2>{alts.length === 1
        ? "The marriage the chart has no slot for"
        : `The ${alts.length} marriages the chart has no slot for`}</h2>
  <p class="ac-lead">An ancestor chart gives each person one father and one
    mother. Where a man married twice, only the ancestral wife can be drawn —
    the others are here, with how this archive knows them.</p>
  {alts.map(a => (
    <div class="ac-wrow" style="--k:var(--ochre)">
      <div class="ac-wk">{a.n}<span class="ac-wkind">also married {a.of.sn || a.of.n}</span></div>
      <div class="ac-wn"><span set:html={md(a.why || "")}></span></div>
    </div>
  ))}
</div>
)}

{lists && folds.length > 0 && (
<div class="ac-walls">
  <h2>{folds.length === 1
        ? "Where the line folds back on itself"
        : `The ${folds.length} places the line folds back on itself`}</h2>
  <p class="ac-lead">The same couple reached by two paths. Read forwards it is
    a cousin marriage; read backwards it is one set of ancestors standing in
    two places on this chart, counted once.</p>
  {folds.map(f => (
    <div class="ac-wrow" style="--k:var(--accent)">
      <div class="ac-wk">{f.sn || f.n}<span class="ac-wkind">counted once</span></div>
      <div class="ac-wn"><span set:html={md(f.same)}></span></div>
    </div>
  ))}
</div>
)}

<style is:global>
  .ac-lead { font-size: 14px; color: var(--ink-2); margin: 0 0 12px; max-width: 62ch; }
  .ac-scroll { overflow-x: auto; padding: 4px 2px 10px; }
  .ac { position: relative; }
  .ac-gl {
    position: absolute; top: 0; font-family: var(--sans); font-size: 10px;
    letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3);
  }
  .ac-lane {
    position: absolute; top: 16px; bottom: 0; width: 0;
    border-left: 1px dashed rgba(255, 255, 255, .2); pointer-events: none;
  }
  .ac-h, .ac-v { position: absolute; }
  .ac-h { border-top: 1px solid var(--rule-strong); z-index: 1; }
  .ac-v { border-left: 1px solid var(--rule-strong); z-index: 1; }

  .ac-box, .ac-wall {
    position: absolute; z-index: 2; width: 232px; height: 52px; box-sizing: border-box;
    border-radius: 2px; padding: 7px 10px; overflow: hidden;
  }
  .ac-box { border: 1px solid var(--rule); border-left: 3px solid var(--c); background: var(--panel); }
  .ac-n { font-family: var(--serif); font-size: 14.5px; line-height: 1.2; white-space: nowrap;
          overflow: hidden; text-overflow: ellipsis; }
  .ac-n a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--rule-strong); }
  .ac-m { margin-top: 3px; display: flex; gap: 9px; align-items: baseline; white-space: nowrap;
          overflow: hidden; text-overflow: ellipsis; }
  .ac-d { font-family: var(--mono); font-size: 11px; color: var(--ink-2); }
  .ac-p { font-size: 10.5px; color: var(--ink-3); overflow: hidden; text-overflow: ellipsis; }
  .ac-x { font-size: 10.5px; color: var(--accent); text-decoration: none; }

  .ac-wall { border: 1px dashed var(--k); display: flex; align-items: center; }
  .ac-wl { font-family: var(--sans); font-size: 10px; letter-spacing: .1em;
           text-transform: uppercase; color: var(--k); }

  .ac-walls { margin-top: 18px; }
  .ac-walls h2 { font-family: var(--serif); font-size: 19px; margin: 0 0 10px; }
  .ac-wkind {
    display: block; font-family: var(--mono); font-size: 10px; letter-spacing: .08em;
    text-transform: uppercase; color: var(--k); margin-top: 4px;
  }
  .ac-wrow { display: grid; grid-template-columns: 160px 1fr; gap: 4px 14px;
             padding: 8px 0; border-top: 1px solid var(--rule); }
  .ac-wk { font-family: var(--sans); font-size: 10px; letter-spacing: .1em;
           text-transform: uppercase; color: var(--k); padding-top: 2px; }
  .ac-wlink { text-decoration: none; border-bottom: 1px solid currentColor; }
  .ac-go { display: inline-block; margin-left: 6px; font-size: 13px; color: var(--accent); text-decoration: none; white-space: nowrap; }
  .ac-go:hover { text-decoration: underline; }
  .ac-wn { font-size: 13.5px; line-height: 1.6; color: var(--ink-2); }
  @media (max-width: 620px) { .ac-wrow { grid-template-columns: 1fr; } }
</style>
