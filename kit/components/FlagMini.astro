---
/* The mini flags of one ribbon card (StoryRibbon, FamilyRibbon), as one small strip in the card's HEADER ROW: absolutely placed at
   the ends of the row that holds "Gen. n" (the right end first), so the card is exactly the size it is without them (kit/tools/checkflagfit.mjs
   measures that, and that the strip touches no text). For each place the card names (from, at, spouse, in that order) the ERA flag
   (the state that held the place in the card's year) and, only where it is another country's, TODAY's; or today's alone where the
   era cannot be said; a flag two places share is drawn once. 12px high, 3:2, a hairline edge, 2px corners; today's has a tiny dotted
   underline. A slot that holds the from line's flag carries the card's evidence ring (dashed inferred, dotted family memory).

   Each flag's alt (its accessible name) and title (the tooltip) name the place it is for: "at Canelones, 1791: Spanish Empire then",
   "from Córdoba: Spain today"; a shared flag lists each ("from Senj: Croatia today; at Senj: Croatia today"). Past the cap, a "+n"
   mark whose words list the rest.

   The flags are CHOSEN by kit/tools/ribbonflags.py and checked by kit/tools/checkribbonflags.py (kit/docs/ribbon-flags.md). The art
   is the kit's copy of the Flags Atlas's (David Defranceski's, used on his archives with his say; no open licence), resolved by the
   build, so an archive copies nothing.

   props
     card   the ribbon card ({..., living, minor, spouseLiving, flags[{kind, line, place, svg, flag, year, label, grade, ...}]})
     cap    the most marks the strip draws (default 4: two stacked at the right end of the story card's header, two at its left end;
            FamilyRibbon passes 3, one row at the right end, its "Gen. n" moved to the left end) */
import { stripOf, slotClass, flagSrc } from "../lib/flags.js";
const { card, cap = 4 } = Astro.props;
const ART = import.meta.glob("../data/flags/*.svg", { eager: true, query: "?url", import: "default" });
const all = stripOf(card);
const flat = [...all.slots.map((s) => s.label), ...all.more];
const slots = all.slots.length + (all.more.length ? 1 : 0) <= cap ? all.slots : all.slots.slice(0, cap - 1);
const more = flat.slice(slots.length);
const shown = slots.map((s) => ({ s, src: flagSrc(ART, s) })).filter((x) => x.src);
const marks = shown.length ? [...shown, ...(more.length ? [{ more: true }] : [])] : [];
/* the story card: a column of two at the right end of the header row, then a column of two at its left end (the glyph and "Gen. n"
   stay clear between them); the family card: one row at the right end */
const groups = !marks.length ? [] : cap === 4 ? [marks.slice(0, 2), marks.slice(2)].filter((g) => g.length) : [marks];
---
{groups.map((g, gi) => (
  <span class={`flag-strip flag-strip-${cap}${gi ? " flag-strip-left" : ""}`} data-flag-strip={g.length}>
    {g.map((x) => x.more ? (
      <span class="flag-more" role="img" aria-label={more.join("; ")} title={more.join("; ")}>+{more.length}</span>
    ) : (
      <img class={slotClass(x.s)} src={x.src} alt={x.s.label} title={x.s.label} width="18" height="12" decoding="async"
           data-flag={x.s.flag} data-flag-kind={x.s.kind} data-flag-lines={x.s.lines.join(" ")} />
    ))}
  </span>
))}
