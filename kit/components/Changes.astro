---
/* What changed, most recent first.
 *
 * The widest spread in the estate — 378 words on one archive against 53,386 on
 * another, a 141x gap for what is the same job everywhere: a dated note saying
 * what was done and what it turned up. Four of the seven keep one, and only the
 * shape differed. Falco lists 118 commits flat; Defranceschi, D'Arcy and Lerena
 * group by day, which is the better read and is what this does.
 *
 * TWO FIELDS, NOT ONE. «What was done» and «what was found» are different
 * things and the archives that separate them are right to: reading a register
 * for six hours and finding nothing is a day's work and no discovery, and a
 * feed that only records discoveries quietly rewrites the effort. Where an
 * archive has only one of the two, only one is shown.
 *
 *   days  [{when, id, entries:[{title, did, found, href, kind}]}]
 *          did/found arrive as HTML the archive has already rendered
 *
 * `id` is optional and exists because three of these archives put a table of
 * contents at the top of the page and link down to each day. Without it those
 * links point at nothing - Lerena shipped five dangling anchors on /changes/
 * for exactly as long as nobody ran a link checker over them. Same omission,
 * and same fix, as Corrections.astro.

 *
 * SET OUT TO BE READ (17 Nov 2026). Entries are long: on Defranceschi the median
 * is 1,300 characters in one run and the longest is 698,000, and the page was a
 * wall of it. So now: one date heading a day; each entry's title is the headline
 * and the kind is a small coloured chip beside it; the source (optional `src`)
 * is one muted line under the title; the account is held to a ~70-character
 * column and an account taller than about six lines is folded with a "Read the
 * whole entry" control (the script adds the fold, so with no script, or in
 * print, the whole text shows). "Open all / Fold all" does every entry at once.
 * Filtering says "Showing x of y". `found` keeps its old meaning (what was
 * found); an archive that was passing a source in it should pass `src`.
 *
 *   entries:[{title, did, found, src, href, kind}]   src is HTML, one line
 */
const { days = [], u = (p) => p, unit = "days" } = Astro.props;
const kinds = [...new Set(days.flatMap((d) => (d.entries || []).map((e) => e.kind)).filter(Boolean))];
const total = days.reduce((a, d) => a + (d.entries || []).length, 0);
const ext = (h) => /^(https?:)?\/\//.test(String(h || ""));
const slug = (k) => String(k || "").toLowerCase().replace(/[^a-z]+/g, "");
---
<div class="ch">
  <div class="ch-bar">
    {kinds.length > 1 ? (
      <>
        <span class="ch-lab">Show</span>
        <button type="button" class="ch-opt on" data-v="">All <span class="mono">{total}</span></button>
        {kinds.map((k) => (
          <button type="button" class="ch-opt" data-v={k}>{k}
            <span class="mono">{days.reduce((a, d) => a + (d.entries || []).filter((e) => e.kind === k).length, 0)}</span></button>
        ))}
      </>
    ) : null}
    <button type="button" class="ch-all" hidden>Open all</button>
  </div>
  <p class="ch-count small" hidden></p>

  {days.map((d) => (
    <section class="ch-day" id={d.id}>
      <h3 class="ch-when">{d.when}
        <span class="small mono ch-n">{(d.entries || []).length}</span></h3>
      {(d.entries || []).map((e) => (
        <article class={"ch-e ch-c-" + slug(e.kind)} data-kind={e.kind || ""}>
          <h4 class="ch-t">
            {e.kind ? <span class="ch-chip">{e.kind}</span> : null}
            {e.href
              ? <a href={ext(e.href) ? e.href : u(e.href)} rel={ext(e.href) ? "noopener" : null}
                   set:html={e.title} />
              : <span set:html={e.title} />}
          </h4>
          {e.src ? <p class="ch-src small" set:html={e.src} /> : null}
          {(e.did || e.found) ? (
            <div class="ch-body">
              {e.did ? <div class="ch-did"><span class="ch-k">did</span><div class="ch-x"><Fragment set:html={e.did} /></div></div> : null}
              {e.found ? <div class="ch-found"><span class="ch-k">found</span><div class="ch-x"><Fragment set:html={e.found} /></div></div> : null}
            </div>
          ) : null}
        </article>
      ))}
    </section>
  ))}
  <p class="ch-none small" hidden>Nothing of that kind.</p>
</div>

<script>
  document.querySelectorAll(".ch").forEach((box) => {
    const entries = [...box.querySelectorAll(".ch-e")];
    const days = [...box.querySelectorAll(".ch-day")];
    const none = box.querySelector(".ch-none");
    const count = box.querySelector(".ch-count");
    const all = box.querySelector(".ch-all");
    const total = entries.length;

    /* fold the long ones: only an entry that really is taller than the fold gets a control */
    const folds = [];
    for (const e of entries) {
      const body = e.querySelector(".ch-body");
      if (!body) continue;
      body.classList.add("is-folded");
      if (body.scrollHeight <= body.clientHeight + 8) { body.classList.remove("is-folded"); continue; }
      const b = document.createElement("button");
      b.type = "button"; b.className = "ch-more"; b.textContent = "Read the whole entry";
      b.setAttribute("aria-expanded", "false");
      b.addEventListener("click", () => set(body, b, body.classList.contains("is-folded")));
      body.after(b);
      folds.push([body, b]);
    }
    function set(body, b, open) {
      body.classList.toggle("is-folded", !open);
      b.textContent = open ? "Fold it again" : "Read the whole entry";
      b.setAttribute("aria-expanded", open ? "true" : "false");
    }
    if (all && folds.length) {
      all.hidden = false;
      all.addEventListener("click", () => {
        const open = all.dataset.open !== "1";
        for (const [body, b] of folds) set(body, b, open);
        all.dataset.open = open ? "1" : "0";
        all.textContent = open ? "Fold all" : "Open all";
      });
    }

    box.querySelectorAll(".ch-opt").forEach((b) => {
      b.addEventListener("click", () => {
        box.querySelectorAll(".ch-opt").forEach((x) => x.classList.remove("on"));
        b.classList.add("on");
        const v = b.dataset.v || "";
        let shown = 0;
        for (const e of entries) {
          const ok = !v || e.dataset.kind === v;
          e.hidden = !ok;
          if (ok) shown++;
        }
        /* a day with nothing left in it goes too, or the feed becomes a list of
           empty dates */
        for (const d of days) d.hidden = ![...d.querySelectorAll(".ch-e")].some((e) => !e.hidden);
        if (none) none.hidden = shown > 0;
        if (count) {
          count.hidden = !v;
          count.innerHTML = "Showing " + shown + " of " + total + ". ";
          if (v) {
            const a = document.createElement("a");
            a.href = "#"; a.textContent = "Show all";
            a.addEventListener("click", (ev) => { ev.preventDefault(); box.querySelector('.ch-opt[data-v=""]')?.click(); });
            count.append(a);
          }
        }
      });
    });
  });
</script>

<style is:global>
  .ch-bar { display:flex; flex-wrap:wrap; gap:.35rem; align-items:center; margin:1rem 0 .5rem; }
  .ch-lab { font-size:11px; font-weight:600; letter-spacing:.11em; text-transform:uppercase;
    color:var(--ink-3,#888); margin-right:.35rem; }
  .ch-opt, .ch-all { font:inherit; font-size:.78rem; padding:.22rem .6rem; cursor:pointer;
    color:var(--ink-2,inherit); background:transparent; border:1px solid var(--rule,#ccc);
    border-radius:2px; display:inline-flex; gap:.4rem; align-items:baseline; }
  .ch-all { margin-left:auto; }
  .ch-opt.on { color:var(--accent,#963); border-color:var(--accent,#963);
    background:var(--accent-wash,transparent); font-weight:600; }
  .ch-count { margin:.2rem 0 0; color:var(--ink-3,#888); }
  .ch-day { margin:2rem 0 0; }
  .ch-when { display:flex; align-items:baseline; gap:.5rem; margin:0 0 .2rem;
    font-size:1.05rem; border-bottom:1px solid var(--rule,#ddd); padding-bottom:.3rem; }
  .ch-n { font-weight:400; color:var(--ink-3,#888); margin-left:auto; }
  .ch-e { padding:1rem 0 1.05rem; border-bottom:1px solid var(--rule,rgba(128,128,128,.14)); max-width:46rem; }
  .ch-t { margin:0; font-size:1.02rem; font-weight:600; line-height:1.4; }
  .ch-t a { text-decoration-thickness:1px; text-underline-offset:2px; }
  .ch-chip { display:inline-block; vertical-align:.12em; margin-right:.55rem; padding:.05rem .45rem;
    font-size:10.5px; font-weight:600; letter-spacing:.09em; text-transform:uppercase; line-height:1.6;
    color:var(--ink-3,#777); border:1px solid currentColor; border-radius:2px; opacity:.85; }
  .ch-c-found .ch-chip { color:var(--accent,#8a5a3b); opacity:1; }
  .ch-c-correction .ch-chip { color:var(--terra,#a5442c); opacity:1; }
  .ch-c-blocked .ch-chip, .ch-c-nothing .ch-chip, .ch-c-nil .ch-chip { opacity:.6; }
  .ch-src { margin:.3rem 0 0; color:var(--ink-3,#777); line-height:1.5; max-width:70ch; }
  .ch-body { margin-top:.6rem; }
  .ch-body.is-folded { max-height:9.6em; overflow:hidden; position:relative;
    -webkit-mask-image:linear-gradient(#000 62%, transparent); mask-image:linear-gradient(#000 62%, transparent); }
  .ch-did, .ch-found { display:grid; grid-template-columns:3.2rem minmax(0,70ch); gap:.2rem .6rem; margin:.4rem 0 0; line-height:1.62; }
  .ch-k { font-size:11px; font-weight:600; letter-spacing:.11em; text-transform:uppercase;
    color:var(--ink-3,#888); padding-top:.28em; }
  .ch-x { color:var(--ink,inherit); font-weight:400; font-size:.94rem; overflow-wrap:anywhere; }
  .ch-did .ch-x { color:var(--ink-2,inherit); }
  .ch-x p { margin:0 0 .6em; }
  .ch-more { font:inherit; font-size:.8rem; margin:.3rem 0 0 3.8rem; padding:0; cursor:pointer; background:none; border:0;
    color:var(--accent,#963); text-decoration:underline; text-underline-offset:2px; }
  @media (max-width:560px) {
    .ch-did, .ch-found { grid-template-columns:1fr; }
    .ch-k { padding-top:0; }
    .ch-more { margin-left:0; }
  }
  @media print { .ch-body.is-folded { max-height:none; -webkit-mask-image:none; mask-image:none; }
    .ch-more, .ch-all, .ch-bar { display:none; } }
</style>
