---
/* A long list of rows, with a search box and facet buttons over it.
 *
 * Seven archives had written this seven times. Every one of them had a filter
 * box and a script; five had a table and two had talked themselves out of one;
 * /people/ ran from 2,634 words to 50,004 and /who/ from 1,099 to 16,861. The
 * job is identical on all of them — here are the rows, let me narrow them —
 * and nothing about it is archive-specific except WHICH rows and WHICH facets,
 * which is exactly what the props are.
 *
 * WORKS WITHOUT SCRIPT. Every row is in the HTML and visible before anything
 * runs; the script only hides. A reader with no JavaScript, a search engine,
 * and Reader mode all get the whole list, which is the point of a static
 * archive. The count line says so when nothing is filtered.
 *
 * THE FACETS ARE THE ARCHIVE'S. This renders whatever buttons it is handed and
 * knows nothing about what they mean — Falco facets by household and by line,
 * Blazevic by ahnentafel, Lerena by status. A component that decided the facets
 * would be deciding what each archive is about.
 *
 *   columns  [{label, cls}]
 *   rows     [{cells:[…], hay, facets:{key:value}, href}]  cells may be HTML
 *   facets   [{key, label, options:[{v, label}]}]
 *   note     a line under the controls, before the table
 */
const {
  /* Optional variant → canonical map, applied to BOTH the query and the row
     text, word by word. The Blazevic register folds spellings this way so that
     "zubrin" finds Žubrinić, Xubrinich and Zubrinich alike and "Joannis" finds
     every Ivan — behaviour that a plain substring search would have quietly
     thrown away when that page moved onto this component. Emitted as JSON next
     to the table rather than inlined into the script, so the script stays one
     bundled module shared by every table on the page. */
  fold = null,
  columns = [], rows = [], facets = [], note = "",
  empty = "Nothing matches that.",
  unit = "rows",
  id = "ft",
} = Astro.props;
---
<div class="ft" data-ft={id} data-multi={facets.filter((f) => f.multi).map((f) => f.key).join(" ")}>
  {fold ? <script type="application/json" class="ft-fold" set:html={JSON.stringify(fold)} /> : null}
  <div class="ft-bar">
    <label class="ft-search">
      <span class="ft-lab">Search</span>
      <input type="search" class="ft-q" placeholder={`Filter ${rows.length.toLocaleString()} ${unit}…`}
             autocomplete="off" spellcheck="false" />
    </label>
    {/* Buttons while they fit; a select beyond that. Mazza facets by surname and
        has 124 of them — a row of 124 buttons is not a filter, it is a wall. */}
    {facets.map((f) => (
      <div class="ft-facet" data-key={f.key} data-keys={[...new Set((f.options||[]).map(o=>o.k||f.key))].join(" ")}>
        <span class="ft-lab">{f.label}</span>
        {f.options.length > (f.max ?? 7) ? (
          <select class="ft-sel">
            <option value="">{f.all || "All"}</option>
            {/* the key travels with the option here too, or a group whose
                options test different keys silently loses them the moment it
                grows past the button threshold */}
            {f.options.map((o) => (
              <option value={String(o.v)} data-k={o.k || f.key}
                      set:html={String(o.label).replace(/<[^>]+>/g, "")} />
            ))}
          </select>
        ) : (
          <div class="ft-opts">
            <button type="button" class="ft-opt on" data-v="">{f.all || "All"}</button>
            {/* An option may name its OWN key. Falco's first group is five
                different booleans — my line, in my tree, in a household,
                attached, living — offered as one row of buttons, which is not
                one key with five values and would have come out as five
                separate facets if this only understood that shape. */}
            {f.options.map((o) => (
              <button type="button" class="ft-opt" data-v={String(o.v)}
                      data-k={o.k || f.key} set:html={o.label} />
            ))}
          </div>
        )}
      </div>
    ))}
  </div>

  <p class="ft-count small">
    <span class="ft-n">{rows.length.toLocaleString()}</span> {unit}
    <span class="ft-of dim"> · everything is listed; the filters only narrow it</span>
  </p>
  {note ? <p class="small ft-note" set:html={note} /> : null}

  <div class="scroll">
    <table class="ft-table">
      <thead><tr>{columns.map((c) => <th class={c.cls || ""}>{c.label}</th>)}</tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr class="ft-row" data-hay={r.hay || ""}
              {...Object.fromEntries((facets || []).map((f) => ["data-" + f.key, String((r.facets || {})[f.key] ?? "")]))}>
            {r.cells.map((c, i) => (
              <td class={(columns[i] && columns[i].cls) || ""} set:html={c} />
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="ft-empty small" hidden>{empty}</p>
</div>

<script>
  /* One handler for every table on the page, keyed by its own id, so two of
     these can sit on one page without fighting. */
  document.querySelectorAll(".ft").forEach((box) => {
    const q = box.querySelector(".ft-q");
    const rows = [...box.querySelectorAll(".ft-row")];
    const nEl = box.querySelector(".ft-n");
    const ofEl = box.querySelector(".ft-of");
    const emptyEl = box.querySelector(".ft-empty");
    const picked = {};
    const MULTI = new Set((box.dataset.multi || "").split(/\s+/).filter(Boolean));

    let MAP = null;
    const foldEl = box.querySelector(".ft-fold");
    if (foldEl) { try { MAP = JSON.parse(foldEl.textContent); } catch (e) { MAP = null; } }
    const fold = (t) => !MAP ? t
      : t.toLowerCase().split(/[^\p{L}\p{N}]+/u).map((w) => MAP[w] || w).join(" ").trim();
    if (MAP) for (const r of rows) r.dataset.folded = fold(r.dataset.hay || "");

    const apply = () => {
      const raw = (q && q.value || "").trim().toLowerCase();
      const needle = MAP ? fold(raw) : raw;
      let shown = 0;
      for (const r of rows) {
        const text = MAP ? (r.dataset.folded || "") : (r.dataset.hay || "");
        let ok = !needle || text.includes(needle);
        if (ok) for (const k in picked) {
          if (!picked[k]) continue;
          const have = r.dataset[k] || "";
          /* A MULTI facet holds a set: a row carries several tags and matches
             if it carries this one. Defranceschi and Blazevic both tag their
             search register and let a reader click a tag, and a one-value-per-
             key model would have dropped that on the way to the shared table. */
          const multi = MULTI.has(k);
          if (multi ? !(" " + have + " ").includes(" " + picked[k] + " ") : have !== picked[k]) {
            ok = false; break;
          }
        }
        r.hidden = !ok;
        if (ok) shown++;
      }
      if (nEl) nEl.textContent = shown.toLocaleString();
      const filtered = needle || Object.values(picked).some(Boolean);
      if (ofEl) ofEl.textContent = filtered
        ? ` of ${rows.length.toLocaleString()}`
        : " · everything is listed; the filters only narrow it";
      if (emptyEl) emptyEl.hidden = shown > 0;
    };
    apply();

    /* ?q= in the address bar pre-fills the box. The Mazza page did this and it
       is how every "every X in the register →" link on the estate arrives. */
    if (q) {
      const pre = new URLSearchParams(location.search).get("q");
      if (pre) q.value = pre;
      q.addEventListener("input", apply);
    }
    box.querySelectorAll(".ft-sel").forEach((sel) => {
      const wrap = sel.closest(".ft-facet");
      const keys = (wrap.dataset.keys || wrap.dataset.key || "").split(/\s+/).filter(Boolean);
      sel.addEventListener("change", () => {
        for (const k of keys) picked[k] = "";
        const opt = sel.selectedOptions[0];
        if (sel.value) picked[(opt && opt.dataset.k) || wrap.dataset.key] = sel.value;
        apply();
      });
    });
    box.querySelectorAll(".ft-facet").forEach((f) => {
      const key = f.dataset.key;
      f.querySelectorAll(".ft-opt").forEach((b) => {
        b.addEventListener("click", () => {
          f.querySelectorAll(".ft-opt").forEach((x) => x.classList.remove("on"));
          b.classList.add("on");
          /* clear every key this group can set, then set the chosen one */
          f.querySelectorAll(".ft-opt").forEach((x) => { picked[x.dataset.k || key] = ""; });
          if (b.dataset.v) picked[b.dataset.k || key] = b.dataset.v;
          apply();
        });
      });
    });
  });
</script>

<style is:global>
  .ft-bar { display:flex; flex-wrap:wrap; gap:.9rem 1.4rem; align-items:flex-end;
    margin:.9rem 0 .6rem; }
  .ft-lab { display:block; font-size:9.5px; font-weight:600; letter-spacing:.11em;
    text-transform:uppercase; color:var(--ink-3,#888); margin-bottom:.25rem; }
  .ft-search { flex:1 1 15rem; max-width:24rem; }
  .ft-q { width:100%; padding:.42rem .6rem; font:inherit; font-size:.9rem;
    color:var(--ink,inherit); background:var(--bg-2,transparent);
    border:1px solid var(--rule,#ccc); border-radius:3px; }
  .ft-q:focus { outline:2px solid var(--accent,#963); outline-offset:1px; }
  .ft-opts { display:flex; flex-wrap:wrap; gap:.3rem; }
  .ft-opt { font:inherit; font-size:.78rem; padding:.2rem .55rem; cursor:pointer;
    color:var(--ink-2,inherit); background:transparent;
    border:1px solid var(--rule,#ccc); border-radius:2px; }
  .ft-opt:hover { border-color:var(--accent,#963); }
  .ft-sel { font:inherit; font-size:.82rem; padding:.3rem .4rem; color:var(--ink,inherit);
    background:var(--bg-2,transparent); border:1px solid var(--rule,#ccc); border-radius:3px;
    max-width:14rem; }
  .ft-opt.on { color:var(--accent,#963); border-color:var(--accent,#963);
    background:var(--accent-wash,transparent); font-weight:600; }
  .ft-count { margin:.2rem 0 .1rem; font-variant-numeric:tabular-nums; }
  .ft-note { color:var(--ink-3,#888); margin:.1rem 0 .5rem; }
  .ft-empty { color:var(--ink-3,#888); padding:.8rem 0; }
  .ft-table { width:100%; }
</style>
