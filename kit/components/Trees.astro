---
/* Every line an archive follows, each stated in the form its own evidence
 * supports. Taken from the Defranceschi archive, which worked it out: the
 * point is not the chart, it is refusing to draw a spine you cannot prove.
 *
 *   drawn     a pedigree — generation on generation, the joins proved
 *   web       households whose joins are not proved. Drawn as what it is
 *   drawable  the evidence would support a chart and nobody has made one
 *   route     places in order, the people between them unknown
 *   closed    followed, tested, and shown not to belong here
 *
 * Rows come from the archive's own trees.json.
 */
const { rows = [], note, close, doors = [] } = Astro.props;

const STATE = {
  drawn:    ["Drawn as a line",     "var(--accent)"],
  web:      ["Drawn as a web",      "var(--terra)"],
  drawable: ["Could be drawn",      "var(--ochre)"],
  route:    ["A route, not a line", "var(--ink-3)"],
  closed:   ["Followed and closed", "var(--rule-strong)"],
};
---
{note && <p class="prose" style="margin-bottom:6px">{note}</p>}

<div class="tl">
  {rows.map(r => {
    const [label, colour] = STATE[r.state] || STATE.route;
    return (
      <section class="tl-row" style={`--c:${colour}`}>
        <div class="tl-head">
          <div>
            <div class="tl-n">{r.name}{r.ours && <span class="tl-ours">ours</span>}</div>
            <div class="tl-d">{r.depth}</div>
          </div>
          <span class="tl-s">{label}</span>
        </div>
        <p class="tl-w">{r.what}</p>
        {r.gap && <p class="tl-g">{r.gap}</p>}
        {r.href && <a class="tl-go" href={r.href}>{r.cta || "Open it →"}</a>}
      </section>
    );
  })}
</div>

{close && <p class="prose note" style="margin-top:24px">{close}</p>}

{doors.length > 0 && (
  <div class="tl-doors">
    <h3>Where to start</h3>
    <div class="tl-door-grid">
      {doors.map(([href, name, blurb]) => (
        <a class="tl-door" href={href}>
          <span class="tl-dn">{name}</span>
          <span class="tl-dd">{blurb}</span>
          <span class="tl-go2">Open →</span>
        </a>
      ))}
    </div>
  </div>
)}

<style>
  .tl { display: flex; flex-direction: column; gap: 16px; margin-top: 18px; }
  .tl-row { border-left: 3px solid var(--c); background: var(--panel); padding: 15px 17px; border-radius: 2px; }
  .tl-head { display: flex; gap: 14px; align-items: baseline; flex-wrap: wrap; }
  .tl-n { font-family: var(--serif); font-size: 20px; }
  .tl-ours {
    margin-left: 9px; font-family: var(--sans); font-size: 9.5px; letter-spacing: .12em;
    text-transform: uppercase; color: var(--accent); border: 1px solid var(--accent);
    padding: 1px 6px; border-radius: 2px; vertical-align: middle;
  }
  .tl-d { font-family: var(--mono); font-size: 12px; color: var(--ink-2); margin-top: 3px; }
  .tl-s {
    margin-left: auto; font-family: var(--sans); font-size: 10px; letter-spacing: .1em;
    text-transform: uppercase; color: var(--c); border: 1px solid var(--c);
    padding: 2px 8px; border-radius: 2px; white-space: nowrap;
  }
  .tl-w { margin-top: 11px; font-size: 14.5px; line-height: 1.62; color: var(--ink-2); }
  .tl-g { margin-top: 9px; font-size: 13.5px; line-height: 1.6; color: var(--ink-3);
          border-left: 2px solid var(--rule-strong); padding-left: 11px; }
  .tl-go { display: inline-block; margin-top: 11px; font-size: 13px; color: var(--accent); text-decoration: none; }
  .tl-go:hover { text-decoration: underline; }
  .tl-doors { margin-top: 34px; border-top: 1px solid var(--rule); padding-top: 22px; }
  .tl-doors h3 { font-family: var(--sans); font-size: 11px; font-weight: 600;
                 letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); }
  .tl-door-grid { display: grid; gap: 12px; margin-top: 14px;
                  grid-template-columns: repeat(auto-fit, minmax(232px, 1fr)); }
  .tl-door { display: block; border: 1px solid var(--rule); border-radius: 3px;
             padding: 14px 16px; text-decoration: none; background: var(--panel); }
  .tl-door:hover { border-color: var(--accent); }
  .tl-dn { display: block; font-family: var(--serif); font-size: 18px; color: var(--ink); }
  .tl-dd { display: block; font-size: 13.5px; line-height: 1.55; color: var(--ink-2); margin-top: 6px; }
  .tl-go2 { display: block; font-size: 12.5px; color: var(--accent); margin-top: 10px; }
  @media (max-width: 620px) { .tl-s { margin-left: 0; } }
</style>
