---
/* A LIST OF RESEARCH PAGES, each with what it asks and, where the archive can state one, a number counted from its own data.
   The kit's one copy (12 November 2026), from the Defranceski research-menu trial; used by the /research/ hub and the group
   pages so they read alike. The kit does not know an archive's data shapes, so the archive hands over the sentence:
     items   [{ href, label, blurb, atlas? }]   `blurb` is HTML (an archive builds it from the canon's `asks` plus its count);
                                                `atlas: true` shows "on the Atlas too" */
import { u } from "../lib/url.js";
const { items = [] } = Astro.props;
---
<ul class="rl">
  {items.map((x) => (
    <li>
      <a class="rl-t" href={u(x.href)}>{x.label}</a>
      {x.atlas && <span class="rl-a" title="Its registers and places are also on the Record Atlas">on the Atlas too</span>}
      {x.blurb && <span class="rl-n" set:html={x.blurb}></span>}
    </li>
  ))}
</ul>
<style>
  .rl { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 10px; }
  .rl li { border: 1px solid var(--rule, #dcd6cc); border-left: 3px solid var(--accent, #8a5a3b); border-radius: 3px; padding: 12px 16px; }
  .rl-t { font-weight: 600; font-size: 17px; }
  .rl-a { margin-left: 10px; font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; opacity: .62; border: 1px solid currentColor; border-radius: 2px; padding: 1px 6px; }
  .rl-n { display: block; margin-top: 4px; font-size: 14.5px; line-height: 1.55; opacity: .85; }
</style>
