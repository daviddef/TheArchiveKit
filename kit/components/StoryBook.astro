---
/* A family told as a short book: a prologue, eight or so chapters in order, a family tree and a map in each, and at the
   end what is not known and where the papers are. One component, the same in every archive; an archive supplies DATA
   (kit/docs/story.md, kit/data/story-schema.json) and kit/tools/checkfamilystory.py holds the data to it.

   WHAT IT REFUSES TO FLATTEN. Every paragraph says how well it is known. A paragraph about the people carries one of three
   marks, the grade of its WEAKEST claim: doc (a document says so), inf (the archive reasons it from documents), lore (family
   memory, a family chart or tree). A paragraph about "the world around them" (the place, the years, the trade: never a claim
   that these people did or saw it) is set in apart and carries where the detail comes from: archive (this archive's own
   pages) or history (general history, listed in the notes at the end). The same grammar is in the trees (outline: solid,
   dashed, dotted) and the maps (leg: solid, dashed, dotted; a route nobody knows is not drawn). A claim the archive is not
   sure of says "to be confirmed". The living appear by relationship and place, with no dates; a minor by initials.

   LAYOUT. One left edge with the archive's title. From 1100px each chapter is two zones: the prose at its reading measure on
   the left, the tree, the document it rests on and its plates on the right, the map across the full width under both; the
   DOM order is text, tree, map, document, plates, papers at every width, so reading and focus order never change. Without
   script the ribbon is a plain list of links; with it, the card for the chapter being read is marked.

   props
     book        the story data (kit/docs/story.md). The archive's layout draws the title, eyebrow and dek from book.title etc.
     personHref  (slug) => address of a person's page ("person:slug" links in prose, tree and ribbon nodes). Default /people/<slug>/
     u           (path) => the path with the archive's deployment base. Default: unchanged.
     md          the archive's own light-markup renderer, if it renders links too. Default: the kit's md() with links done here.
     Plates      the archive's own plates component, if it has one: called as <Plates ids={[...]} />. Without it a chapter's
                 `plates` ids are looked up in `plateIndex` ({id: {src, alt, title, holder}}) and drawn as plain figures. */
import "../styles/story.css";
import { md as kitMd } from "../lib/md.js";
import Rule from "./Rule.astro";
import LineTree from "./LineTree.astro";
import StoryMap from "./StoryMap.astro";
import StoryRibbon from "./StoryRibbon.astro";
import {
  LEGEND, MARK_TITLE, proseHtml, linkTarget, generationsOf, worldLeads, marksOf, paragraphsOf, quotesOf, conflictsFor,
} from "../lib/story.js";
const { book, personHref = (s) => `/people/${s}/`, u = (p) => p, md = kitMd, Plates = null, plateIndex = {} } = Astro.props;
const chapters = book.chapters || [];
const closing = book.closing || {};
const gens = generationsOf(book);
const total = (book.ribbon?.cards || []).length;
const opts = { u, personHref };
const prose = (t) => proseHtml(t, md, opts);
const href = (h) => linkTarget(h, opts);
const mapsOf = (c) => (book.maps || []).filter((m) => m.chapter === c.id);
const when = (c) => [c.place, c.years].filter(Boolean).join(", ");
const marksTitle = (m) => `${MARK_TITLE[m.kind]}${m.why ? ": " + m.why : ""}`;
---
<div class="story" data-story>
  {book.ribbon && <StoryRibbon ribbon={book.ribbon} personHref={personHref} u={u} />}

  <aside class="st-legend" aria-label="How to read the marks">
    <span class="st-lt">How to read the marks</span>
    {(book.legend || LEGEND).map(([k, w]) => (
      <span class="st-li"><sup class={`st-mk st-mk-${k}`}>{k}</sup> {w}</span>
    ))}
    <span class="st-li"><span class="st-wl">In the world around them</span> the place and the years, never these people; marked <sup class="st-mk st-mk-archive">archive</sup> or <sup class="st-mk st-mk-history">history</sup></span>
    <span class="st-li">In the trees and maps: <b>solid</b> documented, <b>dashed</b> inferred, <b>dotted</b> family memory</span>
  </aside>

  <nav class="st-toc" aria-label="Chapters">
    {book.prologue && <a href="#start">{book.prologue.title}</a>}
    {chapters.map((c) => <a href={`#${c.id}`}><span class="st-tn">{c.numeral}</span> {c.title}</a>)}
    {closing.after && <a href="#after">{closing.after.title}</a>}
    {closing.unknown && <a href="#unknown">{closing.unknown.title}</a>}
    {closing.papers && <a href="#papers">{closing.papers.title}</a>}
  </nav>

  {book.prologue && (
    <section class="st-ch st-pro" id="start" aria-labelledby="start-h">
      <h2 id="start-h" class="st-h">{book.prologue.title}</h2>
      {paragraphsOf({ id: "start", paragraphs: book.prologue.paragraphs }).map((p) => (
        <p class="st-p" id={p.id} data-register="people" data-grade={p.grade}><span set:html={prose(p.text)} />{marksOf(p).map((m) => (
          <sup class={`st-mk st-mk-${m.kind}`}>{m.href ? <a href={href(m.href)} title={marksTitle(m)}>{m.kind}</a> : <span title={marksTitle(m)}>{m.kind}</span>}</sup>
        ))}{p.tbc && <span class="st-tbc" title={p.tbc}> to be confirmed</span>}</p>
      ))}
    </section>
  )}

  {chapters.map((c, ci) => {
    const paras = paragraphsOf(c);
    const lead = worldLeads(paras);
    const nx = chapters[ci + 1];
    const maps = mapsOf(c);
    const quotes = quotesOf(c);
    const conflicts = conflictsFor(book, c.id);
    const plates = c.plates || [];
    return (
      <>
        <Rule><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1L13 7L7 13L1 7Z" fill="none" stroke="currentColor" stroke-width="1.2" /></svg></Rule>
        <section class={`st-ch st-chap${maps.length ? " has-map" : ""}`} id={c.id} data-chapter={c.id} aria-labelledby={`${c.id}-h`}>
          <header class="st-head">
            <div class="st-num" aria-hidden="true">{c.numeral}</div>
            <h2 id={`${c.id}-h`} class="st-h"><span class="st-vh">Chapter {c.numeral}. </span>{c.title}</h2>
            <p class="st-when">{when(c)}{gens[c.id] && <span class="st-gen"> · generation{String(gens[c.id]).includes(" and ") ? "s" : ""} {gens[c.id]}{total ? ` of ${total}` : ""}</span>}</p>
          </header>
          <div class="st-text">
            {paras.map((p, i) => (
              p.register === "world"
                ? <div class="st-world" id={p.id} data-register="world" data-source={p.worldSource}>
                    <p class="st-p">{lead[i] && <span class="st-wl">In the world around them. </span>}<span set:html={prose(p.text)} />{marksOf(p).map((m) => (
                      <sup class={`st-mk st-mk-${m.kind}`}>{m.href ? <a href={href(m.href)} title={marksTitle(m)}>{m.kind}</a> : <span title={marksTitle(m)}>{m.kind}</span>}</sup>
                    ))}{p.tbc && <span class="st-tbc" title={p.tbc}> to be confirmed</span>}</p>
                  </div>
                : <p class={`st-p${i === 0 ? " st-first" : ""}`} id={p.id} data-register="people" data-grade={p.grade}><span set:html={prose(p.text)} />{marksOf(p).map((m) => (
                    <sup class={`st-mk st-mk-${m.kind}`}>{m.href ? <a href={href(m.href)} title={marksTitle(m)}>{m.kind}</a> : <span title={marksTitle(m)}>{m.kind}</span>}</sup>
                  ))}{p.tbc && <span class="st-tbc" title={p.tbc}> to be confirmed</span>}</p>
            ))}
          </div>
          {c.tree && <div class="st-treez"><LineTree tree={c.tree} title={c.title} next={nx ? nx.id : null} nextTitle={nx ? nx.title : ""} personHref={personHref} u={u} /></div>}
          {maps.length > 0 && <div class="st-mapz">{maps.map((m) => <StoryMap map={m} here={c.id} u={u} />)}</div>}
          {(quotes.length > 0 || c.hardLimit || conflicts.length > 0) && (
            <div class="st-cards">
              {book.cardsNote && <p class="st-cn">{book.cardsNote}</p>}
              {quotes.map((q) => (
                <aside class="st-card" aria-label={`In the document${q.title ? ": " + q.title : ""}`}>
                  <div class="st-ck">In the document{q.label ? ` · ${q.label}` : ""}</div>
                  {q.title && <div class="st-ct">{q.title}</div>}
                  <blockquote class="st-q">{q.text}</blockquote>
                  <p class="st-qs">{q.source}</p>
                  {q.hardLimit && <p class="st-hard"><span class="st-hl">What the paper cannot say.</span> {q.hardLimit}</p>}
                </aside>
              ))}
              {c.hardLimit && <p class="st-hard st-hard-ch"><span class="st-hl">What the paper cannot say.</span> {c.hardLimit}</p>}
              {conflicts.map((x) => <p class="st-cf"><span class="st-tbc">to be confirmed</span> {x.note}</p>)}
            </div>
          )}
          {plates.length > 0 && (
            <div class="st-plates">
              {Plates
                ? <Plates ids={plates} />
                : plates.map((id) => plateIndex[id] && (
                    <figure class="st-plate" id={`plate-${id}`}><img src={u(plateIndex[id].src)} alt={plateIndex[id].alt || plateIndex[id].title || ""} width={plateIndex[id].w} height={plateIndex[id].h} loading="lazy" decoding="async" /><figcaption><span class="st-plt">{plateIndex[id].title}</span>{plateIndex[id].holder && <span class="st-plh">{plateIndex[id].holder}</span>}</figcaption></figure>
                  ))}
            </div>
          )}
          <p class="st-papers"><span class="st-papl">The papers for this chapter</span>
            {(c.papers || []).map((x, k) => <>{k > 0 && <span aria-hidden="true"> · </span>}<a href={href(x.href)}>{x.title}</a></>)}
          </p>
        </section>
      </>
    );
  })}

  {closing.after && (
    <>
      <Rule><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1L13 7L7 13L1 7Z" fill="none" stroke="currentColor" stroke-width="1.2" /></svg></Rule>
      <section class="st-ch" id="after" aria-labelledby="after-h">
        <h2 id="after-h" class="st-h st-hs2">{closing.after.title}</h2>
        <p class="st-p" set:html={prose(closing.after.text)} />
        {(closing.after.links || []).length > 0 && <p class="st-papers">{closing.after.links.map((x, k) => <>{k > 0 && <span aria-hidden="true"> · </span>}<a href={href(x.href)}>{x.title}</a></>)}</p>}
      </section>
    </>
  )}

  {closing.unknown && (
    <>
      <Rule><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1L13 7L7 13L1 7Z" fill="none" stroke="currentColor" stroke-width="1.2" /></svg></Rule>
      <section class="st-ch" id="unknown" aria-labelledby="unknown-h">
        <h2 id="unknown-h" class="st-h st-hs2">{closing.unknown.title}</h2>
        {closing.unknown.lead && <p class="st-p" set:html={prose(closing.unknown.lead)} />}
        <ul class="st-list">
          {closing.unknown.items.map((x) => (
            <li><span set:html={prose(x.text)} />{x.href && <> <a class="st-more" href={href(x.href)}>Where it stands →</a></>}</li>
          ))}
        </ul>
      </section>
    </>
  )}

  {closing.papers && (
    <section class="st-ch" id="papers" aria-labelledby="papers-h">
      <h2 id="papers-h" class="st-h st-hs2">{closing.papers.title}</h2>
      {closing.papers.lead && <p class="st-p" set:html={prose(closing.papers.lead)} />}
      <ul class="st-list st-read">
        {closing.papers.links.map((x) => (
          <li><a href={href(x.href)}>{x.title}</a>{x.why && <> <span class="st-rw">{x.why}</span></>}</li>
        ))}
      </ul>
    </section>
  )}

  {(closing.notes || closing.mapNote) && (
    <section class="st-ch st-notes" id="world-notes" aria-labelledby="notes-h">
      {closing.notes && <>
        <h2 id="notes-h" class="st-h st-hs">{closing.notes.title}</h2>
        {closing.notes.lead && <p class="st-p" set:html={prose(closing.notes.lead)} />}
        <ol class="st-list st-wn">
          {closing.notes.items.map((x) => (
            <li id={`world-${x.key}`}><span class="st-wk">{x.key}</span> {x.claim} <span class="st-rw">{x.source}</span> {x.tbc !== false && <span class="st-tbc">to be confirmed</span>}</li>
          ))}
        </ol>
      </>}
      {closing.mapNote && <p class="st-p">{closing.mapNote}</p>}
    </section>
  )}
</div>

<script>
  /* The ribbon marks the chapter being read. Without script it is a plain list of links. */
  const all = [...document.querySelectorAll(".st-rib li[data-ch]")];
  if ("IntersectionObserver" in window && all.length) {
    const io = new IntersectionObserver((es) => {
      for (const e of es) {
        if (!e.isIntersecting) continue;
        for (const li of all) {
          const on = li.dataset.ch === e.target.dataset.chapter;
          li.classList.toggle("on", on);
          const a = li.querySelector("a.st-rb-top");
          if (on) a?.setAttribute("aria-current", "step"); else a?.removeAttribute("aria-current");
        }
      }
    }, { rootMargin: "-35% 0px -60% 0px" });
    document.querySelectorAll("section[data-chapter]").forEach((s) => io.observe(s));
  }
</script>
