---
/* ONE DAY of /whats-new/ (kit component, 12 November 2026; the rows laid out as Record Atlas lays out its research days):
   the date on the rule, then a card per change. A day's searches fold into ONE «Research» card that opens onto GROUPS (one per provider:
   Antenati, FamilySearch…), each with its tally and rows of three columns: the SOURCE'S NAME as a link (to the record itself when the row has
   an address, else to the archive's page that tells it, else to the log; the page that tells it is also named after the place), the place and the sentence beneath; a pill (✅ Found something, ❌ Nothing found); the pages.
   The first ten rows of a group show, the rest sit under «Show the other N». Each correction is a card of its own.
   When the archive has wired the receipts (WhatsNew passes `wired`), each row also has a second line beneath it (12 November 2026): the ATLAS state
   (In the Atlas / Sent, going live / Not sent yet / Nothing to send, a pill that says it in words and in its outline, not by colour alone; «see it in the Atlas» links to the Atlas PAGE, never claiming the volume's row) and the
   pages the finding went into (the row's `ev`, as links; or «log only»), and the day's tally says «N of M in the Atlas». lib/receipts.client.js
   refreshes the pills at view time; the rows carry data-key and data-state for it. Without `wired` the day is drawn exactly as before.
   props: d (a day of buildPulse), logHref, wired */
import { u } from "../lib/url.js";
import { CARD, KIND, pagesLabel } from "../lib/pulse.js";
import { STATE_LABEL } from "../lib/receipts.js";
const { d, logHref = "/searched/", wired = false } = Astro.props;
/* the Atlas pages after the first, one link per page: several marks can sit on one page (the receipts' hrefs are page paths, no anchors) */
const otherPages = (a) => { const seen = new Set([a.href]); return a.marks.filter((m) => !seen.has(m[1]) && seen.add(m[1])); };
const GLYPH = { "in-atlas": "✓", "going-live": "↻", "not-sent": "○", "nothing-to-send": "–" };
const STATE_NOTE = {
  "in-atlas": "The Record Atlas has this search, live now",
  "going-live": "Sent to the Record Atlas; it goes live with the Atlas's next deploy (13 to 65 minutes)",
  "not-sent": "Not yet sent to the Record Atlas",
  "nothing-to-send": "Checked: this note makes no mark on the Record Atlas (no source or volume to put on it)",
};
const part = (iso, o) => new Date(iso + "T00:00:00Z").toLocaleDateString("en-GB", { ...o, timeZone: "UTC" });
const long = d.exact ? part(d.iso, { day: "numeric", month: "long", year: "numeric" }) : part(d.iso, { month: "long", year: "numeric" });
const mark = { found: ["✅", "Found something"], nil: ["❌", "Nothing found"], partial: ["◐", "Partly read"], blocked: ["⛔", "Blocked"] };
const qRow = (e) => (e.head + " " + e.more + " " + e.src + " " + e.place).toLowerCase();
const SHOW = 10;
/* what the title links to: the record itself, else the page of the archive that tells it, else the log */
const hrefOf = (e) => e.ext || (e.story ? u(e.story) : u(e.href || logHref));
const isExt = (e) => !!e.ext;
---
<li class="wn-day" id={"d" + d.key}>
  <time class="wn-when" datetime={d.key} title={long}>
    {d.exact && <b>{part(d.iso, { day: "numeric" })}</b>}
    <span>{part(d.iso, { month: "short" })}</span>
    <em>{part(d.iso, { year: "numeric" })}</em>
  </time>
  <ul class="wn-items">
    {d.corrections.map((e) => (
      <li class="wn-item" data-type="corrected" data-q={e.head.toLowerCase()}>
        <span class="wn-chip2 corrected"><i aria-hidden="true">{CARD.corrected.glyph}</i> {CARD.corrected.label}</span>
        <a class="wn-head" href={u(e.href)}>{e.head}<span class="wn-go" aria-hidden="true"> →</span></a>
      </li>
    ))}
    {d.research.length > 0 && (
      <li class="wn-item" data-type="research" data-q={d.research.map(qRow).join(" ")}>
        <span class="wn-chip2 research"><i aria-hidden="true">{CARD.research.glyph}</i> {CARD.research.label}</span>
        <details class="wn-rday">
          <summary class="wn-head">{d.summary}{d.used}<span class="wn-tl">{d.tally}{wired && <span class="wn-atl">{d.atlasTally}</span>}</span></summary>
          {d.groups.map((g) => {
            const first = g.rows.slice(0, SHOW), rest = g.rows.slice(SHOW);
            const rowEl = (e) => (
              <div class="wn-row" data-q={qRow(e)}>
                <div class="wn-rt">
                  <a class="wn-ta" href={hrefOf(e)} rel={isExt(e) ? "noopener" : undefined} title={isExt(e) ? "Open the record at its source" : undefined}>{e.title}{isExt(e) && <span class="wn-ext" aria-hidden="true"> ↗</span>}</a>
                  {e.place && <span class="wn-rp">{e.place}</span>}
                  {e.walked && <span class="wn-rw" title="every entry of the book was read">walked</span>}
                  {e.story && <a class="wn-told" href={u(e.story)}>{e.head} →</a>}
                  {e.more && e.more !== e.title && <p class="wn-rm">{e.more}</p>}
                </div>
                <div class="wn-rc"><span class={`wn-rs ${e.kind}`} title={KIND[e.kind].note}><i aria-hidden="true">{mark[e.kind][0]}</i> {mark[e.kind][1]}</span></div>
                <div class="wn-rn">{pagesLabel(e.pages)}</div>
                {(wired || e.people.list.length > 0 || e.people.nobody) && (
                  <div class="wn-rx">
                    {wired && <div class="wn-ax" data-key={e.key} data-state={e.atlas ? e.atlas.state : undefined} hidden={!e.atlas}>
                      {e.atlas && <span class={`wn-at ${e.atlas.state}`} title={STATE_NOTE[e.atlas.state]}><i aria-hidden="true">{GLYPH[e.atlas.state]}</i> {STATE_LABEL[e.atlas.state]}</span>}
                      {e.atlas && e.atlas.state === "in-atlas" && e.atlas.href && <a class="wn-seeit" href={e.atlas.href} rel="noopener" title="Opens the Record Atlas page that carries this search; the page, not the volume's own row">see it in the Atlas ↗</a>}
                      {e.atlas && e.atlas.state === "in-atlas" && otherPages(e.atlas).length > 0 && (
                        <details class="wn-am"><summary>and {otherPages(e.atlas).length} more {otherPages(e.atlas).length === 1 ? "page" : "pages"}</summary>{otherPages(e.atlas).map((m) => <a href={m[1]} rel="noopener">{m[0].replace(":", " ")} ↗</a>)}</details>
                      )}
                    </div>}
                    {wired && (e.updated.pages.length > 0 || e.updated.logOnly) && (
                      <div class="wn-up"><span class="wn-upl">Updated</span>{e.updated.pages.length > 0
                        ? e.updated.pages.map((pg) => <a class="wn-pg" href={u(pg[0])} title={pg[1]}>{pg[1]}</a>)
                        : <span class="wn-lo" title="The finding is in the search log only; no page of the archive was changed">log only</span>}</div>
                    )}
                    {e.people.list.length > 0 && (
                      <div class="wn-for"><span class="wn-forl">{e.people.list.length === 1 ? "Found for 1 person" : `Found for ${e.people.list.length} people`}</span>
                        {e.people.list.slice(0, 5).map((pp) => <a class="wn-pg" href={u(pp[0])} title={pp[1]}>{pp[1]}</a>)}
                        {e.people.list.length > 5 && <details class="wn-am"><summary>and {e.people.list.length - 5} more</summary>{e.people.list.slice(5).map((pp) => <a class="wn-pg" href={u(pp[0])} title={pp[1]}>{pp[1]}</a>)}</details>}
                      </div>
                    )}
                    {e.people.nobody && <div class="wn-for"><span class="wn-forl" title="The pages were read and no new person came out of them">Read: no new person</span></div>}
                  </div>
                )}
              </div>
            );
            return (
              <details class="wn-grp" open={g.rows.length <= 12}>
                <summary><b>{g.name}</b><span class="wn-gs">{g.rows.length} {g.rows.length === 1 ? "entry" : "entries"}{g.found ? ` · ${g.found} found something` : ""}{g.nil ? ` · ${g.nil} nothing found` : ""}</span></summary>
                <div class="wn-rows">
                  {first.map(rowEl)}
                  {rest.length > 0 && <details class="wn-more"><summary>Show the other {rest.length}</summary>{rest.map(rowEl)}</details>}
                </div>
              </details>
            );
          })}
        </details>
      </li>
    )}
  </ul>
</li>
