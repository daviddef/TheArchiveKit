---
/* Families of one surname, each kept in its own lane until something joins them.

   THREE ARCHIVES DRAW THIS FIGURE AND ONE OF THEM WROTE IT TWICE. Defranceski
   draws five families arriving in Istria from five directions. Falco copied
   the grammar deliberately — its own comment says «the same visual grammar as
   the de Franceschi archive's strands figure, which David asked this one to
   match» — and Luwinski hand-rolled lanes with its own geometry for the same
   reason: households of a rare surname in one city that must NOT be merged
   until a document joins them.

   That is the argument the drawing exists to make, and all three make it: a
   rare name plus a shared address is the exact shape of the mistake, so each
   family gets a lane, what is documented goes on the lane, and what would
   have to be found to join it is written underneath. Nothing is merged and
   nothing is thrown away.

   The grammar, unchanged from Falco's: one band per strand, a spine of places
   in date order, a fan of destinations on the right, and a status line in
   small capitals saying how well the strand is documented. A DASHED fan line
   means «this goes nowhere this archive can follow» or «this is not this
   family» — the figure has to be able to draw a negative or it will only ever
   flatter.

     bands   [{ key, tint, title, status, read, href, spine, fan }]
             spine  [[place, year, why], …] left to right in date order
             fan    where the strand ends up, as [place, X, why] or
                    { place, dashed, why, href }. X is a DASHED FLAG in one
                    archive and an HREF in the other — see `fanOf`.
     title   the line in small capitals above the figure
     alt     the <title> a screen reader gets — say what the figure ARGUES,
             not that it is a diagram
     u       the archive's url helper

   ON A NARROW SCREEN THIS SCROLLS RATHER THAN SHRINKS. Fitting 1,180 units
   into a 375px phone scales every label to 29% and the figure is still there
   and says nothing. Below the breakpoint it keeps a legible minimum width and
   the reader swipes, which is what a drawing is for.
*/
const { bands = [], title = "", alt = "", u = (p) => p } = Astro.props;

/* A fan entry is [place, X, why] in both archives that draw this, and X means
   two different things. Falco's is a DASHED FLAG — "this goes nowhere we can
   follow". Luwinski's is an HREF — the page where that ending is set out.
   Reading one as the other would have turned every Luwinski destination into
   a dashed negative, which is the opposite of what its data says, and the
   figure would have looked entirely plausible while lying about all of them.
   So the shape is normalised once, here, and a string that starts with "/"
   is a link rather than a flag. An object form says which is meant. */
const fanOf = (f) => {
  if (!Array.isArray(f)) return { place: f.place, dashed: !!f.dashed, why: f.why, href: f.href };
  const [place, x, why] = f;
  const href = typeof x === "string" && x.startsWith("/") ? x : null;
  return { place, dashed: !href && !!x, why, href };
};
const BANDS = bands.map((b) => ({ ...b, fan: (b.fan || []).map(fanOf) }));
const W = 1180;
const BAND_H = 176, BAND_GAP = 14, PAD_T = 46;
const SX0 = 232, SX1 = 748;                 /* the spine reach */
const FAN_X = 952, LAB_X = 968;
const bandY = (i) => PAD_T + i * (BAND_H + BAND_GAP);
const H = PAD_T + BANDS.length * (BAND_H + BAND_GAP) + 8;
const nodeX = (i, n) => (n === 1 ? SX0 : SX0 + i * ((SX1 - SX0) / (n - 1)));
const fanY = (j, n, y) => (n === 1 ? y : y - 22 + j * (44 / (n - 1)));
---
<figure class="strands">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="strandsttl">
    <title id="strandsttl">{alt}</title>

    {title && <text x="12" y="24" class="s-band-ttl" fill="var(--ink-2)">{title}</text>}

    {BANDS.map((b, bi) => {
      const y0 = bandY(bi), sy = y0 + 104, n = b.spine.length;
      return (
        <g class="s-band">
          <rect x="8" y={y0} width={W - 16} height={BAND_H} rx="10"
                fill={b.tint} opacity="0.055" />
          <text x="32" y={y0 + 30} class="s-ttl" fill={b.tint}>{b.title}</text>
          <text x="32" y={y0 + 50} class="s-status" fill="var(--ink-3)">{b.status}</text>
          <a href={u(b.href)}>
            <text x="32" y={y0 + BAND_H - 18} class="s-read" fill={b.tint}>{b.read}</text>
          </a>

          <line x1={nodeX(0, n)} y1={sy} x2={nodeX(n - 1, n)} y2={sy}
                stroke={b.tint} stroke-width="3" opacity="0.75" />

          {b.spine.map((s, i) => (
            <g class="node" tabindex="0" role="button"
               data-place={s[0]} data-year={s[1]} data-lane={b.title} data-why={s[2]}>
              <title>{s[0]} — {s[1]}</title>
              <text x={nodeX(i, n)} y={sy - 26} class="s-place">{s[0]}</text>
              <circle cx={nodeX(i, n)} cy={sy} r="9" fill="var(--panel)" stroke={b.tint} stroke-width="3" />
              <circle cx={nodeX(i, n)} cy={sy} r="3.2" fill={b.tint} />
              <text x={nodeX(i, n)} y={sy + 30} class="s-year" fill={b.tint}>{s[1]}</text>
            </g>
          ))}

          {b.fan.map((f, j) => {
            const ty = fanY(j, b.fan.length, sy);
            const lab = <text x={LAB_X} y={ty + 4} class={f.dashed ? "s-dest s-dim" : "s-dest"}>{f.place}</text>;
            return (
              <g class="node" tabindex="0" role="button"
                 data-place={f.place} data-year="" data-lane={b.title} data-why={f.why}>
                <title>{f.place}</title>
                <path d={`M ${nodeX(n - 1, n) + 9} ${sy} C ${nodeX(n - 1, n) + 110} ${sy}, ${FAN_X - 90} ${ty}, ${FAN_X} ${ty}`}
                      fill="none" stroke={b.tint} stroke-width="2.2"
                      opacity={f.dashed ? 0.5 : 0.85}
                      stroke-dasharray={f.dashed ? "7 6" : "0"} />
                <circle cx={FAN_X} cy={ty} r="4" fill={f.dashed ? "var(--panel)" : b.tint}
                        stroke={b.tint} stroke-width="2" />
                {f.href ? <a href={u(f.href)}>{lab}</a> : lab}
              </g>
            );
          })}
        </g>
      );
    })}
  </svg>
</figure>
<p class="s-hint">Swipe the figure sideways to follow each strand to its end.</p>

<style>
  .strands { margin: 1.4rem 0 1.2rem; }
  .strands svg { width: 100%; height: auto; display: block; }
  .s-band-ttl { font: 500 11px/1.2 var(--mono);
                letter-spacing: .14em; text-transform: uppercase; }
  .s-ttl    { font: 600 17px/1.2 var(--serif); }
  .s-status { font: 400 10.5px/1.2 var(--mono);
              letter-spacing: .13em; }
  .s-read   { font: 500 13px/1.2 var(--sans); }
  .s-read:hover { text-decoration: underline; }
  .s-place  { font: 600 15px/1.2 var(--sans);
              fill: var(--ink); text-anchor: middle; }
  .s-year   { font: 400 12.5px/1.2 var(--mono); text-anchor: middle; }
  .s-dest   { font: 400 14.5px/1.2 var(--sans); fill: var(--ink); }
  .s-dim    { fill: var(--ink-3); font-style: italic; }
  .node     { cursor: help; }
  .node:focus-visible circle { outline: 2px solid var(--accent); outline-offset: 3px; }
  /* the base rule must precede the media query, or source order wins and the
     hint never appears — which is how it shipped for one build. */
  .s-hint { display: none; font: 400 12px/1.4 var(--sans); color: var(--ink-3);
            margin: .3rem 0 0; }
  /* ON A NARROW SCREEN THIS FIGURE SCROLLS RATHER THAN SHRINKS.
     Letting a 1180-unit SVG fit a 375px phone scales it to 29% and every label
     in it becomes unreadable — the figure is still «there» and says nothing.
     So below the breakpoint it keeps a legible minimum width and the reader
     swipes it, which is what the drawing is for. */
  @media (max-width: 860px) {
    .strands { overflow-x: auto; -webkit-overflow-scrolling: touch;
               scrollbar-width: thin; padding-bottom: .4rem; }
    .strands svg { min-width: 860px; }
    .s-hint { display: block; }
  }

</style>
