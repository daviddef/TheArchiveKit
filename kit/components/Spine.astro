---
/* The direct line, generation by generation.
 *
 * The page every archive tells its own story on, so the PROSE stays where it
 * is. What is shared is the chain: a numbered generation, the couple, what is
 * known of their dates and places, and — the thing that makes this an archive
 * rather than a pedigree — A MARK ON THE JOINT THAT CANNOT BEAR WEIGHT.
 *
 * Falco stops at generation one and says so; Blazevic marks generation three as
 * the joint the tree asserts and the records do not. Both were drawing that by
 * hand in their own way. A spine without it is a claim; with it, it is
 * evidence with a gap named in the middle.
 *
 * LIVING PEOPLE GET A NAME AND A RELATIONSHIP, NOTHING ELSE — and this
 * component now enforces that rather than trusting eight archives to. The
 * facts paragraph was already gated; the note, the household, the sources
 * and the plates were not, and Falco's generation nine is living and
 * carried «Born at Benevento; her twin daughters were born at Brisbane in
 * 1988» straight onto /direct-line/, together with a date of birth, a
 * birthplace and a marriage date the compact row printed too.
 *
 * The data is still wrong and Falco's own session should cut it. But a rule
 * that depends on every archive remembering it is not a rule, so the row
 * that draws a living person now draws the name, the spouse and the words
 * "living — named only", whatever the row underneath it holds.
 *
 * A HOUSEHOLD IS NOT A LIST OF FACTS ABOUT ONE MAN. Defranceschi's spine is
 * built on two rows of a Status Animarum, and a book of souls registers
 * households: a man, his wife, and every child with a date under him. Rendering
 * only the man would have thrown away the argument the page is making. So a row
 * may carry its house, its Latin form, its trade, the sources under it, and -
 * through the optional `Plate` component - the pages of register that prove it.
 *
 * `Plate` is passed as a component rather than markup because an archive's
 * plate renderer is its own; the spine only says where in the row it goes.
 *
 *   rows  [{gen, name, latin, spouse, href, born, bornPlace, died, diedPlace,
 *           trade, living, weak, weakNote, note, confidence, married, via,
 *           household: {label, members: [{name, dates, line, note}]},
 *           sources: [{label}], plates: [id]}]
 *   Plate  optional component rendered as <Plate ids={row.plates} />
 *
 *   `via` — how the line passes INTO this generation when that is not
 *   obvious from the surname. Mazza's eight Prostamos sit above one Mazza
 *   because generation two is a daughter; the ladder said nothing and read
 *   as a fault. Drawn as a band between the two rows it joins, compact only.
 *   `married` — the marriage, when the archive holds the date.
 *   Place is read from bornPlace/birthPlace/diedPlace/deathPlace/place,
 *   because the estate spells it three ways and no archive should have to
 *   rename a column to be drawn.
 */
/* `idPrefix` exists because a PAGE MAY HOLD SEVERAL SPINES. /argentina/ draws four
   lines of descent and /uruguay/ three, and every one of them emitted id="gen-1",
   so a document carried the same id four times - invalid, and an anchor to it
   resolves to whichever came first. Defaults to the old value, so no archive that
   does not pass it sees any change. */
const {
  rows = [], u = (p) => p, label = "Generation", Plate, idPrefix = "gen-",
  /* COMPACT: the same line, one row deep, for a homepage.
     Three of eight archives showed their line on the front page and five
     showed none — raised by David on 22 September, and the cause was not a
     missing component but a missing SIZE of one. Blazevic, Lerena and
     Luwinski had each hand-built a short ladder; the other five linked to
     the full spine and drew nothing.

     `href` IS DELIBERATELY IGNORED HERE and every row links to its own
     generation anchor on the full spine instead. A person link is not safe
     on a spine: five of the estate's seven carry a repeating forename, and
     Falco has two Raffaele Falco — generations four and six, grandfather and
     grandson — who slug identically. POSITION IN A LINE IS UNIQUE BY
     CONSTRUCTION AND A NAME IS NOT, so the anchor is the only link that
     cannot quietly merge two men. `full` is where the anchors live. */
  compact = false,
  full = "/direct-line/",
} = Astro.props;
// A homepage ladder shows a YEAR, not a paragraph. Falco's `born` reads
// "about 1747 — «annorum 55 circiter» at his death", which is the right
// thing to keep and the wrong thing to print in a 6rem column.
const yr = (v) => {
  const t = String(v ?? "");
  const m = t.match(/\b(1[0-9]{3}|20[0-9]{2})\b/);
  if (!m) return "";
  // A QUALIFIER IS NOT DECORATION. "bef. 1900" printed as "1900" states a
  // date the archive has not got, which is the one thing a ladder of
  // evidence must never do.
  const q = /\bbef(ore)?\b|\bante\b/i.test(t) ? "bef. "
          : /\baft(er)?\b|\bpost\b/i.test(t) ? "aft. "
          : /\babout\b|\bc\.|\bcirca\b|circiter/i.test(t) ? "c." : "";
  return q + m[1];
};
// The same cut the place pill takes: everything up to the dash that
// introduces a gloss, then a length cap.
const clip = (v, n = 34) => {
  const c = String(v ?? "").split(/\s+[\u2013\u2014-]\s+/)[0].trim();
  return c.length > n ? c.slice(0, n - 2).replace(/[\s,(]+$/, "") + "\u2026" : c;
};
// A LONE YEAR MUST SAY WHICH YEAR IT IS. Defranceski's generation seven
// has a death in 2026 and no birth — his widow is living and the dates are
// withheld — so the row read "2026" and any reader takes a single year on
// a pedigree for a birth.
const years = (g) => {
  const b = yr(g.born), d = yr(g.died);
  if (b && d) return b + " \u2013 " + d;
  if (b) return "b. " + b;
  if (d) return "d. " + d;
  return "?";
};
const place = (g) => {
  // A PILL IS A PLACE, NOT A CLAUSE AND NOT A POSTAL HIERARCHY. Two faults
  // showed up the moment real data went through it:
  //   Falco g3   "Arienzo \u2014 baptised in the Collegiate Church of
  //              Sant'Andrea Apostolo" — a gloss after a dash.
  //   D'Arcy g5  "Brisbane, Brisbane, Queensland, Australia" — the town
  //              twice and then the country, four levels deep.
  // So: cut the gloss, drop a repeated level, drop the "Of," D'Arcy's tree
  // prefixes seats with, then keep whole comma levels while they fit. The
  // levels that fall off the end are the general ones, which is the right
  // way round — "Darcy Meynill, Yorkshire" says more than "Yorkshire,
  // England" and, in that row, does not repeat a Cattaraugus County that
  // has no business in Yorkshire anyway.
  const raw = String(g.bornPlace || g.birthPlace || g.diedPlace || g.deathPlace || g.place || "");
  const parts = [];
  for (const seg of raw.split(/\s+[\u2013\u2014-]\s+/)[0].split(",")) {
    const t = seg.trim();
    if (!t || /^of$/i.test(t)) continue;
    if (parts.length && parts[parts.length - 1].toLowerCase() === t.toLowerCase()) continue;
    parts.push(t);
  }
  let out = "";
  for (const t of parts) {
    const next = out ? out + ", " + t : t;
    if (next.length > 30) break;
    out = next;
  }
  return out || clip(parts[0] || "", 30);
};
// D'ARCY MARKS NINE OF FIFTEEN JOINTS UNPROVEN, and a badge repeated down
// two thirds of a column tells the reader nothing — it reads as a rendering
// fault, which is exactly what was reported. Past a third of the rows the
// per-row label is dropped for one sentence underneath; the left rule stays,
// so nothing is hidden, it is just said once.
// Folding nine repeated badges into one sentence must not fold away a
// grade that says something else. D'Arcy's generation nine is "disputed" —
// the archive has looked and rejected it — which is not the same claim as
// the eight around it that were simply never judged.
const generic = (c) => /^(unproven|not proved|unknown|unjudged|inferred)$/i.test(String(c).trim());
const weakCount = rows.filter((r) => r.weak).length;
const weakIsNoise = rows.length >= 6 && weakCount > rows.length / 3;

// ONE MARKER PER ROW. Defranceski's generation one is graded "family" —
// this archive's word for a generation carried on the family's own descent
// chart and named by no register — and the row drew that pill AND a "joint
// unproven" badge beside it, which is the same statement twice in two
// vocabularies. The archive's own word wins where it has one; "joint
// unproven" is the fallback for a weak row graded only in the generic
// terms, and it disappears entirely into the footnote when the ratio makes
// it noise.
const grade = (g) => {
  if (g.living) return "";
  const c = String(g.confidence || "").trim();
  if (g.weak) {
    if (c && !generic(c)) return c;
    return weakIsNoise ? "" : "joint unproven";
  }
  return c;
};

const esc = (s) => String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;");
---
{compact ? (
  <div class="sp-cwrap">
  <ol class="sp-c">
    {rows.map((g) => {
      // A LIVING PERSON GETS A NAME AND A RELATIONSHIP, NOTHING ELSE. Falco's
      // generation nine is living, and the first draft of this row printed
      // her birthplace, her marriage date and an evidence grade beside it.
      // The full row below has always known this; the compact one did not,
      // and a rule kept in one branch of a component is not kept.
      const kids = g.living ? [] : (g.household && g.household.members) || [];
      const meta = g.living ? [] : [
        g.trade ? ["trade", g.trade] : null,
        g.married ? ["married", clip(g.married)] : null,
      ].filter(Boolean);
      return (<>
      {g.via ? <li class="sp-cvia"><span>{g.via}</span></li> : null}
      <li class={"sp-cg" + (g.weak ? " sp-cweak" : "")}>
        <span class="sp-cn mono">{(label[0] || "g").toLowerCase()}{g.gen}</span>
        <span class="sp-cnames">
          <a class="sp-cl" href={u(`${full}#${idPrefix}${g.gen}`)}>{g.name}</a>
          {g.spouse ? <span class="sp-csp"><span class="sp-cx">&#215;</span>{g.spouse}</span> : null}
        </span>
        {g.living
          ? <span class="sp-cy">living &#8212; named only</span>
          : <span class="sp-cy">{years(g)}</span>}
        <span class="sp-cpills">
          {!g.living && place(g) ? <span class="sp-pill sp-place">{place(g)}</span> : null}
          {grade(g) ? <span class={"sp-pill sp-conf sp-" + grade(g).toLowerCase().replace(/[^a-z]+/g, "-")}>{grade(g)}</span> : null}
        </span>
        {(meta.length || kids.length) ? (
          <span class="sp-cmeta">
            {meta.map(([k, v]) => <span class="sp-cm"><i>{k}</i>{v}</span>)}
            {kids.length ? (
              <span class="sp-ckids">
                {/* The full row has always drawn `household.label` and
                    fallen back to "In the house"; the compact row ignored
                    it and hard-coded "children". A book of souls registers
                    a household, not always a nursery, and an archive that
                    has named its own group should not be overruled by the
                    smaller of two renderings of the same row. */}
                <i>{(g.household && g.household.label)
                    || `${kids.length} ${kids.length === 1 ? "child" : "children"}`}</i>
                {kids.slice(0, 8).map((m) => (
                  <span class={"sp-ckid" + (m.line ? " sp-cline" : "")}
                        title={m.note || m.dates || undefined}>{m.name}</span>
                ))}
                {kids.length > 8 ? <span class="sp-ckid sp-cmore">+{kids.length - 8}</span> : null}
              </span>
            ) : null}
          </span>
        ) : null}
      </li>
      </>);})}
  </ol>
  {weakIsNoise ? (
    <p class="sp-cfoot">{weakCount} of these {rows.length} joints are asserted by the tree and not
      proved by a record. They carry a rule down the left.</p>
  ) : null}
  </div>
) : (
<ol class="sp">
  {rows.map((g) => (
    <li class={"sp-g" + (g.weak ? " sp-weak" : "")} id={idPrefix + g.gen}>
      <div class="sp-n"><span class="mono">{label} {g.gen}</span></div>
      <div class="sp-b">
        <h3 class="sp-h">
          {g.href ? <a href={u(g.href)}>{g.name}</a> : g.name}
          {g.spouse ? <span class="sp-sp"> and {g.spouse}</span> : null}
        </h3>
        {g.latin ? <p class="sp-lat">{g.latin}</p> : null}
        {g.living ? (
          <p class="sp-f"><span class="chip doc">living — named only</span></p>
        ) : (
          <p class="sp-f">
            {g.born ? <><span class="sp-k">born</span>{g.born}{g.bornPlace ? ", " + g.bornPlace : ""}</> : null}
            {g.died ? <><span class="sp-k">died</span>{g.died}{g.diedPlace ? ", " + g.diedPlace : ""}</> : null}
            {g.trade ? <><span class="sp-k">trade</span>{g.trade}</> : null}
            {g.confidence ? <span class="chip">{g.confidence}</span> : null}
          </p>
        )}
        {g.weak ? (
          <p class="sp-w"><strong>The joint here will not bear weight.</strong>{" "}
            {g.weakNote ? <Fragment set:html={g.weakNote} /> : "The tree asserts it and no record names the father."}</p>
        ) : null}
        {!g.living && g.household && (g.household.members || []).length ? (
          <div class="sp-house">
            <p class="sp-hl">{g.household.label || "In the house"}</p>
            <p class="sp-kids">
              {g.household.members.map((m) => (
                <span class={"sp-kid" + (m.line ? " sp-line" : "")} title={m.note || undefined}>
                  {m.name}{m.dates ? <i>{m.dates}</i> : null}</span>
              ))}
            </p>
          </div>
        ) : null}
        {!g.living && g.note ? <p class="sp-note" set:html={g.note} /> : null}
        {!g.living && (g.sources || []).length ? (
          <p class="sp-src mono">{g.sources.map((x, i) => <>{i > 0 ? " \u00b7 " : ""}{x.label ?? x}</>)}</p>
        ) : null}
        {!g.living && Plate && (g.plates || []).length ? (
          <div class="sp-plates"><Plate ids={g.plates} cols={g.plates.length} /></div>
        ) : null}
      </div>
    </li>
  ))}
</ol>
)}

<style is:global>
  /* Compact: one generation per line, for a front page. Deliberately not a
     shrunken copy of the full row — a homepage ladder answers "how far back,
     and where" and nothing else. */
  .sp-c { list-style: none; margin: 1.1rem 0 0; padding: 0; }
  .sp-cg {
    display: grid; gap: .15rem .9rem; align-items: baseline;
    grid-template-columns: 2.2rem minmax(0, 1fr) auto auto;
    grid-template-areas: "n names years pills" ". meta meta meta";
    padding: .5rem 0; border-top: 1px solid var(--rule);
  }
  .sp-c li:first-child { border-top: 0; }
  .sp-cn { grid-area: n; font-size: 11.5px; color: var(--ink-3); }
  .sp-cnames { grid-area: names; overflow-wrap: anywhere; }
  .sp-cl { font-family: var(--serif); font-size: 1.04rem; }
  .sp-csp { font-family: var(--serif); font-size: 1.04rem; color: var(--ink-2); }
  .sp-cx { color: var(--ink-3); margin: 0 .35rem; font-size: .85em; }
  .sp-cy { grid-area: years; font-family: var(--mono); font-size: 12.5px; color: var(--ink-2); white-space: nowrap; }
  .sp-cpills { grid-area: pills; display: flex; gap: .3rem; flex-wrap: wrap; justify-content: flex-end; }
  .sp-pill {
    font-family: var(--sans); font-size: 9.5px; letter-spacing: .09em; text-transform: uppercase;
    border: 1px solid var(--rule); padding: .1rem .4rem; white-space: nowrap; color: var(--ink-3);
  }
  .sp-place { color: var(--ink-2); }
  .sp-documented { border-color: var(--rule-strong); color: var(--ink-1); }
  .sp-inferred, .sp-probable { border-style: dashed; }
  .sp-joint-unproven, .sp-unproven, .sp-not-proved, .sp-disputed, .sp-family {
    border-color: var(--ochre); color: var(--ochre);
  }
  .sp-cmeta { grid-area: meta; display: flex; flex-wrap: wrap; gap: .2rem .8rem; align-items: baseline; margin-top: .1rem; }
  .sp-cm, .sp-ckids { font-size: 12.5px; color: var(--ink-2); display: flex; flex-wrap: wrap; gap: .3rem; align-items: baseline; }
  .sp-cm i, .sp-ckids i {
    font-style: normal; font-family: var(--sans); font-size: 9.5px; letter-spacing: .09em;
    text-transform: uppercase; color: var(--ink-3);
  }
  .sp-ckid { font-size: 12px; border: 1px solid var(--rule); padding: .02rem .35rem; }
  .sp-cline { border-color: var(--accent); font-weight: 600; }
  .sp-cmore { color: var(--ink-3); border-style: dashed; }
  /* MAZZA'S LADDER CHANGES SURNAME AT GENERATION TWO and said nothing about
     it, so eight Prostamos above one Mazza read as a rendering fault. The
     line really does pass through a daughter there. `via` is the one line
     that says so, and it belongs between the two rows it joins. */
  .sp-cvia {
    display: block; padding: .35rem 0 .35rem 2.2rem; border-top: 1px solid var(--rule);
  }
  .sp-cvia span {
    font-family: var(--sans); font-size: 10.5px; letter-spacing: .06em;
    text-transform: uppercase; color: var(--ink-3);
  }
  .sp-cweak { border-left: 2px solid var(--ochre); padding-left: .6rem; }
  .sp-cfoot { margin: .7rem 0 0; font-size: 12.5px; color: var(--ink-3); border-top: 1px solid var(--rule); padding-top: .6rem; }
  @media (max-width: 680px) {
    .sp-cg {
      grid-template-columns: 2.2rem 1fr;
      grid-template-areas: "n names" ". years" ". pills" ". meta";
    }
    .sp-cpills { justify-content: flex-start; }
  }
  .sp { list-style:none; margin:1.2rem 0; padding:0; }
  .sp-g { display:grid; grid-template-columns:7.5rem 1fr; gap:0 1.2rem;
    border-left:2px solid var(--rule,#ddd); padding:0 0 1.3rem 1.2rem; margin-left:.4rem;
    position:relative; }
  .sp-g::before { content:""; position:absolute; left:-5px; top:.45rem; width:8px; height:8px;
    border-radius:50%; background:var(--rule-strong,#bbb); }
  .sp-weak { border-left-style:dashed; border-left-color:var(--terra,#c55); }
  .sp-weak::before { background:var(--terra,#c55); }
  .sp-n .mono { font-size:9.5px; font-weight:600; letter-spacing:.11em; text-transform:uppercase;
    color:var(--ink-3,#888); }
  .sp-h { margin:0 0 .25rem; font-size:1.05rem; }
  .sp-sp { font-weight:400; color:var(--ink-2,inherit); }
  .sp-k { display:inline-block; min-width:3rem; font-size:9.5px; font-weight:600;
    letter-spacing:.11em; text-transform:uppercase; color:var(--ink-3,#888); margin-right:.15rem; }
  .sp-f { margin:.1rem 0; display:flex; flex-wrap:wrap; gap:.15rem .8rem; align-items:baseline; }
  .sp-lat { margin:0 0 .25rem; font-style:italic; color:var(--ink-3,#888); font-size:.9rem; }
  .sp-house { margin:.6rem 0 0; padding:.55rem .7rem; border:1px solid var(--rule,#ddd);
    border-radius:3px; }
  .sp-hl { margin:0 0 .35rem; font-size:9.5px; font-weight:600; letter-spacing:.11em;
    text-transform:uppercase; color:var(--ink-3,#888); }
  .sp-kids { margin:0; display:flex; flex-wrap:wrap; gap:.3rem .5rem; }
  .sp-kid { font-size:.88rem; border:1px solid var(--rule,#ddd); border-radius:2px;
    padding:.12rem .45rem; }
  .sp-kid i { color:var(--ink-3,#888); font-size:.8em; margin-left:.35rem; font-style:normal; }
  .sp-line { border-color:var(--accent,#963); font-weight:600; }
  .sp-src { margin:.4rem 0 0; font-size:.8rem; color:var(--ink-3,#888); }
  .sp-plates { margin:.7rem 0 0; max-width:700px; }
  .sp-w { margin:.4rem 0 0; color:var(--terra,#c55); }
  .sp-note { margin:.35rem 0 0; color:var(--ink-2,inherit); }
  @media (max-width:560px) { .sp-g { grid-template-columns:1fr; gap:.15rem 0; } }
</style>
