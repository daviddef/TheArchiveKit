---
/* The Atlas — every place an archive can put a person in.

   Written for one archive and, like the ancestor chart before it, trapped
   there: 288 lines of page no other archive could reach. What made it
   archive-specific was never the map. It was six category names, a bounding
   box round the Adriatic, and three overlays only one family has.

     places     served as JSON at `dataUrl`, each:
                { name, lat, lon, cat, n, what, when, href, also,
                  people:[{n,y,d,w}], more, films:[{t,ark,cc,wc}], nfilms,
                  order }   — `order` marks the documented descent, in sequence
     cats       [[key, label, colour]] — the filter buttons AND the marker colours
     bounds     [[south, west], [north, east]] — where the map opens
     overlays   [[key, label, colour, onByDefault]] for spine / moves / areas.
                An archive with no arrows of its own passes none and the row
                is not drawn.
     schemes    [[key, label, note]] — LAYERS, NOT VIEWS. An archive that asks
                more than one question of the same ground passes them here, and
                each place then carries `cats: {scheme: cat}` and optionally
                `ns: {scheme: n}` instead of a single `cat`. A switch appears
                above the map and the markers recolour; THE PANEL NEVER
                SWITCHES, because a place that is a parish, a home and a grave
                says all three things at once and that is the whole reason for
                putting them on one map.

                A place answering two live schemes takes the colour of the
                RAREST one it answers, counted off the data rather than
                declared: sixty-one graves against 1,235 parishes means the
                burial is the thing worth seeing and the shelf is the ground it
                sits on. Passing no schemes keeps the old single `cat` and
                nothing changes.

   WHY THIS IS HERE AND NOT IN A PAGE. Defranceschi built it first, as 1,220
   lines that watched this component's DOM with a MutationObserver and re-
   tagged the markers after every click, because that session does not own the
   kit and said so in its own comment. Four archives hold the data for a second
   layer - D'Arcy 89 graves and 56 coverage rows, Blazevic 72 and 70, Falco 87,
   Mazza 10 - and not one of them could show it. A capability reachable only by
   patching another component from outside is a capability the estate does not
   have.

   The data is fetched rather than inlined: an atlas of any size is more than
   a page should carry, and the map cannot draw before Leaflet loads anyway.

   Markers are sized by how many people stand in a place, which is the one
   piece of editorial in here and worth saying out loud: weight on this map is
   not kinship. A parish can hold forty people of the surname and be connected
   to the family by nothing whatever. */
const {
  cats = [],
  schemes = [],
  bounds = [[-60, -180], [75, 180]],
  homeLabel = "Back to the home view",
  dataUrl,
  overlays = [],
  hint,
  placeholder = "Find a place",
} = Astro.props;
const COLORS = Object.fromEntries(cats.map(([k, , c]) => [k, c]));
const base = import.meta.env.BASE_URL || "/";
---
  <div class="at-wrap">
    <div class="at-map" id="atlas"></div>
    <aside class="at-panel" id="at-panel">
      <div class="at-empty" id="at-empty">
        <div class="lab">Pick a place</div>
        <p>Click any marker. Bigger markers hold more people.</p>
        {hint && <p class="at-hint">{hint}</p>}
      </div>
      <div class="at-body" id="at-body" hidden></div>
    </aside>
  </div>

  <div class="at-tools">
    <label class="at-find">
      <span class="lab">Find a place</span>
      <input id="at-q" type="search" placeholder={placeholder} autocomplete="off" />
    </label>
    {schemes.length > 1 && (
      <div class="at-schemes">
        <span class="lab">Layers &mdash; switch any of them on or off</span>
        <div class="atlas-key">
          {schemes.map(([k, label, note]) => (
            <button class="at-cat at-sch on" data-scheme={k} title={note}>{label}</button>
          ))}
        </div>
      </div>
    )}
    <div class="atlas-key">
      {cats.map(([k, label, c]) => (
        <button class="at-cat on" data-cat={k}><i style={`background:${c}`}></i>{label}</button>
      ))}
    </div>
    {overlays.length > 0 && (
      <div class="atlas-key at-over">
        {overlays.map(([k, label, c, on = true]) => (
          <button class={`at-cat${on ? " on" : ""}`} data-over={k}><i style={`background:${c}`}></i>{label}</button>
        ))}
      </div>
    )}
<p class="cap" id="at-count"></p>
<slot />

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js" defer></script>
<script is:inline define:vars={{ BASE: base, DATA: dataUrl, COLORS, BOUNDS: bounds, HOME: homeLabel, SCHEMES: schemes }}>
  window.addEventListener("load", async function () {
    var el = document.getElementById("atlas");
    if (!el || typeof L === "undefined") return;
    var base = BASE.replace(/\/$/, "");
    var d;
    try { d = await (await fetch(DATA)).json(); } catch (e) { return; }

    /* ---- THE VIEW IS IN THE ADDRESS BAR ----------------------------------
       A map whose state is private is a map you cannot point at. Which layers
       are on, what is typed in the find box, which colours are switched off,
       where the map is looking and which place is open: all of it goes in the
       URL, so «the burials only, around Cradock, with Coetzee open» is a link
       somebody can send to a cousin or an archivist.

       THE KEY NAMES ARE NOT NEW. Two maps in this estate invented this
       independently - the Defranceschi map in a page-local component and the
       Record Atlas in its own - and they chose the same names: q, off, layers,
       view, at, base. This takes those, so a reader who learns one of these
       URLs has learned all of them, and so the two that already have it can
       drop their copy without changing a single link anybody has saved.

       The write is coalesced per frame rather than on a timer, which is the
       Record Atlas's implementation and the better one: dragging a map fires
       moveend far faster than a 250ms debounce settles. replaceState, never
       pushState, so panning does not fill the back button. */
    var settled = false;
    var Q; try { Q = new URLSearchParams(location.search); } catch (e) { Q = new URLSearchParams(); }
    var writing = false;
    function push() {
      if (writing) return;
      writing = true;
      requestAnimationFrame(function () {
        writing = false;
        var str = Q.toString();
        try {
          history.replaceState(null, "", location.pathname + (str ? "?" + str : "") + location.hash);
        } catch (e) {}
      });
    }
    function setQ(k, v) {
      if (v === "" || v === null || v === undefined) Q.delete(k); else Q.set(k, String(v));
      push();
    }
    /* A place needs a stable handle to be named in a URL. Every archive's rows
       carry a name; some carry a slug, which survives a rename and is
       preferred where it is there. */
    function keyOf(p) { return p.slug || p.name; }

    var map = L.map(el, { scrollWheelZoom: true, worldCopyJump: true });
    /* ---- THE GROUND UNDER THE MARKERS -----------------------------------
       Four basemaps, because the question changes what you need under the
       dots. Street to find a village. Terrain to see why a family crossed one
       pass and not another. Satellite to find a farm that is still there.
       Plain to read a dense cluster of markers without a map arguing with it.

       THE KEYS ARE THE ONES ALREADY IN USE. The Defranceschi map and the
       Record Atlas each built this separately; they agree on `terrain` and
       `satellite`, and differ only in what they call the default - street
       against map. Neither ever writes its default to the URL, so there is no
       such link in the world to break: the canonical key is `street`, and
       `map` is accepted on the way in so that the Record Atlas's own links
       keep working when it comes onto this component.

       The reader's choice is remembered per browser, and the URL beats the
       memory, because a link somebody sent is a stronger statement about what
       to show than what this reader happened to pick last week. */
    var BASES = [
      ["street", "Street", "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
       "&copy; OpenStreetMap contributors", 18],
      ["terrain", "Terrain", "https://tile.opentopomap.org/{z}/{x}/{y}.png",
       "&copy; OpenStreetMap contributors, SRTM \u00b7 OpenTopoMap (CC-BY-SA)", 17],
      ["satellite", "Satellite",
       "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
       "Esri, Maxar, Earthstar Geographics", 18],
      ["plain", "Plain", "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
       "&copy; OpenStreetMap contributors \u00b7 &copy; CARTO", 19]
    ];
    var ALIAS = { map: "street" };
    var BKEY = "atlas:base";
    var tiles = {};
    BASES.forEach(function (b) {
      tiles[b[0]] = L.tileLayer(b[2], { attribution: b[3], maxZoom: b[4] });
    });
    var baseNow = (function () {
      var want = Q.get("base");
      if (!want) { try { want = localStorage.getItem(BKEY); } catch (e) {} }
      want = ALIAS[want] || want;
      return tiles[want] ? want : "street";
    })();
    tiles[baseNow].addTo(map);

    var esc = function (x) { return String(x == null ? "" : x)
      .replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"); };
    var panel = document.getElementById("at-body");
    var empty = document.getElementById("at-empty");

    function show(p) {
      var h = [];
      h.push('<div class="at-h"><h3>' + esc(p.name) + "</h3>");
      if (p.n) h.push('<span class="at-n">' + p.n + (p.n === 1 ? " person" : " people") + "</span>");
      h.push("</div>");
      if (p.also && p.also.length)
        h.push('<p class="at-also">also written ' + p.also.map(function (x) {
          return "<em>" + esc(x) + "</em>"; }).join(" · ") + "</p>");
      if (p.when || p.what)
        h.push('<p class="at-what">' + (p.when ? "<b>" + esc(p.when) + "</b> — " : "") + esc(p.what) + "</p>");
      /* Dated events, where an archive keeps them per place. Booyzen does, and
         they are the best thing on its atlas: a place stops being a dot and
         becomes a list of things that happened there, in order. */
      if (p.events && p.events.length) {
        h.push('<div class="at-sec"><div class="lab">What happened here</div><ul class="at-ev">');
        p.events.forEach(function (e) {
          var when = Array.isArray(e) ? e[0] : e.when, what = Array.isArray(e) ? e[1] : e.what;
          h.push('<li><span class="at-ed">' + esc(when) + "</span>" + esc(what) + "</li>");
        });
        h.push("</ul></div>");
      }

      if (p.href)
        h.push('<p class="at-go"><a href="' + base + esc(p.href) + '">The page that proves it &rarr;</a></p>');

      if (p.nfilms) {
        h.push('<div class="at-sec"><div class="lab">The registers, open at page one</div>');
        h.push('<p class="at-sub">' + p.nfilms + " volume" + (p.nfilms === 1 ? "" : "s") +
               " photographed for this parish. None of it is name-indexed.</p><ul class=\"at-films\">");
        p.films.forEach(function (f) {
          /* The waypoint puts the reader on the right page of the right book.
             Not every archive records one — a bare ark still resolves, and
             appending "?cc=&wc=" to it would be worse than leaving it off. */
          var q = f.cc ? "?cc=" + esc(f.cc) + (f.wc ? "&wc=" + encodeURIComponent(f.wc) : "") : "";
          h.push('<li><a href="https://www.familysearch.org/ark:/61903/' + esc(f.ark) + q +
                 '" target="_blank" rel="noopener">' + esc(f.t) + " &#8599;</a></li>");
        });
        h.push("</ul></div>");
      }

      /* Indexed entries are not register volumes and must not be dressed as
         them. A film is a book you can turn the pages of; one of these is a
         single line somebody typed out of a book, about one person. The
         archives hold far more of the second kind than the first, and saying
         so is the difference between an atlas and a catalogue. */
      if (p.records && p.records.length) {
        h.push('<div class="at-sec"><div class="lab">Records read about the people here</div>');
        h.push('<p class="at-sub">' + (p.nrecords || p.records.length) +
               " indexed entr" + ((p.nrecords || p.records.length) === 1 ? "y" : "ies") +
               ", each naming one person rather than a volume to browse.</p><ul class=\"at-films\">");
        p.records.forEach(function (f) {
          h.push('<li><a href="https://www.familysearch.org/ark:/61903/' + esc(f.ark) +
                 '" target="_blank" rel="noopener">' + esc(f.t) + " &#8599;</a></li>");
        });
        h.push("</ul>");
        if (p.moreRecords)
          h.push('<p class="at-sub">and ' + p.moreRecords + " more.</p>");
        h.push("</div>");
      }

      if (p.people && p.people.length) {
        h.push('<div class="at-sec"><div class="lab">Who the archive puts here</div><ul class="at-ppl">');
        p.people.forEach(function (q) {
          var yr = q.y ? (q.y + (q.d ? "–" + q.d : "")) : "";
          var nm = esc(q.n) + (yr ? ' <span class="at-y">' + esc(yr) + "</span>" : "");
          h.push("<li>" + (q.w ? '<a href="' + base + esc(q.w) + '">' + nm + "</a>" : nm) + "</li>");
        });
        h.push("</ul>");
        if (p.more) h.push('<p class="at-sub">and ' + p.more + " more — <a href=\"" + base + "/people/\">the full roster &rarr;</a></p>");
        h.push("</div>");
      }
      panel.innerHTML = h.join("");
      panel.hidden = false; empty.hidden = true;
      panel.scrollTop = 0;
    }

    /* WHICH QUESTION IS THIS DOT ANSWERING.
       With no schemes declared a place has one category and this is the
       identity function. With schemes, the place answers whichever of the LIVE
       ones it has a category for, and takes the colour of the RAREST - counted
       off the data, not declared, so the ordering cannot drift away from the
       thing it describes. */
    var schemeOn = {}, rarity = [];
    (SCHEMES || []).forEach(function (sc) { schemeOn[sc[0]] = true; });
    if ((SCHEMES || []).length) {
      rarity = SCHEMES.map(function (sc) {
        return [sc[0], d.places.filter(function (p) {
          return p.cats && p.cats[sc[0]];
        }).length];
      }).sort(function (a, b) { return a[1] - b[1]; }).map(function (x) { return x[0]; });
    }
    function catFor(p) {
      if (!rarity.length) return p.cat;
      for (var i = 0; i < rarity.length; i++) {
        var k = rarity[i];
        if (schemeOn[k] && p.cats && p.cats[k]) return p.cats[k];
      }
      return null;
    }
    /* Which scheme each colour belongs to, read out of the data, so that
       switching a layer off also puts its pills away. */
    var catScheme = {};
    if (rarity.length) d.places.forEach(function (p) {
      for (var k in (p.cats || {})) catScheme[p.cats[k]] = k;
    });

    var markers = [], pts = [];
    d.places.forEach(function (p) {
      var c0 = catFor(p);
      var r = p.n > 40 ? 11 : p.n > 12 ? 8.5 : p.n > 3 ? 6.5 : p.order ? 7.5 : 5;
      var m = L.circleMarker([p.lat, p.lon], {
        radius: r, color: "#ffffff", weight: p.order ? 2.2 : 1.2,
        fillColor: COLORS[c0] || "#666", fillOpacity: 0.9
      }).addTo(map);
      m.bindTooltip(p.name + (p.n ? " · " + p.n : ""), { direction: "top", offset: [0, -6] });
      m.on("click", function () { show(p); setQ("at", keyOf(p)); });
      m._p = p; markers.push(m); pts.push([p.lat, p.lon]);
    });

    // ---- the documented descent: the only line drawn solid ----------------
    var spinePts = d.places.filter(function (p) { return p.order; })
      .sort(function (x, y) { return x.order - y.order; })
      .map(function (p) { return [p.lat, p.lon]; });
    var spineLayer = L.layerGroup();
    L.polyline(spinePts, { color: "#A8442B", weight: 3, opacity: 0.85, lineCap: "round" }).addTo(spineLayer);

    // ---- David's own arrows, dashed and animated --------------------------
    // Motion is persuasive in a way that evidence is not, so these stay dashed
    // and say whose they are. Nothing here is upgraded to a document.
    var movesLayer = L.layerGroup();
    (d.moves || []).forEach(function (m) {
      /* A LINE IS NOT ALWAYS SOMEBODY'S GUESS. These were dashed violet and
         captioned "Drawn by David on his own map, this archive has not
         verified it" - true of the archive they were written for and false of
         a deportation, which is the best-documented movement in the Luwinski
         archive and must not be drawn as a hunch. Colour, dash and provenance
         come from the data now, and default to what they were. */
      var col = m.color || "#7A5CA8";
      var path = [m.from].concat(m.via || []).concat([m.to]);
      var line = L.polyline(path, {
        color: col, weight: m.weight || 1.6, opacity: m.opacity || 0.55,
        dashArray: m.dash === null ? null : (m.dash || "5 7"),
        className: m.dash === null ? "" : "at-flow", lineCap: "round"
      });
      var km = m.km ? " · " + m.km + " km" : "";
      line.bindTooltip(m.n + km, { sticky: true });
      line.bindPopup("<b>" + esc(m.n) + "</b>" +
        (m.layer ? "<br><i>" + esc(m.layer) + "</i>" : "") +
        (m.km ? "<br>" + m.km + " km" : "") +
        "<br><span style='font-size:11px;opacity:.75'>" +
        esc(m.note || "Drawn by David on his own map. This archive has not verified it.") +
        "</span>");
      line.addTo(movesLayer);
      // a head at the destination, so the arrow has a direction
      L.circleMarker(m.to, { radius: 2.6, color: col, weight: 0, fillColor: col, fillOpacity: 0.8 })
        .addTo(movesLayer);
    });

    // ---- the hot-spots, as he drew them -----------------------------------
    var areasLayer = L.layerGroup();
    (d.areas || []).forEach(function (a) {
      if (!a.ring || a.ring.length < 3) return;
      L.polygon(a.ring, { color: "#4E7A55", weight: 1.4, opacity: 0.7,
                          fillColor: "#4E7A55", fillOpacity: 0.10 })
        .bindTooltip(a.n, { sticky: true })
        .bindPopup("<b>" + esc(a.n) + "</b><br><i>" + esc(a.layer) + "</i><br>" +
          "<span style='font-size:11px;opacity:.75'>An area David shaded on his own map.</span>")
        .addTo(areasLayer);
    });

    /* Whichever overlays this archive declared, switched on exactly as its
       buttons say. An archive that declared none has no buttons, so nothing
       here can turn on a layer with nothing in it. */
    var OVER = { spine: spineLayer, moves: movesLayer, areas: areasLayer };
    document.querySelectorAll(".at-cat[data-over].on").forEach(function (b) {
      var lay = OVER[b.getAttribute("data-over")];
      if (lay && !map.hasLayer(lay)) lay.addTo(map);
    });
    document.querySelectorAll(".at-cat[data-over]").forEach(function (b) {
      b.addEventListener("click", function () {
        var k = b.getAttribute("data-over"), lay = OVER[k];
        var on = map.hasLayer(lay);
        if (on) map.removeLayer(lay); else lay.addTo(map);
        b.classList.toggle("on", !on);
      });
    });

    map.fitBounds(L.latLngBounds(BOUNDS), { padding: [24, 24] });
    /* AND AGAIN ONCE THE BROWSER HAS LAID THE PAGE OUT. Leaflet computes the
       zoom from the container's size, and a container measured before its CSS
       has settled is zero, which fits the bounds at maximum zoom - a single
       ocean tile where a map should be. Seen once on the Luwinski atlas on a
       cold dev server and not reproducible afterwards, which is exactly the
       kind of race that reaches a reader and not a developer. One extra frame
       costs nothing and removes it. */
    requestAnimationFrame(function () {
      map.invalidateSize();
      /* UNLESS THE READER ARRIVED ON A LINK. This frame exists to survive a
         zero-sized container, and it ran after the URL had already set the
         view - so a sent link was being thrown away one frame after it was
         honoured, which is worse than not supporting links at all. */
      if (!Q.get("view")) map.fitBounds(L.latLngBounds(BOUNDS), { padding: [24, 24] });
      settled = true;
    });

    // filters
    var off = {}, q = document.getElementById("at-q"), count = document.getElementById("at-count");
    function apply() {
      var t = (q.value || "").toLowerCase().trim();
      var shown = 0;
      markers.forEach(function (m) {
        var p = m._p, c = catFor(p);
        /* A place none of the live layers can answer is not greyed out, it is
           gone: this map has 1,235 places on one layer and 61 on another, and
           leaving the other 1,174 sitting there in grey would bury the thing
           the reader just asked to see. */
        var ok = c !== null && !off[c] &&
          (!t || (p.name + " " + (p.also || []).join(" ")).toLowerCase().indexOf(t) > -1);
        if (ok) {
          if (m.options.fillColor !== (COLORS[c] || "#666")) {
            m.setStyle({ fillColor: COLORS[c] || "#666" });
          }
          if (!map.hasLayer(m)) m.addTo(map);
          shown++;
        }
        else if (map.hasLayer(m)) map.removeLayer(m);
      });
      count.textContent = shown + " of " + markers.length + " places shown";
      if (t && shown) {
        var vis = markers.filter(function (m) { return map.hasLayer(m); });
        map.fitBounds(L.latLngBounds(vis.map(function (m) { return m.getLatLng(); })), { padding: [40, 40], maxZoom: 11 });
        if (vis.length === 1) show(vis[0]._p);
      }
    }
    q.addEventListener("input", function () { setQ("q", q.value.trim()); apply(); });
    document.querySelectorAll(".at-cat[data-cat]").forEach(function (b) {
      b.addEventListener("click", function () {
        var c = b.getAttribute("data-cat");
        off[c] = !off[c]; b.classList.toggle("on", !off[c]);
        setQ("off", Object.keys(off).filter(function (k) { return off[k]; }).join(","));
        apply();
      });
    });
    /* Switching a layer off also puts its colours away, so the legend below
       always describes the map above it rather than every colour the page
       could ever draw. */
    function syncKey() {
      if (!rarity.length) return;
      document.querySelectorAll(".at-cat[data-cat]").forEach(function (b) {
        var sc = catScheme[b.getAttribute("data-cat")];
        b.hidden = !!sc && !schemeOn[sc];
      });
    }
    function liveLayers() {
      return (SCHEMES || []).map(function (x) { return x[0]; })
        .filter(function (k) { return schemeOn[k]; });
    }
    document.querySelectorAll(".at-sch").forEach(function (b) {
      b.addEventListener("click", function () {
        var k = b.getAttribute("data-scheme");
        schemeOn[k] = !schemeOn[k];
        b.classList.toggle("on", schemeOn[k]);
        /* Everything on is the default, so it is written as nothing at all -
           a link to the map as it opens should not be forty characters of
           state saying "unchanged". */
        var live = liveLayers();
        setQ("layers", live.length === (SCHEMES || []).length ? "" : live.join(","));
        syncKey(); apply();
      });
    });

    /* ---- and read it back, once, before the first draw -------------------
       The URL wins over the defaults on the way in. Order matters: the layers
       and the switched-off colours have to be settled before apply() runs, or
       the first paint is the default map and the reader watches their own link
       being applied to it. */
    (function () {
      var wantLayers = Q.get("layers");
      if (wantLayers !== null && (SCHEMES || []).length) {
        var want = wantLayers.split(",").filter(Boolean);
        (SCHEMES || []).forEach(function (sc) { schemeOn[sc[0]] = want.indexOf(sc[0]) > -1; });
        document.querySelectorAll(".at-sch").forEach(function (b) {
          b.classList.toggle("on", !!schemeOn[b.getAttribute("data-scheme")]);
        });
      }
      (Q.get("off") || "").split(",").filter(Boolean).forEach(function (c) {
        off[c] = true;
        var b = document.querySelector('.at-cat[data-cat="' + c + '"]');
        if (b) b.classList.remove("on");
      });
      var qt = Q.get("q");
      if (qt) q.value = qt;
    })();

    syncKey();
    apply();

    /* The map position, after apply(), because apply() refits the bounds when
       there is a search term and a link to a place should beat that. */
    (function () {
      var v = (Q.get("view") || "").split(",").map(Number);
      if (v.length === 3 && v.every(function (x) { return !isNaN(x); })) {
        map.setView([v[0], v[1]], v[2]);
      }
      /* Only once the opening view has settled. fitBounds fires moveend, so
         writing on every one of them stamped ?view= into the URL of every
         visitor who had done nothing at all - turning a clean address into
         state the moment the page loaded. */
      map.on("moveend", function () {
        if (!settled) return;
        var c = map.getCenter();
        setQ("view", c.lat.toFixed(4) + "," + c.lng.toFixed(4) + "," + map.getZoom());
      });
      var at = Q.get("at");
      if (at) {
        var hit = markers.filter(function (m) { return keyOf(m._p) === at; })[0];
        if (hit) show(hit._p);
      }
    })();

    /* The switcher itself, as a Leaflet control so it sits on the map rather
       than in the page's own furniture - the choice is about the map and
       nowhere else. */
    var baseCtl = L.control({ position: "bottomleft" });
    baseCtl.onAdd = function () {
      var b = L.DomUtil.create("div", "leaflet-bar at-base");
      b.innerHTML = BASES.map(function (x) {
        return '<a href="#" data-b="' + x[0] + '"' +
               (x[0] === baseNow ? ' class="on"' : "") + ">" + x[1] + "</a>";
      }).join("");
      L.DomEvent.disableClickPropagation(b);
      L.DomEvent.on(b, "click", function (e) {
        var a = e.target.closest("a[data-b]");
        if (!a) return;
        L.DomEvent.stop(e);
        var k = a.getAttribute("data-b");
        if (k === baseNow) return;
        map.removeLayer(tiles[baseNow]);
        baseNow = k;
        tiles[k].addTo(map);
        tiles[k].bringToBack();
        b.querySelectorAll("a").forEach(function (x) {
          x.classList.toggle("on", x.getAttribute("data-b") === k);
        });
        setQ("base", k === "street" ? "" : k);
        try { localStorage.setItem(BKEY, k); } catch (e2) {}
      });
      return b;
    };
    baseCtl.addTo(map);

    var btn = L.control({ position: "topright" });
    btn.onAdd = function () {
      var b = L.DomUtil.create("div", "leaflet-bar");
      b.innerHTML = '<a href="#" title="Show the whole world" style="width:auto;padding:0 9px;font:500 11px/26px system-ui">Whole world</a>';
      var wide = false;
      L.DomEvent.on(b, "click", function (e) {
        L.DomEvent.stop(e); wide = !wide;
        if (wide) { map.fitBounds(L.latLngBounds(pts), { padding: [24, 24] }); b.querySelector("a").textContent = HOME; }
        else { map.fitBounds(L.latLngBounds(BOUNDS), { padding: [24, 24] }); b.querySelector("a").textContent = "Whole world"; }
      });
      return b;
    };
    btn.addTo(map);
  });
</script>

