---
import FilterTable from "./FilterTable.astro";
/* Every name in the archive, and how many people bore it.
 *
 * Five archives had this page and three of them were BYTE-IDENTICAL apart from
 * the line that imports the data — a copy-paste fork sitting there waiting to
 * drift, which is the thing the kit exists to stop. Falco and Booyzen differed
 * only in wording.
 *
 * All seven now. The two that looked like different pages were not: both keep
 * ONE ENTRY PER NAME, keyed by a name-slug — 1,118 entries for 1,118 distinct
 * names on Defranceschi, 169 for 169 on D'Arcy — and both called each entry a
 * PERSON in their prose. On an estate whose oldest rule is that it never merges
 * records on a name, that wording asserts the merge the rule forbids: two men
 * called Giovanni Defranceschi get one entry, and the page called it a man.
 *
 * WHAT n COUNTS IS NOT THE SAME EVERYWHERE, and it decides what may be said.
 * Where it counts BEARERS, the names held by more than one are the ones a
 * reader goes wrong on and the page says so — that is the estate's oldest rule
 * doing its job. Where it counts mentions or records, the same sentence would
 * be false: twelve mentions of a name is not twelve people, and a page that
 * offered "held by more than one person" over that number would be inventing
 * the very merge this rule exists to prevent. So the claim is only made where
 * the number supports it.
 *
 *   names   [{slug, name, n, detail}]  detail is optional, shown beside the name
 *   u       the archive's url helper
 *   counts  what n counts: "people" (bearers), "records", "mentions", …
 *           (`unit` was the old spelling and is gone; Falco was its last caller)
 *   noun    what the rows are, for the count line ("names")
 */
/* `fold` IS FORWARDED, NOT CONSUMED. FilterTable has taken a variant-to-
   canonical map since the Blazevic register moved onto it, and every wrapper
   between a page and that table quietly dropped it - so the one mechanism in
   this kit that makes a search find "Booysen" when the reader types "Booyzen"
   was reachable from exactly one page in the estate. A component that accepts
   a prop and forwards it is not worth a comment; one that ate it for weeks is. */
const { names = [], u = (p) => p, counts, noun = "names", fold = null,
        detailLabel = "What the record says" } = Astro.props;
const what = counts ?? "people";
const bearers = what === "people";
/* "people" does not end in s, so stripping one leaves "more than one people".
   The three words this estate actually uses are spelled out; anything else an
   archive passes falls back to dropping a trailing s. */
const SINGULAR = { people: "person", records: "record", mentions: "mention" };
const one = SINGULAR[what] || what.replace(/s$/, "");
const anyDetail = names.some((n) => n.detail);
const shared = names.filter((n) => n.n > 1);
const esc = (s) => String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;");
---
<FilterTable
  fold={fold}
  unit={noun}
  columns={[
    { label: "Name" },
    ...(anyDetail ? [{ label: detailLabel, cls: "small" }] : []),
    { label: what.charAt(0).toUpperCase() + what.slice(1), cls: "mono" },
  ]}
  facets={shared.length ? [{ key: "many", label: bearers ? "Held by" : "Appears in", options: [
    { v: "1", label: `More than one ${one}` },
    { v: "0", label: `One ${one} only` }] }] : []}
  note={shared.length
    ? (bearers
      ? `<strong>${shared.length.toLocaleString()}</strong> of these ${noun} belong to more than one person. Those are the ones where a reader can go wrong: <strong>a name is not a person</strong>, and this archive does not join two of them without a record that says to.`
      : `<strong>${shared.length.toLocaleString()}</strong> of these ${noun} appear in more than one ${one}. That is a count of ${what}, <strong>not of people</strong> — one name can be two men and this archive does not join them without a record that says to.`)
    : (bearers
      ? `No name here is held by more than one person.`
      : `No name here appears in more than one ${one}.`)}
  rows={names.map((n) => ({
    hay: (n.name + " " + (n.detail || "")).toLowerCase(),
    facets: { many: n.n > 1 ? "1" : "0" },
    cells: [
      `<a href="${u(`/who/${n.slug}/`)}">${esc(n.name)}</a>`,
      ...(anyDetail ? [n.detail || ""] : []),
      n.n > 1 ? String(n.n) : "",
    ],
  }))} />
