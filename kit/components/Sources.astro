---
/* What an archive stands on — and, for each source, where to go and check.

   THE GROUPING IS THE ARCHIVE'S AND THIS FILE IMPOSES NONE. Measured across
   eight sources pages, 1,277 bespoke lines, they rank by four different
   things: Blazevic by evidential authority (state record, parish register,
   family tree, background, rejected, not consulted); Lerena by PRIMARY /
   SECONDARY / REFERENCE; Falco by record type and country; Defranceski by
   format. Mazza and Booyzen group by narrative — "Tried and found wanting".
   An archive that ranks by authority is making a different argument from one
   that sorts by record type, and picking a winner would lose the argument to
   make a table look tidy. So `groups` renders in the order handed in, with
   the archive's own label and its own one-line note.

   THE ROW IS NOT THE ARCHIVE'S, and that is the whole point of this file.
   Defranceski's row is the benchmark, adopted here wholesale, because one
   measurement settles it: of 208 sources across the estate, 58 carry a link
   to the source itself — and all 58 are Defranceski's. Falco 0 of 26, Mazza
   0 of 25, Booyzen 0 of 42, D'Arcy 0 of 18, Blazevic 0 of 12. Blazevic and
   Booyzen do link, but inward to their own pages, which is navigation, not
   the source. A sources page whose sources cannot be reached is asking to be
   taken on trust, which is the one thing a sources page exists not to do.
   Defranceski states it on its own page and the sentence is the spec: «an
   archive that will not say where it got something is a rumour with a
   stylesheet».

   So every row here is, in this order:

     title     linked to `url` — the catalogue, collection or repository
               itself — when there is one.
     where     the subdued line under it: the place it is held, and the bare
               domain. This replaces the two-row HELD BY / WHAT IT IS table
               Blazevic used; same two facts, one line.
     what      what is in it and what was mined out of it.
     cites     DISCRETE references, each its own chip — not one comma-run.
               A reader checking a claim needs to copy one reference, not
               find it inside a sentence.
     note      the caution, ruled: what is wrong with it, or still unread.
     held      where the thing physically is, when there is no url. A path
               into the project's own source library is announced as one; any
               other wording is printed as the archive wrote it.

   `id` gives every source an anchor, so a page elsewhere can link IN to the
   exact source it rests on (`/sources/#arolsen`). Defranceski is the only
   archive that does this and it is the reason its pages can carry a source
   block at all.

     groups    [{ label, note, rows }] — in the order handed in.
     rows      [{ id, title, url, where, holder, kind, what, cites, note,
                  caution, held, volumes, tag, href, hrefLabel }]
               Only `title` is required. `caution` is an alias for `note`.
               `holder` folds into the `where` line. `tag` is a per-row
               qualifier that is NOT the group — Lerena's tier field has 26
               distinct values for three tiers because it concatenated the
               tier with a free-text note, so the note needs somewhere to go
               that is not the ranking. Mazza's `seen` is the other use: read
               here / index only / the tree / unreferenced / a wall, which
               grades the ROW and cuts across its groups. `tagTitle` carries
               the gloss — "an index entry proves a name was written
               somewhere" — which is the part that makes the tag mean
               anything.
     u         the archive's url helper — hand-written HTML in source data is
               common and an href='/x' in it needs the site base, the trap
               /open-questions/ and /corrections/ both fell into.
     facets    filter buttons over the groups, with counts. Default on when
               there is more than one group.
     html      true when the data carries markup; default true, because six
               of the eight hold HTML in these fields already.
*/
const {
  groups = [], u = (p) => p, html = true, facets = groups.length > 1,
} = Astro.props;

const B = u("/");
const fix = (s) => String(s ?? "").replace(/href=(['"])\//g, `href=$1${B}`);
const F = (s) => (html ? fix(s) : String(s ?? ""));
const bare = (s) => String(s).replace(/^https?:\/\//, "").replace(/\/$/, "");
const list = (v) => (Array.isArray(v) ? v : v == null || v === "" ? [] : [v]);

/* `held` carries two different answers and they need different sentences.
   Defranceski's are paths into the project's own source library. Falco's are
   prose — "Paper, held by the family". Announcing the second as a copy in the
   source library says the opposite of what it means. */
const libPath = (h) => /[/\\]/.test(String(h)) || /\.\w{2,5}$/.test(String(h));

/* An external url is the source; an internal one is navigation. Counting them
   apart is the point — see the header. */
const rows = groups.flatMap((g) => g.rows || []);
const reachable = rows.filter((r) => /^https?:/.test(r.url || "")).length;
---
{facets && (
  <div class="sr-f filters" role="group" aria-label="Filter sources">
    <button type="button" data-g="all" aria-pressed="true">All {rows.length}</button>
    {groups.map((g) => (
      <button type="button" data-g={g.label} aria-pressed="false">
        {g.label}{" "}<span class="sr-n">{(g.rows || []).length}</span>
      </button>
    ))}
  </div>
)}
<div class="sr" data-reachable={reachable} data-total={rows.length}>
  {groups.map((g) => (
    <section class="sr-g" data-g={g.label}>
      {g.label && (
        <div class="sr-lab">
          {g.label}{g.note ? <span class="sr-note"> — <Fragment set:html={F(g.note)} /></span> : null}
        </div>
      )}
      {(g.rows || []).map((r) => (
        <article class="sr-row" id={r.id || null}>
          <h3 class="sr-t">
            {r.url ? <a href={r.url} rel="noopener"><Fragment set:html={F(r.title)} /></a>
                   : <Fragment set:html={F(r.title)} />}
            {r.tag ? <span class="sr-tag" title={r.tagTitle || null}>{r.tag}</span> : null}
          </h3>
          {(r.where || r.holder || r.kind || r.url) && (
            <div class="sr-meta">
              {(r.where || r.holder) && <span set:html={F(r.where || r.holder)} />}
              {r.kind && <span class="sr-kind" set:html={F(r.kind)} />}
              {r.url && <span class="mono">{bare(r.url)}</span>}
            </div>
          )}
          {r.what && <p class="sr-w" set:html={F(r.what)} />}
          {list(r.volumes).length > 0 && (
            <ul class="sr-vol">{list(r.volumes).map((v) => <li set:html={F(v)} />)}</ul>
          )}
          {list(r.cites).length > 0 && (
            <div class="sr-refs">{list(r.cites).map((c) => <code>{c}</code>)}</div>
          )}
          {r.carries && <p class="sr-c" set:html={F(r.carries)} />}
          {(r.note || r.caution) && (
            <div class="sr-cav" set:html={F(r.note || r.caution)} />
          )}
          {r.held && (
            <p class="sr-held"><strong>Held.</strong>{" "}{libPath(r.held)
              ? <Fragment>A copy is in this project's source
                library: <span class="mono">{r.held}</span></Fragment>
              : <Fragment>{r.held}</Fragment>}</p>
          )}
          {r.href && r.hrefLabel && (
            <p class="sr-go"><a href={u(r.href)}>{r.hrefLabel}</a></p>
          )}
        </article>
      ))}
    </section>
  ))}
</div>

{facets && (
  <script is:inline>
    (() => {
      const bar = document.querySelector(".sr-f");
      if (!bar) return;
      const secs = [...document.querySelectorAll(".sr-g")];
      bar.addEventListener("click", (e) => {
        const b = e.target.closest("button[data-g]");
        if (!b) return;
        bar.querySelectorAll("button").forEach((x) =>
          x.setAttribute("aria-pressed", String(x === b)));
        secs.forEach((s) => {
          s.hidden = b.dataset.g !== "all" && s.dataset.g !== b.dataset.g;
        });
      });
    })();
  </script>
)}

<style is:global>
  .sr-f { margin: 0 0 1.6rem; }
  /* The space is in the markup, not here — a margin would leave the button's
     TEXT reading "Parish registers5" for the search index and a reader. */
  .sr-n { opacity: .6; }
  .sr-g { margin: 0 0 2.1rem; }
  .sr-lab {
    font-family: var(--sans); font-size: 10px; font-weight: 600; letter-spacing: .13em;
    text-transform: uppercase; color: var(--ink-3); margin: 0 0 .7rem;
  }
  .sr-note { text-transform: none; letter-spacing: 0; font-weight: 400; }
  .sr-row { border-top: 1px solid var(--rule); padding: 1.1rem 0 .5rem; }
  .sr-g .sr-row:first-of-type { border-top: 0; padding-top: .1rem; }
  .sr-t { margin: 0 0 .3rem; font-size: 1.12rem; font-family: var(--serif); font-weight: 600; }
  .sr-tag {
    margin-left: .55rem; font-family: var(--sans); font-size: 9.5px; font-weight: 600;
    letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3);
    border: 1px solid var(--rule-strong); padding: 1px 5px; white-space: nowrap;
  }
  .sr-meta {
    display: flex; flex-wrap: wrap; gap: .25rem 1.1rem; margin: 0 0 .6rem;
    font-size: 13.5px; color: var(--ink-3);
  }
  .sr-meta .mono { font-size: 12.5px; }
  .sr-kind { font-style: italic; }
  .sr-w, .sr-c { margin: 0 0 .55rem; }
  .sr-c { color: var(--ink-2); }
  .sr-vol { margin: 0 0 .55rem; padding-left: 1.1em; }
  .sr-vol li { margin-bottom: .2rem; }
  .sr-refs { display: flex; flex-wrap: wrap; gap: .35rem; margin: 0 0 .6rem; }
  .sr-refs code {
    font-family: var(--mono); font-size: 12.5px; background: var(--panel-2, var(--panel));
    border: 1px solid var(--rule); padding: 2px 7px; white-space: pre-wrap;
  }
  .sr-cav {
    border-left: 2px solid var(--ochre); padding: .35rem 0 .35rem .75rem;
    margin: 0 0 .55rem; color: var(--ink-2); font-size: 14.5px;
  }
  .sr-held { font-size: 13px; color: var(--ink-3); margin: .5rem 0 .2rem; }
  /* No margin here on purpose. A CSS gap would look right and leave the TEXT
     reading "Held.Paper, held by the family" — which is what the search index
     and a screen reader get. The space belongs in the markup, as {" "}. */
  .sr-go { margin: 0 0 .2rem; font-size: 14px; }
  @media (max-width: 560px) { .sr-meta { gap: .15rem .7rem; } }
</style>
