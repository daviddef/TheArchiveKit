---
/* Every place this archive can put a person in, as one small still picture.

   Five of the seven home pages carried no drawing at all — the same gap the
   tree pages had before the chart was shared and the atlases before the map
   was. This closes it with the one thing every archive now has: coordinates.

   It is a PLOT, not a map. No tiles, no coastline, no borders — because an
   archive that has not got a coastline should not draw one, which is the
   argument Booyzen made for its own graticule and it is right. What is here is
   exactly what the data contains: a point per place, sized by how many people
   stand in it, on the ground those points actually cover.

   Longitude is corrected by cos(latitude) so a band of Istria does not come
   out stretched sideways; beyond that there is no projection worth the name at
   this size, and pretending otherwise would be decoration.

   THE FRAME IS NOT THE FULL EXTENT, and it used to be. Fitting min to max puts
   one far-flung place in charge of the whole picture: Blazevic has 88% of its
   fifty-nine places inside a degree and a half of each other and still had to
   span 124° for two outliers, so fifty-two towns landed on top of one another
   and the drawing showed three dots. Mazza spanned 269° — most of the planet —
   for fifty-six places.

   So the frame is now the middle nine-tenths of the points, and anything
   outside it is drawn ON the edge it went out through, as a half-dot, and
   counted underneath. Every place is still represented and none of them is
   moved anywhere it is not: a place beyond the frame is shown at the boundary
   in its own direction, which is a true statement about it, and the caption
   says how many there are. Nothing is hidden and the cluster is legible.

   WHAT IT WAS MISSING was not geography, it was names. A reader met sixty
   green dots in an empty box and had no way in: no town, no region, no reason
   to look twice. Every place in this data already carries a name, a count and
   the archive's own regional grouping, and none of that was drawn.

   So the largest places are now labelled — as many as fit without a collision,
   biggest first — and the dots take their colour from the `cat` the archive
   itself assigned, with a legend. That is the archive's own structure made
   visible, not a projection borrowed from somewhere else.

     places   [{ lat, lon, n, name, cat }] — the archive's own atlas data
     href     where the picture leads
     label    the line underneath
     names    how many places to label (default 7, 0 to turn off)
*/
const { places = [], href, label, names = 7 } = Astro.props;
const pts = places.filter((p) => typeof p.lat === "number" && typeof p.lon === "number");

const W = 560, H = 230, PAD = 16;
const q = (arr, p) => {
  const a = [...arr].sort((x, y) => x - y);
  const i = (a.length - 1) * p;
  const lo = Math.floor(i), hi = Math.ceil(i);
  return lo === hi ? a[lo] : a[lo] + (a[hi] - a[lo]) * (i - lo);
};

/* The TIGHTEST window that still holds `share` of the values — not a fixed
   percentile, which was the first thing tried here and did nothing for the
   case it was written for. Blazevic keeps 88% of its places inside a degree
   and a half and the rest scattered over a hemisphere; trimming five per cent
   off each end left the frame 123° wide and the cluster still a smudge.
   Sliding the narrowest window that covers four places in five finds the
   cluster itself, whatever shape the tail is. */
/* how many places a frame actually keeps apart, on the grid it will be drawn on */
const legibility = (frame, pts, k) => {
  const [[la0, la1], [lo0, lo1]] = frame;
  const spanX = Math.max((lo1 - lo0) * k, 0.02), spanY = Math.max(la1 - la0, 0.02);
  const scale = Math.min((520 - 28) / spanX, (200 - 28) / spanY);
  const cx = ((lo0 + lo1) / 2) * k, cy = (la0 + la1) / 2;
  const cells = new Set();
  let inside = 0;
  for (const p of pts) {
    const x = 260 + (p.lon * k - cx) * scale, y = 100 - (p.lat - cy) * scale;
    if (x < 7 || x > 513 || y < 7 || y > 193) continue;
    inside++;
    cells.add(Math.round(x / 6) + "," + Math.round(y / 6));
  }
  return { cells: cells.size, kept: inside / pts.length };
};
/* keep the frame that separates the most places while still holding 70% of them */
const bestFrame = (frames, pts, k) => {
  let best = frames[frames.length - 1], bestScore = -1;
  for (const f of frames) {
    const { cells, kept } = legibility(f, pts, k);
    if (kept < 0.7) continue;
    if (cells > bestScore) { bestScore = cells; best = f; }
  }
  return best;
};
const densest2 = (lats, lons, share) => [densest(lats, share), densest(lons, share)];

const densest = (arr, share) => {
  const a = [...arr].sort((x, y) => x - y);
  const need = Math.max(2, Math.ceil(a.length * share));
  if (a.length <= need) return [a[0], a[a.length - 1]];
  let best = [a[0], a[need - 1]];
  for (let i = 0; i + need <= a.length; i++)
    if (a[i + need - 1] - a[i] < best[1] - best[0]) best = [a[i], a[i + need - 1]];
  return best;
};

let view = null, outside = 0;
const labels = [];
let cats = [], catIndex = new Map();
if (pts.length) {
  const lats = pts.map((p) => p.lat), lons = pts.map((p) => p.lon);
  const k = Math.cos(q(lats, 0.5) * Math.PI / 180) || 1;

  /* Below about a dozen places a quantile is not measuring anything, so the
     old full-extent frame is still the honest one. */
  /* Which frame? It depends entirely on the family, and the component is in no
     position to guess. A tight window is right for Blazevic, whose places are
     one mountain county and a few emigrants — it took the picture from 124°
     wide to 1° and from five legible dots to eighteen. It is WRONG for Mazza
     and Lerena, who really did live on three continents at once: there is no
     home cluster to find, and cropping to one lost them dots rather than
     gaining any.

     So draw each candidate frame and keep whichever separates the most places,
     provided it still holds most of them. That is measurable here, at build
     time, against this archive's own coordinates, instead of being decided in
     advance for seven families who have nothing in common. */
  const robust = pts.length >= 12;
  const candidates = robust
    ? [densest2(lats, lons, 0.8), densest2(lats, lons, 0.9),
       [[Math.min(...lats), Math.max(...lats)], [Math.min(...lons), Math.max(...lons)]]]
    : [[[Math.min(...lats), Math.max(...lats)], [Math.min(...lons), Math.max(...lons)]]];
  const [[la0, la1], [lo0, lo1]] = bestFrame(candidates, pts, k);

  // a single place, or places all at one spot, still needs a box with width
  const spanX = Math.max((lo1 - lo0) * k, 0.02);
  const spanY = Math.max(la1 - la0, 0.02);
  const scale = Math.min((W - PAD * 2) / spanX, (H - PAD * 2) / spanY);
  const cx = ((lo0 + lo1) / 2) * k, cy = (la0 + la1) / 2;
  const most = Math.max(1, ...pts.map((p) => p.n || 0));

  view = pts.map((p) => {
    const x = W / 2 + (p.lon * k - cx) * scale;
    const y = H / 2 - (p.lat - cy) * scale;
    const cx2 = Math.min(W - PAD / 2, Math.max(PAD / 2, x));
    const cy2 = Math.min(H - PAD / 2, Math.max(PAD / 2, y));
    const off = cx2 !== x || cy2 !== y;
    if (off) outside++;
    return { x: cx2, y: cy2, off, n: p.n || 0, name: p.name, cat: p.cat,
             r: 2.2 + 4.6 * Math.sqrt((p.n || 0) / most) };
  });

  /* Label the biggest places, and only where the label will not land on one
     already written. Greedy, biggest first, because if only six names fit they
     should be the six that account for the most people — and a picture with
     six names on it is readable where the same picture with none is not. */
  const taken = [];
  const clear = (b) => !taken.some((t) =>
    b.x < t.x2 && b.x2 > t.x && b.y < t.y2 && b.y2 > t.y);
  for (const d of [...view].sort((a, b) => b.n - a.n)) {
    if (labels.length >= names) break;
    if (!d.name || d.off) continue;
    const w = Math.min(d.name.length * 5.1 + 6, 96);
    const right = d.x + d.r + 4 + w < W - PAD;
    const bx = right ? d.x + d.r + 4 : d.x - d.r - 4 - w;
    const box = { x: bx, x2: bx + w, y: d.y - 6, y2: d.y + 6 };
    if (bx < PAD / 2 || !clear(box)) continue;
    taken.push(box);
    labels.push({ x: right ? bx : bx + w, y: d.y + 3.4, text: d.name, anchor: right ? "start" : "end" });
  }

  /* The regions are the archive's own, so the legend is too. */
  const seen = new Map();
  for (const d of view) if (d.cat) seen.set(d.cat, (seen.get(d.cat) || 0) + 1);
  cats = [...seen.entries()].sort((a, b) => b[1] - a[1]).slice(0, 5).map(([c], i) => [c, i]);
  catIndex = new Map(cats);
}
/* said plainly under the picture rather than left for the reader to wonder at */
const note = outside
  ? `${outside} ${outside === 1 ? "place sits" : "places sit"} beyond this frame, shown on the edge`
  : null;
---
{view && (
  <a class="spark" href={href} aria-label={label || "Open the atlas"}>
    <svg viewBox={`0 0 ${W} ${H}`} width="100%" role="img" aria-hidden="true">
      {view.map((p) => (
        <circle cx={p.x} cy={p.y} r={p.r}
                class={`spark-dot c${catIndex.get(p.cat) ?? 0}${p.off ? " is-off" : ""}`} />
      ))}
      {labels.map((l) => (
        <text x={l.x} y={l.y} text-anchor={l.anchor} class="spark-n">{l.text}</text>
      ))}
    </svg>
    {cats.length > 1 && (
      <div class="spark-key">
        {cats.map(([c, i]) => (
          <span><i class={`sk c${i}`}></i>{c}</span>
        ))}
      </div>
    )}
    {label && <div class="spark-l">{label}</div>}
    {note && <div class="spark-l spark-off">{note}</div>}
  </a>
)}

<style>
  .spark {
    display: block; text-decoration: none; color: inherit;
    border: 1px solid var(--rule); border-radius: 3px;
    background: var(--panel); padding: 12px 14px 10px; margin-top: 20px;
  }
  .spark:hover { border-color: var(--accent); }
  .spark svg { display: block; }
  .spark-dot { fill: var(--accent); fill-opacity: .62; }
  .spark:hover .spark-dot { fill-opacity: .85; }
  /* the regions are the archive's own; the palette is the house one */
  .spark-dot.c0 { fill: var(--accent); }
  .spark-dot.c1 { fill: var(--terra); }
  .spark-dot.c2 { fill: var(--ochre); }
  .spark-dot.c3 { fill: var(--accent-2, var(--accent)); }
  .spark-dot.c4 { fill: var(--ink-2); }
  .spark-n {
    font-family: var(--sans); font-size: 9.5px; fill: var(--ink-2);
    paint-order: stroke; stroke: var(--panel); stroke-width: 2.6px; stroke-linejoin: round;
  }
  .spark-key {
    display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 9px;
    font-family: var(--mono); font-size: 10px; color: var(--ink-3);
  }
  .spark-key span { display: inline-flex; align-items: center; gap: 5px; }
  .spark-key .sk { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
  .sk.c0 { background: var(--accent); } .sk.c1 { background: var(--terra); }
  .sk.c2 { background: var(--ochre); } .sk.c3 { background: var(--accent-2, var(--accent)); }
  .sk.c4 { background: var(--ink-2); }
  /* A place on the edge is not at the edge — it is somewhere past it, in that
     direction. Hollow, so it cannot be misread as a town that is really there. */
  .spark-dot.is-off {
    fill: none; stroke: var(--accent); stroke-width: 1.4; stroke-opacity: .75;
  }
  .spark-off { opacity: .72; font-style: italic; }
  .spark-l {
    font-family: var(--mono); font-size: 11px; color: var(--ink-3);
    margin-top: 8px; line-height: 1.5;
  }
</style>
