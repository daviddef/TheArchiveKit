---
/* What this archive got wrong, and what is true instead.
 *
 * The most estate-wide idea there is, and it had seven answers: five different
 * page titles and no two data shapes alike. Falco says was/now, Defranceschi
 * said/true, Lerena what_was_said/what_is_true, Booyzen the same pair as
 * positional arrays, Blazevic record/tree. Every one of them means WHAT WAS
 * PUBLISHED and WHAT IS TRUE, plus how it was caught and when.
 *
 * NOT A TABLE, deliberately. The first version of this put the pair in four
 * columns and it was unreadable: these are sentences, sometimes paragraphs, and
 * a correction that cannot be read is not a correction. The shape promoted here
 * is the Falco one, which was already the best of the seven — a dated entry
 * with the retraction above the truth.
 *
 * THE PAGE TITLES STAY. «For Michael», «What was taken back», «What This
 * Archive Got Wrong» are an archive's own voice, and the estate settled that a
 * menu label is shared while a page title need not be.
 *
 * Fields arrive as HTML, already rendered by the archive's own markdown helper,
 * because every archive has a different one and a component that took raw
 * markdown would be picking a winner.
 *
 * TWO DIMENSIONS, BECAUSE THE ARCHIVES FILTER BY DIFFERENT THINGS. Falco and
 * Defranceschi by severity, Booyzen by CAUSE - a list mistaken for a
 * population, a search written up as wider than it was - and Mazza by what the
 * correction is ABOUT, in 39 kinds, while also grading each one. Those are not
 * the same axis and one control cannot carry both. Past seven options the
 * control becomes a select, because 39 buttons is a wall, not a filter.
 *
 *   rows  [{when, who (HTML, so it can link), kind, sev, was, now, how, why, by, where, whereLabel,
 *           extra, superseded:{label, href, note}}]
 */
const { rows = [], u = (p) => p, major = "major",
        kindLabel = "About", sevLabel = "Show" } = Astro.props;
const tally = (k) => {
  const m = new Map();
  for (const r of rows) if (r[k]) m.set(r[k], (m.get(r[k]) || 0) + 1);
  return [...m.entries()].sort((a, b) => b[1] - a[1] || String(a[0]).localeCompare(String(b[0])));
};
const sevs = tally("sev");
const kinds = tally("kind");
/* One control only where there is something to choose between, and only where
   the chip is not already saying it on every row. */
const groups = [
  ...(sevs.length > 1 ? [{ key: "sev", label: sevLabel, opts: sevs }] : []),
  ...(kinds.length > 1 ? [{ key: "kind", label: kindLabel, opts: kinds }] : []),
];
/* u() prefixes the archive's base path, which is right for an internal path and
   wrong for everything else: running an external URL through it produced links
   like /TheDefranceski/https://www.myheritage.com/ — 254 of them, caught by the
   build gate rather than by looking at the page. Only internal paths get based. */
const href = (h) => !h ? "" : (/^(https?:)?\/\//.test(h) || h.startsWith("mailto:") ? h : u(h));
const ext = (h) => /^(https?:)?\/\//.test(String(h || ""));

---
<div class="cx">
  {groups.map((g) => (
    <div class="cx-bar" data-key={g.key}>
      <span class="cx-lab">{g.label}</span>
      {g.opts.length > 7 ? (
        <select class="cx-sel" aria-label={g.label}>
          <option value="">All {rows.length}</option>
          {g.opts.map(([v, n]) => <option value={v}>{v} ({n})</option>)}
        </select>
      ) : (
        <>
          <button type="button" class="cx-opt on" data-v="">All <span class="mono">{rows.length}</span></button>
          {g.opts.map(([v, n]) => (
            <button type="button" class="cx-opt" data-v={v}>{v} <span class="mono">{n}</span></button>
          ))}
        </>
      )}
    </div>
  ))}

  {rows.map((r) => (
    <section class="cx-e" data-sev={r.sev || ""} data-kind={r.kind || ""} id={r.id || undefined}>
      <div class="cx-h">
        {r.when ? <span class="mono small">{r.when}</span> : null}
        {r.who ? <strong class="cx-who" set:html={r.who} /> : null}
        {r.kind ? <span class={"chip " + (r.sev === major ? "dis" : "")}>{r.kind}</span> : null}
        {r.sev === major ? <span class="chip doc">material</span> : null}
      </div>
      {r.superseded ? (
        <p class="cx-sup"><span class="cx-t">superseded</span>
          {r.superseded.note ? <Fragment set:html={r.superseded.note} /> : null}
          {r.superseded.href
            ? <a href={href(r.superseded.href)}>{r.superseded.label} →</a>
            : <span>{r.superseded.label}</span>}</p>
      ) : null}
      {r.was ? <p class="cx-was"><span class="cx-t">was</span> <Fragment set:html={r.was} /></p> : null}
      {r.now ? <p class="cx-now"><span class="cx-t">now</span> <strong><Fragment set:html={r.now} /></strong></p> : null}
      {r.how ? <p class="small cx-how"><span class="cx-t">how</span> <Fragment set:html={r.how} /></p> : null}
      {r.why ? <p class="cx-why"><Fragment set:html={r.why} /></p> : null}
      {(r.by || r.where || r.extra) ? (
        <p class="small cx-foot">
          {r.by ? <span class="dim">Caught by {r.by}.</span> : null}
          {r.where ? <> {r.by ? " · " : ""}<a href={href(r.where)} rel={ext(r.where) ? "noopener" : null}>{r.whereLabel || "Where it lives now →"}</a></> : null}
          {r.extra ? <Fragment set:html={r.extra} /> : null}
        </p>
      ) : null}
    </section>
  ))}
  <p class="cx-none small" hidden>Nothing at that level.</p>
</div>

<script>
  document.querySelectorAll(".cx").forEach((box) => {
    const entries = [...box.querySelectorAll(".cx-e")];
    const none = box.querySelector(".cx-none");
    /* The two controls narrow together rather than replacing one another: a
       reader asking for the birth-date corrections that are only probable is
       asking one question, not two. Each bar clears only its own key. */
    const picked = {};
    const apply = () => {
      let shown = 0;
      for (const e of entries) {
        let ok = true;
        for (const k in picked) {
          if (picked[k] && (e.dataset[k] || "") !== picked[k]) { ok = false; break; }
        }
        e.hidden = !ok;
        if (ok) shown++;
      }
      if (none) none.hidden = shown > 0;
    };
    box.querySelectorAll(".cx-bar").forEach((bar) => {
      const key = bar.dataset.key;
      bar.querySelectorAll(".cx-opt").forEach((b) => {
        b.addEventListener("click", () => {
          bar.querySelectorAll(".cx-opt").forEach((x) => x.classList.remove("on"));
          b.classList.add("on");
          picked[key] = b.dataset.v || "";
          apply();
        });
      });
      const sel = bar.querySelector(".cx-sel");
      if (sel) sel.addEventListener("change", () => { picked[key] = sel.value || ""; apply(); });
    });
  });
</script>

<style is:global>
  .cx-bar { display:flex; flex-wrap:wrap; gap:.35rem; align-items:center; margin:1rem 0 .4rem; }
  .cx-lab { font-size:9.5px; font-weight:600; letter-spacing:.11em; text-transform:uppercase;
    color:var(--ink-3,#888); margin-right:.35rem; }
  .cx-opt { font:inherit; font-size:.78rem; padding:.22rem .6rem; cursor:pointer;
    color:var(--ink-2,inherit); background:transparent; border:1px solid var(--rule,#ccc);
    border-radius:2px; display:inline-flex; gap:.4rem; align-items:baseline; }
  .cx-opt.on { color:var(--accent,#963); border-color:var(--accent,#963);
    background:var(--accent-wash,transparent); font-weight:600; }
  .cx-sel { font:inherit; font-size:.8rem; padding:.22rem .45rem; border:1px solid var(--rule,#ccc);
    border-radius:2px; background:var(--ground,#fff); color:inherit; max-width:34ch; }
  .cx-who { font-size:.95rem; }
  .cx-e { border-top:1px solid var(--rule,#ddd); padding:.9rem 0 .8rem; }
  .cx-h { display:flex; align-items:baseline; gap:.5rem; flex-wrap:wrap; margin-bottom:.4rem; }
  .cx-t { display:inline-block; min-width:4.2rem; font-size:9.5px; font-weight:600;
    letter-spacing:.11em; text-transform:uppercase; color:var(--ink-3,#888); }
  .cx-was { color:var(--ink-3,#888); margin:.1rem 0; }
  .cx-now { margin:.1rem 0; }
  .cx-how, .cx-why { margin:.25rem 0 0; color:var(--ink-2,inherit); }
  .cx-foot { margin-top:.35rem; color:var(--ink-3,#888); }
  .cx-sup { margin:.1rem 0; color:var(--ink-3,#888); }
</style>
