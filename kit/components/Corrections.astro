---
/* What this archive got wrong, and what is true instead.
 *
 * The most estate-wide idea there is, and it had seven answers: five different
 * page titles and no two data shapes alike. Falco says was/now, Defranceschi
 * said/true, Lerena what_was_said/what_is_true, Booyzen the same pair as
 * positional arrays, Blazevic record/tree. Every one of them means WHAT WAS
 * PUBLISHED and WHAT IS TRUE, plus how it was caught and when.
 *
 * THE LEDGER VIEW (26 November 2026, after David: "overwhelming amount of text, not fun, needs better integration, linking, colour, searchability").
 * A page of 185 to 427 entries of paragraphs was 87,000 pixels of reading. Now each correction is a CARD (the claim that was retracted, the answer
 * in a line, its grade in colour, who it is about); the whole entry (was beside now, how it was caught, the people, places, sources and dates) opens in a
 * READING PANE beside the list on a wide screen, under its card on a narrow one. A HEARTBEAT strip (one bar a day, stacked by grade) shows when the
 * archive caught its own mistakes, and a click on a bar reads only that day. SEARCH covers every word of every entry (accents folded); the grade, the
 * kind and "about a person" narrow it; the address keeps the filters (?q=serena&sev=serious) and the open entry (#c-...), so a view can be sent.
 * Without script every entry stays open under its card, as before. Nothing is written by the kit: the card's words are the archive's own
 * (lib/corrections.js cardOf). Only major / serious / moderate / minor are coloured (toneOf); any other grade word an archive uses is "other".
 *
 * NOT A TABLE, deliberately. The first version of this put the pair in four
 * columns and it was unreadable: these are sentences, sometimes paragraphs, and
 * a correction that cannot be read is not a correction. The shape promoted here
 * is the Falco one, which was already the best of the seven — a dated entry
 * with the retraction above the truth.
 *
 * THE PAGE TITLES STAY. «For Michael», «What was taken back», «What This
 * Archive Got Wrong» are an archive's own voice, and the estate settled that a
 * menu label is shared while a page title need not be.
 *
 * Fields arrive as HTML, already rendered by the archive's own markdown helper,
 * because every archive has a different one and a component that took raw
 * markdown would be picking a winner.
 *
 * TWO DIMENSIONS, BECAUSE THE ARCHIVES FILTER BY DIFFERENT THINGS. Falco and
 * Defranceschi by severity, Booyzen by CAUSE - a list mistaken for a
 * population, a search written up as wider than it was - and Mazza by what the
 * correction is ABOUT, in 39 kinds, while also grading each one. Those are not
 * the same axis and one control cannot carry both. Past seven options the
 * control becomes a select, because 39 buttons is a wall, not a filter.
 *
 *   rows  [{when, who (HTML, so it can link), about ([["/path/", "Name"], ...]: WHO the correction is about), id (the anchor, from
 *           lib/corrections.js corrIdMap, so /whats-new/ can link to this entry), kind, sev, was, now, how, why, by, where, whereLabel,
 *           extra, superseded:{label, href, note}}]
 *
 *   books: an optional catalogue of the archive's register books (lib/booklinks.js bookIndex); a book named in the prose ("the Svetvinčenat baptism
 *   book 1764–1791") is linked to its volume when the catalogue holds it.
 *
 *   NEWEST FIRST: the component sorts by `when` itself (sort="date", the default; sort="given" keeps the archive's own order). A date it
 *   cannot read goes after the dated rows. Within a day the archive's own order stands.
 */
import { byDateDesc, factsOf, toneOf, cardOf, heartbeat, kindFilterable, longDate, TONE_ORDER, TONE_LABEL } from "../lib/corrections.js";
import { parseWhen } from "../lib/when.js";
import { linkBooks } from "../lib/booklinks.js";
import { linkPlaces } from "../lib/placelinks.js";
import { linkNames } from "../lib/namelinks.js";
const { rows: given = [], u = (p) => p, major = "major", sort = "date", facts = true, books = null, places = null, names = null,
        kindLabel = "Kind", sevLabel = "Show",
        /* how/why mean different things in different archives (how it was caught,
           the source, the lesson), so the fold's label is neutral by default and
           an archive can name its own. */
        moreLabel = "How and why" } = Astro.props;
/* a register book named in the prose is linked to the book when the archive's catalogue (`books`, from bookIndex in lib/booklinks.js) holds it; a
   place is linked to its page, with its flag (`places`, from placeIndex in lib/placelinks.js); a person's name is linked to the person, or to the list
   where several bear it (`names`, from nameIndex in lib/namelinks.js). Each is linked the first time it is named in an entry, across the entry's fields. */
const FIELDS = ["was", "now", "how", "why"];
const linked = (r) => {
  if (!books && !places && !names) return r;
  const seenP = new Set(), seenN = new Set(), out = { ...r };
  for (const k of FIELDS) {
    let h = r[k]; if (!h) continue;
    if (names) h = linkNames(h, names, { seen: seenN });
    if (places) h = linkPlaces(h, places, { seen: seenP });
    if (books) h = linkBooks(h, books);
    out[k] = h;
  }
  return out;
};
const rows = (sort === "given" ? given : byDateDesc(given, (r) => r.when)).map(linked);
/* One heading per day, not one date repeated on every entry: Lerena has 184
   entries over 27 days. Rows are grouped only while consecutive, so the
   archive's own order is kept; rows with no date (Mazza's) form one group with no
   heading, so they are still one list, not 235 separate blocks. The id an archive puts on an entry (a contents link to a day) stays
   on the entry, inside its group. */
const days = [];
for (const r of rows) {
  const last = days[days.length - 1];
  if (last && last.when === (r.when || "")) last.rows.push(r);
  else days.push({ when: r.when || "", rows: [r] });
}
const tally = (k) => {
  const m = new Map();
  for (const r of rows) if (r[k]) m.set(r[k], (m.get(r[k]) || 0) + 1);
  return [...m.entries()].sort((a, b) => b[1] - a[1] || String(a[0]).localeCompare(String(b[0])));
};
const sevs = tally("sev");
/* A kind is a filter only where it is a short category on most rows (Mazza's "Birth year"); where an archive puts the whole headline in `kind`
   (Falco, Defranceschi, Blažević) it is the card's title instead, and 400 headlines are not a filter. */
const kinds = kindFilterable(rows) ? tally("kind") : [];
/* One control only where there is something to choose between, and only where
   the chip is not already saying it on every row. */
/* the grades in order of gravity (major, serious, moderate, minor, then the archive's other words), not of how many there are */
const sevsByGravity = [...sevs].sort((a, b) => TONE_ORDER.indexOf(toneOf(a[0], major)) - TONE_ORDER.indexOf(toneOf(b[0], major)) || b[1] - a[1]);
const groups = [
  ...(sevs.length > 1 ? [{ key: "sev", label: sevLabel, opts: sevsByGravity }] : []),
  ...(kinds.length > 1 ? [{ key: "kind", label: kindLabel, opts: kinds }] : []),
];
/* the people the corrections are about (the archive's own `about` links), for one "About anyone" control */
const whoMap = new Map();
for (const r of rows) for (const [h, n] of r.about || []) { const w = whoMap.get(h) || { name: n, n: 0 }; w.n++; whoMap.set(h, w); }
const whoOpts = [...whoMap].sort((a, b) => b[1].n - a[1].n || String(a[1].name).localeCompare(String(b[1].name)));
const beat = heartbeat(rows, (r) => r.when, major);
const toneN = {}; for (const r of rows) { const t = toneOf(r.sev, major); toneN[t] = (toneN[t] || 0) + 1; }
const tones = TONE_ORDER.filter((t) => toneN[t]);
/* the grade word, as the archive wrote it, with a capital */
/* a date written 2026-11-04 (Falco) is read out in words, like the others; anything else is the archive's own text */
const say = (w) => (/^\d{4}-\d{2}-\d{2}$/.test(String(w || "")) ? longDate(w) : w);
const byIso = (w) => { const p = parseWhen(w); return p && p.exact ? p.iso : ""; };
const cap = (v) => { const s = String(v || ""); return s ? s[0].toUpperCase() + s.slice(1) : s; };
/* u() prefixes the archive's base path, which is right for an internal path and
   wrong for everything else: running an external URL through it produced links
   like /TheDefranceski/https://www.myheritage.com/ — 254 of them, caught by the
   build gate rather than by looking at the page. Only internal paths get based. */
const href = (h) => !h ? "" : (/^(https?:)?\/\//.test(h) || h.startsWith("mailto:") ? h : u(h));
/* Archives put a short category in `kind` (Mazza: "birth date"), but Falco puts the
   whole headline of the correction there. A sentence in a bordered chip is a
   box of capitals; past this length it is set as the entry's title instead. */
const isTitle = (k) => String(k || "").length > 48;
/* the genealogist's marks: a cross for a death or burial, a star for a birth or baptism, rings for a marriage */
const MARK = { death: ["†", "died"], birth: ["✶", "born"], marriage: ["⚭", "married"] };
const ext = (h) => /^(https?:)?\/\//.test(String(h || ""));

---
<div class="cx">
  {beat ? (
    <section class="cx-beat" aria-label="When the corrections were caught">
      <h3 class="cx-beath"><span>The archive's heartbeat</span>
        <span class="cx-beatn">{beat.size > 1 ? `One bar a ${beat.size === 7 ? "week" : beat.size + " days"}.` : "One bar a day."} <span class="cx-jsonly">Click one to read only those.</span></span></h3>
      <div class="cx-bars">
        {beat.bars.map((b) => (
          <div class={"cx-bd" + (b.n ? "" : " empty")} data-from={b.n ? b.from : undefined} data-to={b.n ? b.to : undefined}
               title={`${longDate(b.from)}${b.to !== b.from ? " to " + longDate(b.to) : ""}: ${b.n ? b.n + (b.n === 1 ? " correction" : " corrections") : "none"}`}>
            <div class="cx-bst">
              {[...TONE_ORDER].reverse().filter((t) => b.tones[t]).map((t) => <i class={"cx-seg t-" + t} style={`height:${(b.tones[t] / (beat.peak * 1.05)) * 100}%`}></i>)}
            </div>
          </div>
        ))}
      </div>
      <div class="cx-axis"><span>{longDate(beat.from)}</span><span>{longDate(beat.to)}</span></div>
      {tones.length > 1 ? (
        <ul class="cx-leg">{tones.map((t) => <li class={"t-" + t}><i></i>{TONE_LABEL[t]} <span class="mono">{toneN[t]}</span></li>)}</ul>
      ) : null}
    </section>
  ) : null}

  <div class="cx-top" hidden>
    <div class="cx-tools">
      <label class="cx-search"><span class="cx-sr">Search these corrections</span>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" class="cx-q" placeholder="Search: a name, a place, a word, a film number" autocomplete="off" />
      </label>
      {groups.map((g) => (
        <div class="cx-bar" data-key={g.key}>
          {g.opts.length > 7 ? (
            <select class="cx-sel" aria-label={g.label}>
              <option value="">{g.label}: all</option>
              {g.opts.map(([v, n]) => <option value={v}>{v} ({n})</option>)}
            </select>
          ) : (
            <>
              <span class="cx-lab">{g.label}</span>
              {g.opts.map(([v, n]) => (
                <button type="button" class={"cx-opt t-" + (g.key === "sev" ? toneOf(v, major) : "other")} data-v={v} aria-pressed="false"><i></i>{cap(v)} <span class="mono">{n}</span></button>
              ))}
            </>
          )}
        </div>
      ))}
      {whoOpts.length > 1 ? (
        <select class="cx-who-sel" aria-label="About a person">
          <option value="">About anyone</option>
          {whoOpts.map(([h, w]) => <option value={h}>{w.name}{w.n > 1 ? ` (${w.n})` : ""}</option>)}
        </select>
      ) : null}
    </div>
    <p class="cx-meta small"><span class="cx-count"></span>
      <button type="button" class="cx-clear" hidden>Clear filters</button>
      <button type="button" class="cx-rand">Show me one at random</button></p>
  </div>

  <div class="cx-split">
    <div class="cx-list">
      {days.map((d) => (
        <div class="cx-d">
          {d.when ? (
            <h3 class="cx-date"><span>{say(d.when)}</span>
              <span class="cx-n small">{d.rows.length} {d.rows.length === 1 ? "entry" : "entries"}</span></h3>
          ) : null}
          {d.rows.map((r) => {
            const tone = toneOf(r.sev, major);
            const card = cardOf(r);
            const f = facts ? factsOf(r.was, r.now, r.how, r.why, r.extra) : null;
            const iso = byIso(r.when);
            return (
          <section class={"cx-e t-" + tone} data-sev={r.sev || ""} data-kind={r.kind || ""} data-day={iso} data-who={(r.about || []).map((a) => a[0]).join(" ")} id={r.id || undefined}>
            <div class="cx-card">
              <p class="cx-ct">{card.title}</p>
              {card.verdict ? <p class="cx-cv">{card.verdict}</p> : null}
              <p class="cx-cm">
                {r.sev ? <span class={"cx-sev t-" + tone}>{cap(r.sev)}</span> : null}
                {r.kind && !isTitle(r.kind) ? <span class="cx-kd">{r.kind}</span> : null}
                {(r.about || []).slice(0, 2).map(([h, n]) => <span class="cx-who-c">{n}</span>)}
                {(r.about || []).length > 2 ? <span class="cx-more-n">+{r.about.length - 2}</span> : null}
              </p>
            </div>
            <div class="cx-full">
              <div class="cx-fh">
                <span class={"cx-stamp t-" + tone}>{r.sev ? cap(r.sev) : "Corrected"}</span>
                {r.when ? <span class="cx-when">Caught {say(r.when)}</span> : null}
                {r.kind && r.sev === major ? <span class="chip doc">material</span> : null}
              </div>
              {(r.who || (r.about && r.about.length)) ? (
                <div class="cx-h">
                  {r.who ? <strong class="cx-who" set:html={r.who} /> : null}
                  {r.about && r.about.length ? (
                    <span class="cx-about">About {r.about.map(([h, n], i) => <>{i > 0 && ", "}<a href={href(h)}>{n}</a></>)}</span>
                  ) : null}
                </div>
              ) : null}
              {r.kind && isTitle(r.kind) ? <p class="cx-title">{r.kind}</p> : null}
              {r.kind && !isTitle(r.kind) ? <p class="cx-kline"><span class="chip">{r.kind}</span></p> : null}
              {r.superseded ? (
                <p class="cx-sup"><span class="cx-t">superseded</span>
                  <span class="cx-b">{r.superseded.note ? <Fragment set:html={r.superseded.note} /> : null}
                  {r.superseded.href
                    ? <a href={href(r.superseded.href)}>{r.superseded.label} →</a>
                    : <span>{r.superseded.label}</span>}</span></p>
              ) : null}
              {(r.was || r.now) ? (
                <div class={"cx-cmp" + (r.was && r.now ? "" : " one")}>
                  {r.was ? <div class="cx-was"><span class="cx-t">What was published</span><div class="cx-b"><Fragment set:html={r.was} /></div></div> : null}
                  {r.now ? <div class="cx-now"><span class="cx-t">What is true</span><div class="cx-b"><Fragment set:html={r.now} /></div></div> : null}
                </div>
              ) : null}
              {f && (f.people.length || f.places.length || f.dates.length || f.sources.length) ? (
                <dl class="cx-facts">
                  {f.people.length ? <div><dt>People</dt><dd>{f.people.map((x) => <a class={"cx-chip" + (x.shared ? " shared" : "")} href={href(x.href)} title={x.shared ? "Several people share this name: opens the list" : undefined}>{x.name}{x.shared ? <i aria-hidden="true"> ⋯</i> : null}</a>)}</dd></div> : null}
                  {f.places.length ? <div><dt>Places</dt><dd>{f.places.map((x) => <a class="cx-chip pl" href={href(x.href)} title={x.title || undefined}>{x.flags.map((src) => <img class="pl-flag" src={src} alt="" width="18" height="12" />)}{x.name}</a>)}</dd></div> : null}
                  {f.sources.length ? <div><dt>Sources</dt><dd>{f.sources.map((x) => <a class="cx-chip src" href={href(x.href)} rel="noopener">{x.name} ↗</a>)}</dd></div> : null}
                  {f.dates.length ? <div><dt>Dates</dt><dd>{f.dates.map((x) => <span class={"cx-chip dt" + (x.kind ? " " + x.kind : "")} title={MARK[x.kind] ? MARK[x.kind][1] : undefined}>{MARK[x.kind] ? <><i aria-hidden="true">{MARK[x.kind][0]}</i><span class="cx-sr">{MARK[x.kind][1]} </span></> : null}{x.text}</span>)}</dd></div> : null}
                </dl>
              ) : null}
              {(r.how || r.why) ? (
                <div class="cx-lesson">
                  <span class="cx-t">{moreLabel}</span>
                  {r.how ? <div class="cx-how"><Fragment set:html={r.how} /></div> : null}
                  {r.why ? <div class="cx-why"><Fragment set:html={r.why} /></div> : null}
                </div>
              ) : null}
              {(r.by || r.where || r.extra) ? (
                <p class="small cx-foot">
                  {r.by ? <span class="dim">Caught by {r.by}.</span> : null}
                  {r.where ? <> {r.by ? " · " : ""}<a href={href(r.where)} rel={ext(r.where) ? "noopener" : null}>{r.whereLabel || "Where it lives now →"}</a></> : null}
                  {r.extra ? <Fragment set:html={r.extra} /> : null}
                </p>
              ) : null}
            </div>
          </section>
            );
          })}
        </div>
      ))}
      <p class="cx-none small" hidden>Nothing matches that. Try fewer words, or clear the filters: a name is often written two ways in these entries.</p>
    </div>
    <aside class="cx-pane" aria-live="polite" hidden></aside>
  </div>
</div>

<script>
  document.querySelectorAll(".cx").forEach((box) => {
    const entries = [...box.querySelectorAll(".cx-e")];
    if (!entries.length) return;
    box.classList.add("cx-js");
    const top = box.querySelector(".cx-top"); if (top) top.hidden = false;
    const dayBoxes = [...box.querySelectorAll(".cx-d")];
    const none = box.querySelector(".cx-none");
    const pane = box.querySelector(".cx-pane");
    const count = box.querySelector(".cx-count");
    const clearBtn = box.querySelector(".cx-clear");
    const qEl = box.querySelector(".cx-q");
    const whoEl = box.querySelector(".cx-who-sel");
    const bars = [...box.querySelectorAll(".cx-bd[data-from]")];
    const wide = matchMedia("(min-width: 1000px)");
    const norm = (s) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
    const hay = new Map(entries.map((e) => [e, norm(e.textContent || "")]));
    entries.forEach((e, i) => { if (!e.id) e.id = "cx-" + (i + 1); });
    /* `id` is the entry showing; `linked` says the reader (or a link) chose it. Only a chosen entry goes into the address: the one a wide
       screen opens by itself does not, so the plain page keeps its plain address. */
    const st = { q: "", sev: new Set(), kind: new Set(), who: "", day: "", id: "", linked: false };

    /* ---- the address: filters in the query, the entry in the hash (so a link from /whats-new/ still lands on its entry) ---- */
    const readUrl = () => {
      const p = new URLSearchParams(location.search);
      st.q = p.get("q") || ""; st.who = p.get("who") || ""; st.day = p.get("day") || "";
      (p.get("sev") || "").split("|").filter(Boolean).forEach((v) => st.sev.add(v));
      (p.get("kind") || "").split("|").filter(Boolean).forEach((v) => st.kind.add(v));
      if (qEl) qEl.value = st.q; if (whoEl) whoEl.value = st.who;
    };
    const writeUrl = () => {
      const p = new URLSearchParams();
      if (st.q) p.set("q", st.q); if (st.who) p.set("who", st.who); if (st.day) p.set("day", st.day);
      if (st.sev.size) p.set("sev", [...st.sev].join("|")); if (st.kind.size) p.set("kind", [...st.kind].join("|"));
      const qs = p.toString();
      try { history.replaceState(null, "", location.pathname + (qs ? "?" + qs : "") + (st.linked && st.id ? "#" + st.id : "")); } catch (e) {}
    };

    const ok = (e) => {
      if (st.sev.size && !st.sev.has(e.dataset.sev || "")) return false;
      if (st.kind.size && !st.kind.has(e.dataset.kind || "")) return false;
      if (st.who && !(" " + (e.dataset.who || "") + " ").includes(" " + st.who + " ")) return false;
      if (st.day) { const [a, b] = st.day.split("|"); const d = e.dataset.day || ""; if (!d || d < a || d > b) return false; }
      if (st.q) { const h = hay.get(e); for (const w of norm(st.q).split(/\s+/).filter(Boolean)) if (!h.includes(w)) return false; }
      return true;
    };
    const visible = () => entries.filter((e) => !e.hidden);
    const active = () => !!(st.q || st.sev.size || st.kind.size || st.who || st.day);

    /* ---- the reading pane (wide) or the entry opened in place (narrow) ---- */
    const current = () => entries.find((e) => e.id === st.id) || null;
    const paint = () => {
      const cur = current();
      entries.forEach((e) => {
        const on = e === cur, card = e.querySelector(".cx-card");
        e.classList.toggle("is-sel", on);
        e.classList.toggle("is-open", on && !wide.matches);
        if (card) { card.setAttribute("aria-expanded", String(on)); if (on) card.setAttribute("aria-current", "true"); else card.removeAttribute("aria-current"); }
      });
      box.classList.toggle("cx-wide", wide.matches);
      if (!pane) return;
      pane.hidden = !wide.matches || !cur;
      if (wide.matches && cur) {
        const vis = visible(), k = vis.indexOf(cur);
        pane.innerHTML = '<div class="cx-pn"><button type="button" data-nav="-1"' + (k <= 0 ? " disabled" : "") + '>← Newer</button>' +
          '<button type="button" data-nav="1"' + (k >= vis.length - 1 ? " disabled" : "") + '>Older →</button>' +
          '<button type="button" class="cx-copy">Copy a link to this</button></div>' + cur.querySelector(".cx-full").innerHTML;
        pane.scrollTop = 0;
      } else pane.innerHTML = "";
    };
    const select = (e, opts = {}) => {
      st.id = e ? e.id : ""; st.linked = !!e;
      paint(); writeUrl();
      if (e && opts.scroll) e.scrollIntoView({ block: wide.matches ? "nearest" : "start", behavior: "smooth" });
    };

    const apply = () => {
      let shown = 0;
      for (const e of entries) { e.hidden = !ok(e); if (!e.hidden) shown++; }
      for (const d of dayBoxes) d.hidden = !d.querySelector(".cx-e:not([hidden])");
      if (none) none.hidden = shown > 0;
      if (count) count.textContent = active() ? "Showing " + shown + " of " + entries.length : "All " + entries.length + ", newest first";
      if (clearBtn) clearBtn.hidden = !active();
      box.querySelectorAll(".cx-opt").forEach((b) => { const k = b.closest(".cx-bar").dataset.key; b.setAttribute("aria-pressed", String(st[k].has(b.dataset.v))); });
      box.querySelectorAll(".cx-sel").forEach((s) => { const k = s.closest(".cx-bar").dataset.key; s.value = st[k].size ? [...st[k]][0] : ""; });
      bars.forEach((b) => b.classList.toggle("on", st.day === b.dataset.from + "|" + b.dataset.to));
      /* keep the open entry if it is still shown; on a wide screen open the first shown one; on a narrow one close it */
      let cur = current();
      if (!cur || cur.hidden) { cur = wide.matches ? (visible()[0] || null) : null; st.linked = false; }
      st.id = cur ? cur.id : "";
      paint(); writeUrl();
    };

    /* ---- controls ---- */
    if (qEl) qEl.addEventListener("input", () => { st.q = qEl.value.trim(); st.id = ""; apply(); });
    if (whoEl) whoEl.addEventListener("change", () => { st.who = whoEl.value; st.id = ""; apply(); });
    box.querySelectorAll(".cx-bar").forEach((bar) => {
      const key = bar.dataset.key;
      bar.querySelectorAll(".cx-opt").forEach((b) => b.addEventListener("click", () => {
        st[key].has(b.dataset.v) ? st[key].delete(b.dataset.v) : st[key].add(b.dataset.v); st.id = ""; apply();
      }));
      const sel = bar.querySelector(".cx-sel");
      if (sel) sel.addEventListener("change", () => { st[key].clear(); if (sel.value) st[key].add(sel.value); st.id = ""; apply(); });
    });
    bars.forEach((b) => {
      const go = () => { const v = b.dataset.from + "|" + b.dataset.to; st.day = st.day === v ? "" : v; st.id = ""; apply(); };
      b.setAttribute("role", "button"); b.tabIndex = 0;
      b.addEventListener("click", go);
      b.addEventListener("keydown", (ev) => { if (ev.key === "Enter" || ev.key === " ") { ev.preventDefault(); go(); } });
    });
    const clearAll = () => { st.q = ""; st.who = ""; st.day = ""; st.sev.clear(); st.kind.clear(); if (qEl) qEl.value = ""; if (whoEl) whoEl.value = ""; st.id = ""; apply(); };
    if (clearBtn) clearBtn.addEventListener("click", clearAll);
    const rand = box.querySelector(".cx-rand");
    if (rand) rand.addEventListener("click", () => { const v = visible(); if (v.length) select(v[Math.floor(Math.random() * v.length)], { scroll: true }); });
    entries.forEach((e) => {
      const card = e.querySelector(".cx-card"); if (!card) return;
      card.setAttribute("role", "button"); card.tabIndex = 0;
      const toggle = () => { if (!wide.matches && st.id === e.id) select(null); else select(e); };
      card.addEventListener("click", toggle);
      card.addEventListener("keydown", (ev) => { if (ev.key === "Enter" || ev.key === " ") { ev.preventDefault(); toggle(); } });
    });
    if (pane) pane.addEventListener("click", (ev) => {
      const t = ev.target.closest("button"); if (!t) return;
      if (t.dataset.nav) { const vis = visible(), k = vis.indexOf(current()) + Number(t.dataset.nav); if (vis[k]) select(vis[k], { scroll: true }); }
      else if (t.classList.contains("cx-copy")) { st.linked = true; writeUrl();   /* the address then names this entry, whether or not it could be copied */
        try { navigator.clipboard.writeText(location.href); t.textContent = "Link copied"; } catch (e) { t.textContent = "Copy the address bar"; } }
    });

    /* A link from /whats-new/ lands on one entry. If a filter is hiding it, clear the filters first, then open it. */
    const asked = () => { let id = ""; try { id = decodeURIComponent((location.hash || "").slice(1)); } catch (e) {}
      const t = id && document.getElementById(id); return t && box.contains(t) && t.classList.contains("cx-e") ? t : null; };
    const goHash = (t = asked()) => {
      if (!t) return false;
      if (t.hidden) clearAll();
      st.id = t.id; st.linked = true; paint(); writeUrl();
      requestAnimationFrame(() => t.scrollIntoView({ block: "start" }));
      return true;
    };
    wide.addEventListener("change", () => { const c = current(); if (!c && wide.matches) { const v = visible()[0]; if (v) st.id = v.id; } paint(); });
    addEventListener("hashchange", () => goHash());
    /* the sticky pane and day headings sit below the site's own header: measured, unless the page has set --cx-top itself */
    if (!getComputedStyle(box).getPropertyValue("--cx-top").trim()) {
      const head = [...document.querySelectorAll("body > header, header.site")].find((h) => ["sticky", "fixed"].includes(getComputedStyle(h).position));
      if (head) { const set = () => box.style.setProperty("--cx-top", Math.floor(head.getBoundingClientRect().height) + "px"); set(); addEventListener("resize", set); }
    }
    /* the entry the address asks for is read BEFORE the first apply(), which rewrites the address */
    const first = asked();
    readUrl(); if (first) { st.id = first.id; st.linked = true; } apply();
    if (first) goHash(first);
  });
</script>

