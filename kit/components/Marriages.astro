---
import MarriageWheel from "./MarriageWheel.astro";
/* The couples and the families they came from, on one page.
 *
 * These were two pages in every archive that had them at all: a register of
 * couples, and a list of surnames that married in. They answer one question
 * from two ends, and split across two pages neither could say the thing that
 * matters — that a surname is here because a person married a person. Merged
 * on the user's instruction after a prototype showed the join.
 *
 * The important prop is `groups`. This component does NOT decide what makes a
 * family part of this one; the archive does, and the archives disagree for good
 * reasons:
 *
 *   Falco         places each person by DESCENT — born a Falco or descended
 *                 from one, married such a person, the family that person came
 *                 from, or married into one of those. It had to: its old rule
 *                 was "any surname that is not Falco", which put Mazza on the
 *                 page with no Falco anywhere near it.
 *   Blazevic      gates on an AHNENTAFEL NUMBER. Nothing is listed because of a
 *                 name, so 19 families and 45 proven ancestors carry no
 *                 inflation at all.
 *   Defranceschi  groups by the NAME, correctly, because that archive's subject
 *                 IS the name — it says outright there is no single
 *                 Defranceschi family and that the name was coined many times.
 *
 * So the rule is not "never group by surname". It is that the grouping must
 * match what the archive is about, and the archive says which. This component
 * renders whatever labelled groups it is handed, in the order handed, and
 * asserts nothing about why they are groups.
 *
 * Import by the PACKAGE SPECIFIER — no kit/ segment, the exports map adds it:
 *   import Marriages from "@daviddef/archive-kit/components/Marriages.astro";
 * A filesystem path to this same file does need it.
 */
const {
  u = (p) => p,
  chips = [],          // [{k,label,cls,note}] the archive's provenance vocabulary
  metrics = [],        // [{n,label,href}]
  spine = [],          // [{gen,genHref,a,b,kids,vias}] the direct line, if there is one
  spineTitle = "The direct line",
  spineNote = "",
  groups = [],         // [{key,label,blurb,families:[]}] ARCHIVE-DEFINED, see above
  thin = [],           // families too thin for a section of their own
  thinTitle = "One and two at a time",
  thinNote = "",
  heldNotShown = [],   // [{surname,withheld}] every person of that name is living
                       // NOTE a group may carry its own `thin` and `held` instead. It should:
                       // how many of a family's people happen to be NAMED is a fact about the
                       // living-people policy, not about how that family reaches this one, and
                       // filing by size first put four of Falco's blood families in a leftovers
                       // table and eight more in a footnote.
  livingNote = "",
  openAt = 8,          // a name list longer than this starts collapsed
  /* THE ORDER OF THIS PAGE IS THE COMPONENT'S, NOT THE ARCHIVE'S.
     The first version of this rendered only the groups and let every archive
     arrange its own metrics, chart and couples around them. Seven archives then
     produced seven different pages that happened to share one section: one had
     a metrics row, two had a chart, two had no couples register at all, and the
     couples sat above the families on five and below on two. Passing the pieces
     in as props instead means the shape cannot drift, because no archive is
     arranging it any more. */
  subject = "",        // the family name, for the middle of the wheel
  wheel = true,        // draw the families; false where a chart would mislead
  memberKey = [],      // [{label,col}] when families carry their own colours
  couples = [],        // [{a,b,when,where,note,vias,kids,href}] the register
  couplesTitle = "The couples",
  couplesNote = "",
  couplesGroupBy = null,   // optional (c) => "1800s" to break the register up
} = Astro.props;

const person = (p) => p || {};

/* A column appears only where some row has something to put in it, so an
   archive that knows dates but not places does not publish a column of dashes. */
const anyWhen = couples.some((c) => c.when);
const anyWhere = couples.some((c) => c.where);
const anyKids = couples.some((c) => c.kids);
const anyNote = couples.some((c) => c.note);
const anyVia = couples.some((c) => (c.vias || []).length);

const couplesGroups = (() => {
  if (!couplesGroupBy) return [{ label: "", rows: couples }];
  const out = [];
  for (const c of couples) {
    const k = couplesGroupBy(c);
    let band = out.find((b) => b.label === k);
    if (!band) out.push(band = { label: k, rows: [] });
    band.rows.push(c);
  }
  return out;
})();
/* The count in a group heading is every family in the group, not just the ones
   big enough for a section of their own — a group that reads "0 families" above
   its own thin table and its own withheld note is counting the wrong thing. */
const gn = (g) => (typeof g.count === "number" ? g.count
  : (g.families || []).length + (g.thin || []).length + (g.held || []).length);
---
<div class="mg">

  {metrics.length ? (
    <div class="mg-metrics">
      {metrics.map((m) => (
        <div class="card mg-metric">
          <div class="mono mg-n">{m.href ? <a href={u(m.href)}>{m.n}</a> : m.n}</div>
          <div class="small">{m.label}</div>
        </div>
      ))}
    </div>
  ) : null}

  {chips.length ? (
    <p class="small mg-legend">Every row says where it comes from. {chips.map((c, i) => (
      <span>{i ? " · " : ""}<span class={"chip " + (c.cls || "")}>{c.label || c.k}</span> {c.note}</span>
    ))}</p>
  ) : null}

  <slot name="highlight" />

  {wheel ? <MarriageWheel groups={groups} subject={subject} memberKey={memberKey}
    caption={`${groups.reduce((a, g) => a + gn(g), 0)} families`} /> : null}

  {spine.length ? (
    <section class="mg-spine">
      <h2>{spineTitle}</h2>
      {spineNote ? <p class="small" set:html={spineNote} /> : null}
      <div class="scroll"><table>
        <thead><tr><th>Gen</th><th>Married</th><th>Children</th><th>Known from</th></tr></thead>
        <tbody>
          {spine.map((c) => (
            <tr>
              <td class="mono">{c.genHref ? <a href={u(c.genHref)}>{c.gen}</a> : c.gen}</td>
              <td>
                {person(c.a).living
                  ? <em class="dim">{person(c.a).name} <span class="small">— living, named only</span></em>
                  : person(c.a).slug
                    ? <a href={u("/people/" + person(c.a).slug + "/")}><strong>{person(c.a).name}</strong></a>
                    : <strong>{person(c.a).name}</strong>}
                <span class="dim"> × </span>
                {person(c.b).living
                  ? <em class="dim">{person(c.b).name} <span class="small">— living, named only</span></em>
                  : person(c.b).slug
                    ? <a href={u("/people/" + person(c.b).slug + "/")}><strong>{person(c.b).name}</strong></a>
                    : <strong>{person(c.b).name}</strong>}
              </td>
              <td class="mono small">{c.kids || ""}</td>
              <td class="small">{(c.vias || []).map((v) => (
                <span class={"chip " + ((chips.find((x) => x.k === v) || {}).cls || "")}>{v}</span>))}</td>
            </tr>))}
        </tbody>
      </table></div>
    </section>
  ) : null}

  {couples.length ? (
    <section class="mg-couples">
      <h2>{couplesTitle}</h2>
      {couplesNote ? <p class="small" set:html={couplesNote} /> : null}
      {couplesGroups.map((band) => (
        <>
          {band.label ? <h3 class="mg-band">{band.label}
            <span class="small mono mg-bn">{band.rows.length}</span></h3> : null}
          <div class="scroll"><table>
            <thead><tr>
              <th>Married</th>
              {anyWhen ? <th>When</th> : null}
              {anyWhere ? <th>Where</th> : null}
              {anyKids ? <th>Children</th> : null}
              {anyNote ? <th>What the record says</th> : null}
              {anyVia ? <th>Known from</th> : null}
            </tr></thead>
            <tbody>{band.rows.map((c) => (
              <tr>
                <td>
                  {person(c.a).living
                    ? <em class="dim">{person(c.a).name} <span class="small">— living</span></em>
                    : person(c.a).slug
                      ? <a href={u("/people/" + person(c.a).slug + "/")}>{person(c.a).name}</a>
                      : person(c.a).name}
                  <span class="dim"> × </span>
                  {person(c.b).living
                    ? <em class="dim">{person(c.b).name} <span class="small">— living</span></em>
                    : person(c.b).slug
                      ? <a href={u("/people/" + person(c.b).slug + "/")}>{person(c.b).name}</a>
                      : person(c.b).name}
                </td>
                {anyWhen ? <td class="small mono">{c.when || "—"}</td> : null}
                {anyWhere ? <td class="small">{c.where || "—"}</td> : null}
                {anyKids ? <td class="small mono">{c.kids || ""}</td> : null}
                {anyNote ? <td class="small">{c.note ? <span set:html={c.note} /> : "—"}</td> : null}
                {anyVia ? <td class="small">{(c.vias || []).map((v) => (
                  <span class={"chip " + ((chips.find((x) => x.k === v) || {}).cls || "")}>{v}</span>))}</td> : null}
              </tr>))}</tbody>
          </table></div>
        </>
      ))}
    </section>
  ) : null}

  {groups.map((grp) => (
    <section class="mg-group" id={"g-" + grp.key}>
      <h2 class="mg-glabel">{grp.label}
        <span class="small mono mg-gn">{gn(grp) === 0 ? "none routed here yet"
          : gn(grp) + " " + (gn(grp) === 1 ? (grp.countNoun1 || "family")
            : (grp.countNoun || "families"))}</span>
        {grp.badge ? <span class="mg-badge">{grp.badge}</span> : null}</h2>
      {grp.places ? <p class="small mono mg-places">{grp.places}</p> : null}
      {grp.blurb ? <p class="mg-blurb" set:html={grp.blurb} /> : null}
      {/* A group may carry structured detail of its own — the Defranceschi
          archive routes each family to the empire that held its town, and who
          held it, which registers survive and where the archive stands are four
          separate answers, not one paragraph. */}
      {(grp.detail || []).length ? (
        <dl class="mg-dl">{grp.detail.map(([term, html]) => (
          <><dt>{term}</dt><dd set:html={html} /></>))}</dl>
      ) : null}

      {(grp.families || []).map((f) => (
        <article class="mg-fam">
          <h3 class="mg-fname">{f.href ? <a href={u(f.href)}>{f.surname}</a> : f.surname}
            <span class="small mono mg-fmeta">{f.n} {f.countLabel || "named"}{f.withheld
              ? ` · ${f.withheld} living, withheld` : ""}</span>
            {f.badge ? <span class="mg-badge">{f.badge}</span> : null}</h3>

          <p class="small mg-fline">
            {f.span || ""}{f.places && f.places.length ? (f.span ? " · " : "") + f.places.join(" · ") : ""}
            {f.registerHref ? <> · <a href={u(f.registerHref)}>every {f.surname} in the register →</a></> : null}
            {f.writtenUp ? <> · <a href={u(f.writtenUp[0])}>the {f.writtenUp[1]} page →</a></> : null}
          </p>

          {f.story ? <p class="mg-story" set:html={f.story} /> : null}

          {(f.marriages || []).length ? (
            <p class="small mg-marr"><strong>Joined by marriage:</strong>{" "}
              {f.marriages.map((m, i) => (<span>{i ? " · " : ""}
                {m.whoSlug ? <a href={u("/people/" + m.whoSlug + "/")}>{m.who}</a> : m.who}
                {" & "}
                {m.toSlug ? <a href={u("/people/" + m.toSlug + "/")}>{m.to}</a> : m.to}
                {m.living ? <span class="small dim"> (living)</span> : null}</span>))}</p>
          ) : null}

          {(f.people || []).length ? (
            (f.people.length > openAt ? (
              <details class="mg-det">
                <summary class="small">{f.people.length} named — show every one</summary>
                <div class="scroll"><table>
                  <thead><tr><th>Name</th><th>Born</th><th>Died</th></tr></thead>
                  <tbody>{f.people.map((p) => (
                    <tr>
                      <td>{p.slug ? <a href={u("/people/" + p.slug + "/")}>{p.name}</a> : p.name}</td>
                      <td class="small mono">{[p.b, p.bp].filter(Boolean).join(" · ") || "—"}</td>
                      <td class="small mono">{[p.d, p.dp].filter(Boolean).join(" · ") || "—"}</td>
                    </tr>))}</tbody>
                </table></div>
              </details>
            ) : (
              <div class="scroll"><table>
                <thead><tr><th>Name</th><th>Born</th><th>Died</th></tr></thead>
                <tbody>{f.people.map((p) => (
                  <tr>
                    <td>{p.slug ? <a href={u("/people/" + p.slug + "/")}>{p.name}</a> : p.name}</td>
                    <td class="small mono">{[p.b, p.bp].filter(Boolean).join(" · ") || "—"}</td>
                    <td class="small mono">{[p.d, p.dp].filter(Boolean).join(" · ") || "—"}</td>
                  </tr>))}</tbody>
              </table></div>
            ))
          ) : null}

          {f.note ? <p class="small mg-note" set:html={f.note} /> : null}
        </article>
      ))}

      {/* Families the archive knows only a COUNT for. A section with an empty
          table under it would be worse than what it replaces: the Defranceschi
          archive holds 74 in-law surnames and a number of indexed marriages
          against each, and nothing else, so they belong in a grid you can read
          at a glance and not in 74 headings. An archive with real people under
          a surname uses `families` instead; most use both. */}
      {(grp.chips || []).length ? (
        <div class="mg-chips">
          {grp.chips.map((c) => {
            const inner = (<>
              <span class="mg-cn">{c.name}</span>
              <span class="mg-cc mono">{c.count}</span>
              {c.aside ? <span class="mg-ca mono" title={c.asideTitle || ""}>{c.aside}</span> : null}
            </>);
            return c.href
              ? <a class={"mg-chip on" + (c.mark ? " mark" : "")} href={u(c.href)}>{inner}</a>
              : <span class={"mg-chip" + (c.mark ? " mark" : "")}>{inner}</span>;
          })}
        </div>
      ) : null}

      {(grp.thin || []).length ? (
        <div class="mg-gthin">
          <h3 class="small mg-sub">{grp.thinLabel || "Thinly held, and in this group all the same"}</h3>
          <div class="scroll"><table>
            <thead><tr><th>Surname</th><th>Who</th><th>When</th><th>Where</th><th></th></tr></thead>
            <tbody>{grp.thin.map((g) => (
              <tr>
                <td><strong>{g.surname}</strong>{g.withheld
                  ? <><br /><span class="small dim">{g.withheld} living, withheld</span></> : null}</td>
                <td>{(g.people || []).map((p, i) => (<span>{i ? " · " : ""}
                  {p.slug ? <a href={u("/people/" + p.slug + "/")}>{p.name}</a> : p.name}</span>))}</td>
                <td class="small mono">{g.span || "—"}</td>
                <td class="small">{(g.places || []).join(" · ") || "—"}</td>
                <td class="small">{g.registerHref ? <a href={u(g.registerHref)}>register →</a> : null}</td>
              </tr>))}</tbody>
          </table></div>
        </div>
      ) : null}

      {(grp.held || []).length ? (
        <p class="small mg-gheld"><strong>{grp.held.length} more in this group are held but not
        shown</strong>, because every person the archive has for that surname is living:{" "}
        {grp.held.map((g, i) => (<span>{i ? " · " : ""}<strong>{g.surname}</strong>{" "}
          <span class="mono">({g.withheld})</span></span>))}</p>
      ) : null}
    </section>
  ))}

  {thin.length ? (
    <section class="mg-thin">
      <h2>{thinTitle}</h2>
      {thinNote ? <p set:html={thinNote} /> : null}
      <div class="scroll"><table>
        <thead><tr><th>Surname</th><th>Who</th><th>When</th><th>Where</th><th></th></tr></thead>
        <tbody>
          {thin.map((g) => (
            <tr>
              <td><strong>{g.surname}</strong>{g.withheld
                ? <><br /><span class="small dim">{g.withheld} living, withheld</span></> : null}</td>
              <td>{(g.people || []).map((p, i) => (<span>{i ? " · " : ""}
                {p.slug ? <a href={u("/people/" + p.slug + "/")}>{p.name}</a> : p.name}</span>))}</td>
              <td class="small mono">{g.span || "—"}</td>
              <td class="small">{(g.places || []).join(" · ") || "—"}</td>
              <td class="small">{g.registerHref ? <a href={u(g.registerHref)}>register →</a> : null}</td>
            </tr>))}
        </tbody>
      </table></div>
    </section>
  ) : null}

  {heldNotShown.length ? (
    <section class="mg-held">
      <h2>Families held but not shown</h2>
      <p>For these surnames the archive holds people, and every one of them is living. Nothing is
      published: no names, no dates. They are listed only so that a descendant searching for the
      surname can see that the family <em>is</em> in the record, and ask.</p>
      <p class="mg-heldlist">{heldNotShown.map((g, i) => (
        <span>{i ? " · " : ""}<strong>{g.surname}</strong> <span class="small mono">({g.withheld})</span></span>))}</p>
    </section>
  ) : null}

  {livingNote ? <p class="small mg-living" set:html={livingNote} /> : null}

  <slot name="missing" />
  <slot />
</div>

<style is:global>
  /* is:global because a story or a note arrives through set:html and an archive
     may hand this component markup Astro never saw, which therefore never gets
     the scope attribute stamped on it. */
  .mg-couples { margin:1.8rem 0; }
  .mg-band { margin:1.2rem 0 .35rem; font-size:1rem; }
  .mg-bn { font-weight:400; color:var(--ink-3,#777); margin-left:.4rem; }
  .mg-metrics { display:grid; grid-template-columns:repeat(auto-fit,minmax(120px,1fr));
    gap:.6rem; margin:1rem 0; }
  .mg-metric { padding:10px 14px; }
  .mg-n { font-size:1.5rem; font-variant-numeric:tabular-nums; }
  .mg-legend { margin:.4rem 0 1rem; }
  .mg-group { margin:2.2rem 0 0; }
  .mg-glabel { display:flex; align-items:baseline; gap:.6rem; flex-wrap:wrap;
    border-bottom:1px solid var(--rule,#ddd); padding-bottom:.3rem; margin-bottom:.4rem; }
  .mg-gn { font-weight:400; color:var(--ink-3,#777); }
  .mg-blurb { margin:.2rem 0 1rem; color:var(--ink-2,#444); }
  .mg-fam { margin:1.4rem 0; }
  .mg-fname { margin-bottom:.15rem; }
  .mg-fmeta { font-weight:400; margin-left:.5rem; color:var(--ink-3,#777); }
  .mg-fline { color:var(--ink-3,#777); margin-bottom:.5rem; }
  .mg-story { margin:.4rem 0 .5rem; }
  .mg-marr { margin-bottom:.5rem; }
  .mg-det > summary { cursor:pointer; color:var(--ink-3,#777); padding:.25rem 0; }
  .mg-det[open] > summary { margin-bottom:.35rem; }
  .mg-note { color:var(--ink-3,#777); margin-top:.4rem; }
  .mg-heldlist { margin-top:.6rem; }
  .mg-gthin { margin:1.2rem 0 .6rem; }
  .mg-sub { color:var(--ink-3,#777); font-weight:600; margin-bottom:.35rem;
    text-transform:uppercase; letter-spacing:.05em; }
  .mg-gheld { color:var(--ink-3,#777); margin:.8rem 0 0; }
  .mg-chips { display:flex; flex-wrap:wrap; gap:7px; margin-top:1rem; padding-top:.9rem;
    border-top:1px solid var(--rule,#ddd); }
  .mg-chip { display:inline-flex; align-items:baseline; gap:7px; border:1px solid var(--rule,#ddd);
    border-radius:2px; padding:3px 9px; font-size:12.5px; color:var(--ink-3,#777);
    text-decoration:none; }
  .mg-cc { font-size:10.5px; opacity:.8; }
  .mg-ca { font-size:9.5px; color:var(--ochre,#963); opacity:.9;
    border-left:1px solid var(--rule,#ddd); padding-left:7px; }
  .mg-chip.on { color:var(--ink,#111); border-color:var(--rule-strong,#bbb); }
  .mg-chip.on:hover { border-color:var(--accent,#963); color:var(--accent,#963); }
  .mg-chip.mark { border-color:var(--accent,#963); color:var(--accent,#963);
    background:var(--accent-wash,transparent); }
  .mg-badge { font-size:9.5px; font-weight:600; letter-spacing:.12em; text-transform:uppercase;
    color:var(--accent,#963); border:1px solid var(--accent,#963);
    background:var(--accent-wash,transparent); border-radius:2px; padding:2px 8px; }
  .mg-places { color:var(--ink-3,#777); margin:.25rem 0 .5rem; line-height:1.6; }
  .mg-dl { display:grid; grid-template-columns:auto 1fr; gap:6px 18px; margin:.9rem 0 0; }
  .mg-dl dt { font-size:9.5px; font-weight:600; letter-spacing:.12em; text-transform:uppercase;
    color:var(--ink-3,#777); padding-top:3px; white-space:nowrap; }
  .mg-dl dd { margin:0; line-height:1.62; color:var(--ink-2,#444); max-width:78ch; }
  @media (max-width:560px) { .mg-dl { grid-template-columns:1fr; gap:2px 0; }
    .mg-dl dt { padding-top:9px; } }
  .mg-living { margin-top:1.2rem; }
  @media (max-width:520px) { .mg-n { font-size:1.25rem; } }
</style>
