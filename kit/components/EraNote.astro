---
/* A quiet "at the time" note beside a dated place-event: who held that ground in that year, from the Record Atlas's context contract.
 *
 *   import { eraAt, plainYear } from "@daviddef/archive-kit/lib/era.js";
 *   import EraNote from "@daviddef/archive-kit/components/EraNote.astro";
 *   import snapshot from "../data/era-snapshot.json";
 *
 *   <div class="v">{e.place}<EraNote era={eraAt(snapshot, e.place, plainYear(e.date, e.year))} /></div>
 *
 * It draws a small muted line, "· At the time: Naples / the Two Sicilies per the Record Atlas", where the library finds an era the
 * snapshot supports for that place and that year, and NOTHING AT ALL otherwise (era is null). It is context about the ground, never
 * a claim about the family: it says where it came from, and the source words are a link to the ERA on the Atlas (the contract's own
 * url). data-era carries the contract's era id. In a year that is a boundary between two eras the line reads "· From that year: <the
 * newer label> per the Record Atlas" (data-era-boundary="1"): true on either side of the change, which a year-only date cannot tell.
 * An era the Atlas marks approximate (or contested about its bounds) is used only for a year well inside it (rule l of lib/era.js):
 * the note then carries data-era-approx="1" (and data-era-contested="1"), and its words are the same: no bound of the era in them.
 * The label is the contract's own display label (a bare shorthand such as "Napoleonic" is shown with its polity by erasnap.py).
 * data-era-place is the folded place the note was drawn for: the gate re-derives the whole note (every mark) from the snapshot, the place and the year.
 *
 * RULERS (rule m of lib/era.js), OFF unless the archive asks: <EraNote era={eraAt(...)} rulers /> adds who reigned, beside the regime label, in the
 * Atlas's own words ("· At the time: Naples / the Two Sicilies (Ferdinand II) per the Record Atlas"; data-era-ruler, span.era-ruler). The library
 * names a ruler (era.ruler) only where exactly one reign covers the year, well inside it, of a polity the era's regime allows, in a region the
 * snapshot says has rulers; otherwise nothing is added. Without the prop the note is what it always was.
 *
 * A SEEDED ERA (rule f): where the Atlas's bands were seeded from this estate's own research (the era's seeded flag, `era.seeded`), "per the
 * Record Atlas" alone would read as a second, independent source when it is the archive quoting itself. The note then says "per the Record Atlas,
 * drawn from this archive's own research" and carries data-era-seeded="1". An archive that wants its own words passes seededText="..." (a usable
 * string; empty, or the plain phrase, falls back to the default) and gives the same words to the gate (checkera.py --seeded-text).
 *
 * THE PAGE'S RULE, not this component's: never call eraAt for a living, held-out or noindex person. This component cannot know
 * who is living; checkera.py fails the build if a note is found on such a page. The text is the label (no flag image, nothing
 * colour-only), so a screen reader reads it as it reads any line. kit/lib/era.js has the rules and kit/docs/era-notes.md the why.
 *
 * THE STYLE belongs to a page that has a note, and only to that page. It is not a component <style> (Astro bundles those into every
 * page that imports the component, with or without a note: +470 KB raw on one 4,000-page archive); the first note a page renders
 * draws one small <style is:inline data-era-css> ahead of itself, once per page (claim(Astro.request, ...), the mechanism Rec.astro
 * uses for its figure ids), and a page with no note carries no era CSS. The rules are the same, muted and token-driven (ERA_CSS).
 */
import { SRC_ATLAS, seededWords, PRE_NORMAL, PRE_BOUNDARY, ERA_CSS, ERA_CSS_KEY } from "../lib/era.js";
import { claim } from "../lib/rec.js";
const { era = null, rulers = false, seededText = undefined } = Astro.props;
const note = era && era.id && era.label ? era : null;
const ruler = rulers === true && note && note.ruler && typeof note.ruler.name === "string" && note.ruler.name !== "" ? note.ruler : null;
const seeded = note !== null && note.seeded === true;
const srcWords = seeded ? seededWords(seededText) : (note && note.source) || SRC_ATLAS;
const drawCss = note ? claim(Astro.request, ERA_CSS_KEY) : false;
---
{drawCss ? <style is:inline data-era-css set:html={ERA_CSS} /> : null}
{note ? (
  <span class="era-note" data-era={note.id} data-era-year={note.year} data-era-boundary={note.boundary === true ? "1" : undefined} data-era-assessed={note.assessed === true ? "1" : "0"} data-era-approx={note.approx === true ? "1" : undefined} data-era-contested={note.contested === true ? "1" : undefined} data-era-margin-unsourced={note.unsourced === true ? "1" : undefined} data-era-edge-agree={note.edgeAgree === true ? "1" : undefined} data-era-seeded={seeded ? "1" : undefined} data-era-place={typeof note.place === "string" && note.place !== "" ? note.place : undefined} data-era-ruler={ruler ? ruler.name : undefined}><span class="era-pre">{note.boundary === true ? PRE_BOUNDARY : PRE_NORMAL}</span><span class="era-lab">{note.label}</span>{ruler ? <>{" "}<span class="era-ruler">({ruler.name})</span></> : null}{" "}{note.href
    ? <a class="era-src" href={note.href} rel="noopener">{srcWords}</a>
    : <span class="era-src">{srcWords}</span>}</span>
) : null}
