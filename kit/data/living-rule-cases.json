    { "id": "no-citations", "tags": [], "why": "nothing cited is not a public source",
      "in": { "birth_year": 1960, "recorded_dead": false, "citations": [] }, "want": { "public_source": false, "is_living": true } },
    { "id": "undated-living-parent-held-out", "tags": ["undated-living-parent", "undated"], "why": "an undated person with a living parent might be a child: held out",
      "in": { "birth_year": null, "recorded_dead": false, "parent_living": true }, "want": { "possible_minor": true, "is_held_out": true, "is_living": false } },
    { "id": "undated-no-living-parent-not-held-out", "tags": ["undated"], "why": "undated but no living parent: not held out, and not living",
      "in": { "birth_year": null, "recorded_dead": false, "parent_living": false }, "want": { "possible_minor": false, "is_held_out": false, "is_living": false } },
    { "id": "undated-but-recorded-dead-not-held-out", "tags": ["undated", "recorded-death"], "why": "a recorded death is never held out",
      "in": { "birth_year": null, "recorded_dead": true, "parent_living": true }, "want": { "possible_minor": false, "is_held_out": false } },
    { "id": "undated-but-public-source-not-held-out", "tags": ["undated", "public-source"], "why": "a public source is never held out",
      "in": { "birth_year": null, "recorded_dead": false, "citations": ["FamilySearch"], "parent_living": true }, "want": { "possible_minor": false, "is_held_out": false } },
    { "id": "undated-with-private-tree-only-is-held-out", "tags": ["undated-living-parent", "tree-not-public"], "why": "a private tree entry does not lift the hold",
      "in": { "birth_year": null, "recorded_dead": false, "citations": ["MyHeritage family tree entry"], "parent_living": true }, "want": { "possible_minor": true, "is_held_out": true } },
    { "id": "known-child-is-living-and-not-held-out", "tags": ["known-child"], "why": "a child with a KNOWN birth year under 18 follows the standard like any living person (David, 16 October 2026)",
      "in": { "birth_year": 2015, "recorded_dead": false, "parent_living": true }, "want": { "is_living": true, "possible_minor": false, "is_held_out": false } },
    { "id": "known-infant-is-living-and-not-held-out", "tags": ["known-child"], "why": "the youngest possible year",
      "in": { "birth_year": 2026, "recorded_dead": false, "parent_living": true }, "want": { "is_living": true, "possible_minor": false, "is_held_out": false } },
    { "id": "held-by-id", "tags": ["held-by-id"], "why": "a person promised privacy, by id, is held out whatever else is true",
      "in": { "id": "42", "birth_year": 1900, "recorded_dead": true, "held_ids": ["42"] }, "want": { "is_held_out": true } },
    { "id": "held-by-id-number-matches-string", "tags": ["held-by-id"], "why": "ids compare as text",
      "in": { "id": 42, "birth_year": 1900, "recorded_dead": true, "held_ids": ["42"] }, "want": { "is_held_out": true } },
    { "id": "not-held-by-id", "tags": ["held-by-id"], "why": "another id is not held",
      "in": { "id": "43", "birth_year": 1900, "recorded_dead": true, "held_ids": ["42"] }, "want": { "is_held_out": false } }
