{
  "note": "The cases that define David's living-people standard (version 2, 16 October 2026), written ONCE and read by BOTH implementations: kit/tools/living_rule.py (through kit/tools/living_rule_selftest.py) and kit/lib/person.js (through kit/tools/checkperson_logic.mjs). Two implementations of one rule agree only when they can disagree and are made to answer the same questions: this file is the questions and the answers, so neither can drift without the other's test failing. Add a case here, never in one runner. Ages are by year: today's year minus the birth year. `today` is fixed so no case depends on the clock. Every case gives its inputs and the answers that matter (`want`); a key absent from `want` is not asserted. Citations are matched against kit/data/public-sources.json, which both runners read. Inputs: birth_year (int or null: null is undated), recorded_dead (any death or burial, dated or not), citations (strings), parent_living, id, held_ids. Answers: public_source, is_living, possible_minor, is_held_out. Years in this file are planted fixtures, not anybody's record.",
  "today": 2026,
  "required_tags": ["boundary-80", "boundary-81", "recorded-death", "public-source", "tree-not-public", "undated", "undated-living-parent", "known-child", "held-by-id"],
  "cases": [
    { "id": "age-80-is-living", "tags": ["boundary-80"], "why": "80 years old by year is the last year that is living",
      "in": { "birth_year": 1946, "recorded_dead": false }, "want": { "is_living": true } },
    { "id": "age-81-is-not-living", "tags": ["boundary-81"], "why": "81 is the first year that is not",
      "in": { "birth_year": 1945, "recorded_dead": false }, "want": { "is_living": false } },
    { "id": "age-79-is-living", "tags": [], "why": "one year inside the bound",
      "in": { "birth_year": 1947, "recorded_dead": false }, "want": { "is_living": true } },
    { "id": "age-36-is-living", "tags": [], "why": "an adult well inside the bound",
      "in": { "birth_year": 1990, "recorded_dead": false }, "want": { "is_living": true } },
    { "id": "old-hundred-bound-would-be-wrong", "tags": ["boundary-81"], "why": "the retired 100-year bound would call 1930 living; the 80-year rule does not",
      "in": { "birth_year": 1930, "recorded_dead": false }, "want": { "is_living": false } },
    { "id": "recorded-death-means-dead", "tags": ["recorded-death"], "why": "a recorded death or burial (dated or not) overrides the age",
      "in": { "birth_year": 1990, "recorded_dead": true }, "want": { "is_living": false, "possible_minor": false } },
    { "id": "no-birth-year-is-not-living", "tags": ["undated"], "why": "no birth year cannot be shown to be 80 or younger",
      "in": { "birth_year": null, "recorded_dead": false }, "want": { "is_living": false } },
    { "id": "familysearch-record-is-public", "tags": ["public-source"], "why": "a public record source means not living",
      "in": { "birth_year": 1960, "recorded_dead": false, "citations": ["FamilySearch record 1950 census"] }, "want": { "public_source": true, "is_living": false } },
    { "id": "familysearch-family-tree-always-counts", "tags": ["public-source"], "why": "FamilySearch always counts, including its Family Tree, because it hides its own living people",
      "in": { "birth_year": 1960, "recorded_dead": false, "citations": ["FamilySearch Family Tree"] }, "want": { "public_source": true, "is_living": false } },
    { "id": "findmypast-is-public", "tags": ["public-source"], "why": "another record collection",
