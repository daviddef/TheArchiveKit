    { "id": "naa-is-public", "tags": ["public-source"], "why": "National Archives of Australia was added to the list on 16 October 2026",
      "in": { "birth_year": 1960, "recorded_dead": false, "citations": ["NAA RecordSearch passenger manifest"] }, "want": { "public_source": true, "is_living": false } },
    { "id": "myheritage-research-collection-is-public", "tags": ["public-source"], "why": "a MyHeritage record collection counts",
      "in": { "birth_year": 1960, "recorded_dead": false, "citations": ["https://www.myheritage.com/research/collection-10001/some-census"] }, "want": { "public_source": true, "is_living": false } },
    { "id": "private-myheritage-tree-is-not-public", "tags": ["tree-not-public"], "why": "a user-built tree profile is a private tree entry",
      "in": { "birth_year": 1960, "recorded_dead": false, "citations": ["MyHeritage family tree entry"] }, "want": { "public_source": false, "is_living": true } },
    { "id": "geni-profile-is-not-public", "tags": ["tree-not-public"], "why": "a Geni tree profile",
      "in": { "birth_year": 1960, "recorded_dead": false, "citations": ["https://www.geni.com/people/x"] }, "want": { "public_source": false, "is_living": true } },
    { "id": "myheritage-research-geni-world-tree-is-a-tree", "tags": ["tree-not-public"], "why": "MyHeritage files Geni's World Family Tree under research: still a user-built tree",
      "in": { "birth_year": 1960, "recorded_dead": false, "citations": ["MyHeritage research: Geni World Family Tree"] }, "want": { "public_source": false, "is_living": true } },
    { "id": "myheritage-research-wikitree-is-a-tree", "tags": ["tree-not-public"], "why": "WikiTree is a user-built tree, even when filed under research",
      "in": { "birth_year": 1960, "recorded_dead": false, "citations": ["myheritage.com/research WikiTree"] }, "want": { "public_source": false, "is_living": true } },
    { "id": "gedcom-and-family-lore-are-not-public", "tags": ["tree-not-public"], "why": "a GEDCOM and family lore",
      "in": { "birth_year": 1960, "recorded_dead": false, "citations": ["a GEDCOM from the family", "family lore"] }, "want": { "public_source": false, "is_living": true } },
    { "id": "tree-plus-record-is-public", "tags": ["public-source"], "why": "one public citation among private ones is enough",
